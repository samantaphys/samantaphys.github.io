Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cov", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0.8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", "1"}], "}"}]}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "Covariance", " ", "Matrix"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"values", ",", "vectors"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "cov", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.979481027916873*^9, {3.979481100847005*^9, 3.97948112129743*^9}, 
   3.979481203300359*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"92cc6ced-257b-49f8-baef-374d51205270"],

Cell["\<\
Note: (i) Eigenvectors : direction the ellipse point.
          (ii) Eigenvalues : how long the ellipse is in those directions.\
\>", "Text",
 CellChangeTimes->{{3.979481126364698*^9, 
  3.979481180227799*^9}},ExpressionUUID->"0435fff7-4edc-4259-9462-\
32f5847024f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"axis1", "=", 
   RowBox[{"2", "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"values", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], "*", 
    RowBox[{"vectors", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"axis2", "=", 
   RowBox[{"2", "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"values", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], "*", 
    RowBox[{"vectors", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979481040606337*^9, 3.979481065627193*^9}, {
  3.9794812239861393`*^9, 3.9794812440648746`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"e69524b0-4c72-4eda-ae6c-32fbe9104797"],

