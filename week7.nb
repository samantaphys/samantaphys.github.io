Cell[TextData[{
 "General results: If you keep adding ",
 StyleBox["Uniform(0,1)", "Code"],
 " numbers until the sum exceeds ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "3e1a6fcb-38be-477d-b2ab-4fd1ce7a6823"],
 " , ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "[", "\[Xi]", "]"}], "=", "e"}], TraditionalForm]],
  ExpressionUUID->"ba1be28e-52bf-444a-9039-fb90b11a8f5b"],
 " ."
}], "Text",
 CellChangeTimes->{{3.982121373136471*^9, 3.982121433300383*^9}, {
  3.9821216644387703`*^9, 
  3.982121671909833*^9}},ExpressionUUID->"902c71ac-0ffa-49d7-8646-\
f702fa524e6d"],

Cell[TextData[StyleBox["Problem-3: ", "Subsection"]], "Text",
 CellChangeTimes->{{3.9821217957077713`*^9, 3.982121796125222*^9}, {
  3.982121882437736*^9, 
  3.982121892446289*^9}},ExpressionUUID->"414785d5-200e-4491-a78b-\
de7c0857c4c0"],

Cell[TextData[{
 "Consider the Jacobian matrix,   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"(", GridBox[{
       {"a", "b"},
       {"c", "d"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "5e97cf2b-874f-47a0-be0a-f618b4d41ecf"],
 " , where  ",
 StyleBox["a,b,c,d\[Tilde]Normal(0,1) ", "Code"],
 "(independent Gaussian random variables)."
}], "Text",
 CellChangeTimes->{{3.982121907712925*^9, 3.9821219462530193`*^9}, {
  3.9821220211799107`*^9, 
  3.982122024311047*^9}},ExpressionUUID->"9ade975f-cd83-4e31-ae2f-\
65af31ee4625"],

Cell[TextData[{
 "A saddle point occurs when the determinant is negative: ",
 StyleBox["det(A)=ad\[Minus]bc<0.", "Code"]
}], "Text",
 CellChangeTimes->{{3.982121976617372*^9, 
  3.982122052501412*^9}},ExpressionUUID->"089f761c-b2e6-4fb7-bb50-\
04c90857c0b2"],

Cell["\<\
Use a Monte Carlo simulation to estimate the fraction of matrices that \
produce a saddle point.
\
\>", "Text",ExpressionUUID->"8d831c0e-0f0b-4c1f-a912-dfd08b47da45"],

Cell[TextData[{
 "Simply, we compute the probability ",
 StyleBox["P(ad\[Minus]bc<0) by random sampling .", "Input"]
}], "Text",
 CellChangeTimes->{{3.982122099470682*^9, 
  3.982122136309216*^9}},ExpressionUUID->"10d2d7fa-1396-490b-96f9-\
3cbd949788b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10000"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mats", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", 
    RowBox[{
    "generate", " ", "random", " ", "2", "*", "2", " ", "matrices", " ", "in",
      " ", "the", " ", "form", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "*)"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dets", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", 
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "4"}], "]"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "*", 
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"compute", " ", "determinants"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"fraction", "=", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"dets", ",", 
       RowBox[{
        RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "]"}], "/", "n"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.982122171964459*^9, 3.982122256330769*^9}, {
  3.9821224342257957`*^9, 3.9821225083908978`*^9}, {3.982122577171151*^9, 
  3.982122577333428*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"448f74e4-53e4-41a4-a92f-4e4fdd83e23e"],

