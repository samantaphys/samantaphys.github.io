Cell[TextData[{
 "Many random curves diverging over time (financial risk). But the average \
trend follows the drift \[Mu].\n\n",
 StyleBox["Particle Diffusion Simulation", "Subsection"]
}], "Text",
 CellChangeTimes->{{3.982069755539463*^9, 3.9820697791448383`*^9}, {
  3.982069812711191*^9, 3.982069817054098*^9}, {3.982073224574771*^9, 
  3.98207324842445*^9}},ExpressionUUID->"3ece2c91-6da6-4d2e-ab00-\
5193b8ad9b12"],

Cell["\<\
This models how a particle moves randomly in 2D space, similar to Brownian \
motion.\
\>", "Text",ExpressionUUID->"f806d27c-fdfd-4bcb-89d6-b9a79e87e119"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"walk", "=", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "random", " ", "steps", " ", "for", " ", "a", " ", 
    "particle", " ", "in", " ", "2", "D", " ", "space"}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.979472175116728*^9, {3.979720979204226*^9, 3.979721004600108*^9}, {
   3.9797210744380913`*^9, 3.979721105493919*^9}, 3.982056469166312*^9, {
   3.982073304754272*^9, 3.9820733243560762`*^9}, {3.982073356835157*^9, 
   3.982073363574582*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"0c89285e-3661-4459-a35d-c630552321c3"],

Cell["Let\[CloseCurlyQuote]s plot the particle path", "Text",
 CellChangeTimes->{{3.982073446377121*^9, 
  3.98207345626015*^9}},ExpressionUUID->"6c692481-8de2-474b-ba69-\
c31d3858740e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Blue", ",", 
      RowBox[{"Line", "[", "walk", "]"}], ",", "Red", ",", 
      RowBox[{"PointSize", "[", "Large", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"First", "[", "walk", "]"}], "]"}], ",", "Green", ",", 
      RowBox[{"Point", "[", 
       RowBox[{"Last", "[", "walk", "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Particle Diffusion Path\>\""}]}], "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.982073312434751*^9, 3.982073329702815*^9}, {
  3.982073434313435*^9, 3.9820734441549587`*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"4c49c79b-8d7c-4578-b712-d669daec4afd"],

