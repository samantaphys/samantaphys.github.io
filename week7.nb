Cell["\<\
Blue points \[RightArrow] inside circle
Red points \[RightArrow] outside circle\
\>", "Text",
 CellChangeTimes->{
  3.982058675187901*^9},ExpressionUUID->"4a8d79f9-3cc8-4528-8396-\
a963a9df6fbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.982066039563726*^9, 3.982066041786495*^9}, {
  3.9820664414710617`*^9, 3.9820664442395983`*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"b595f82b-3231-4286-88e6-b1b5f5ba8127"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"points", "=", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"inside", "=", "0"}], ",", 
     RowBox[{"total", "=", "0"}], ",", 
     RowBox[{"running", "=", "False"}], ",", "pts", ",", 
     RowBox[{"estPi", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Button", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", 
         RowBox[{"If", "[", 
          RowBox[{"running", ",", "\"\<Stop\>\"", ",", "\"\<Start\>\""}], 
          "]"}], "]"}], ",", 
        RowBox[{"running", "=", 
         RowBox[{"Not", "[", "running", "]"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"running", ",", 
           RowBox[{
            RowBox[{"pts", "=", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "2"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"points", ",", "pts"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"total", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
                RowBox[{
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "<=", "1"}], 
              ",", 
              RowBox[{"inside", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"estPi", "=", 
             RowBox[{"4", " ", "*", 
              RowBox[{"(", 
               RowBox[{"inside", "/", "total"}], ")"}]}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PointSize", "[", "0.012", "]"}], ",", "LightGray", ",", 
              RowBox[{"Rectangle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1"}], "}"}]}], "]"}], ",", "Thick", ",", 
              RowBox[{"Circle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
              "\[IndentingNewLine]", "Blue", ",", 
              RowBox[{"Point", "[", 
               RowBox[{"Select", "[", 
                RowBox[{"points", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "<=", "1"}],
                   "&"}]}], "]"}], "]"}], ",", "\[IndentingNewLine]", "Red", 
              ",", 
              RowBox[{"Point", "[", 
               RowBox[{"Select", "[", 
                RowBox[{"points", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], ">", "1"}], 
                  "&"}]}], "]"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "400"}]}], "\[IndentingNewLine]", 
          "]"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"UpdateInterval", "->", "0.03"}]}], "\[IndentingNewLine]", 
       "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "@", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Total darts = \>\"", ",", "total"}], "}"}], "]"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "@", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Inside circle = \>\"", ",", "inside"}], "}"}], "]"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "@", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Estimated \[Pi] = \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"estPi", ",", "6"}], "]"}]}], "}"}], "]"}]}]}], "}"}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
