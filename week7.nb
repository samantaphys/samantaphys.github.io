     {
      DynamicBox[ToBoxes[
       If[$CellContext`running$$, $CellContext`pts$$ = RandomReal[{-1, 1}, 2]; 
          AppendTo[$CellContext`points$$, $CellContext`pts$$]; 
          Increment[$CellContext`total$$]; 
          If[Part[$CellContext`pts$$, 1]^2 + Part[$CellContext`pts$$, 2]^2 <= 
            1, 
            Increment[$CellContext`inside$$]]; $CellContext`estPi$$ = 
           4 ($CellContext`inside$$/$CellContext`total$$); Null]; Show[
          Graphics[{
            PointSize[0.012], LightGray, 
            Rectangle[{-1, -1}, {1, 1}], Thick, 
            Circle[{0, 0}, 1], Blue, 
            Point[
             
             Select[$CellContext`points$$, Part[#, 1]^2 + Part[#, 2]^2 <= 
