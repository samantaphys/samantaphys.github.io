Cell[TextData[{
 "The error decreases approximately as  ",
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"error", "~", "1"}], "/", 
    SqrtBox["N"]}], TraditionalForm]], "Code",ExpressionUUID->
  "c9460864-f29f-47c8-bca8-fd8c7527d831"], "Code"],
 StyleBox[".", "Code"]
}], "Text",
 CellChangeTimes->{{3.9820316849363813`*^9, 
  3.982031733709878*^9}},ExpressionUUID->"b7b7ab32-9217-452e-a4a3-\
90da86b69a96"],

