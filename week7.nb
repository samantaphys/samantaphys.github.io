Cell[TextData[StyleBox["Geometric Brownian Motion (GBM) model", \
"Subsection"]], "Text",
 CellChangeTimes->{{3.9820683342546043`*^9, 
  3.982068340982882*^9}},ExpressionUUID->"0e5b4904-768d-4b36-937f-\
558b64408e66"],

Cell["\<\
In this example, we simulates future stock price paths using Monte Carlo \
simulation. Let\[CloseCurlyQuote]s assume the stock prices are assumed to \
follow GBM:\
\>", "Text",
 CellChangeTimes->{{3.982068443509308*^9, 
  3.9820685160240803`*^9}},ExpressionUUID->"9fc38531-f6fd-4638-a4ce-\
19027e737457"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["T", "TI"]], "\[LongEqual]", 
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], "0"], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Mu]", "-", 
         FractionBox[
          SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], 
       StyleBox["T", "TI"]}], "+", 
      RowBox[{"\[Sigma]", 
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["T", "TI"]]}]}], ")"}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{3.982068603480103*^9},
 TextAlignment->Center,ExpressionUUID->"59c36dfe-005c-4f5c-8749-631fd2462119"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "T"], TraditionalForm]],ExpressionUUID->
  "ba718e64-43f2-44e9-a315-2a95b7c7be05"],
 ": The simulated price at time T.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "0"], TraditionalForm]],ExpressionUUID->
  "3afa7d99-9d0b-44a2-9d1d-80e1bb34d3d0"],
 ": The current (initial) price.\n\[Mu]: The Drift (expected annual return).\n\
\[Sigma]: The Volatility (standard deviation of returns).\n",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "ca0daa97-2d41-47fe-b7df-9a7047a14ec0"],
 ": The time horizon (expressed in years).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "T"], TraditionalForm]],ExpressionUUID->
  "76131ff3-f2b0-497b-8c93-e820fabc931e"],
 ": Brownian Motion. This is the \"random\" part. It follows a Normal \
Distribution with mean ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "44cc11c7-70bb-42f8-8e7f-0b0fb5edc4fb"],
 " and variance ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "a8196a90-5e71-4d8e-a208-9afcca267296"],
 ". "
}], "Text",
 CellChangeTimes->{{3.982068646917502*^9, 3.982068659493114*^9}, {
  3.9820687347150106`*^9, 3.982068842294911*^9}, {3.982142484829503*^9, 
  3.982142485499877*^9}},ExpressionUUID->"577cbd3a-dddc-413e-acc9-\
73ce6d8b3f0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"S0", "=", "100"}], 
  RowBox[{"(*", 
   RowBox[{"Starting", " ", "Price"}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", "0.05"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Drift", "/", "Expected"}], " ", "Return"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]", "=", "0.2"}], 
  RowBox[{"(*", "Volatility", "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "1"}], 
  RowBox[{"(*", 
   RowBox[{"Total", " ", 
    RowBox[{"time", ":", 
     RowBox[{"1", " ", "year"}]}]}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"steps", "=", "252"}], 
  RowBox[{"(*", 
   RowBox[{"Number", " ", "of", " ", "trading", " ", "days"}], "*)"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.982068881113359*^9, 3.982068950447345*^9}},
 CellLabel->
  "In[101]:=",ExpressionUUID->"e5461cad-c7c1-46e9-906f-708edad8fb54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pricePath", "[", 
   RowBox[{"S0_", ",", "mu_", ",", "\[Sigma]_", ",", "T_", ",", "steps_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"S0", "*", 
   RowBox[{"Exp", "[", "\[IndentingNewLine]", 
    RowBox[{"Accumulate", "[", "\[IndentingNewLine]", 
     RowBox[{"RandomVariate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"mu", "-", 
            RowBox[{
             SuperscriptBox["\[Sigma]", "2"], "/", "2"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"T", "/", "steps"}], ")"}]}], ",", 
         RowBox[{"\[Sigma]", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"T", "/", "steps"}], "]"}]}]}], "\[IndentingNewLine]", 
        "]"}], ",", "\[IndentingNewLine]", "steps"}], "]"}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]}]], "Input",\

 CellChangeTimes->{{3.982068991557662*^9, 3.982069089248118*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"822d435a-e879-4def-bd4a-89f2cbf1a956"],

Cell[TextData[{
 "Each step corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]t", "=", 
    RowBox[{"T", "/", 
     RowBox[{"steps", ".", " "}]}]}], TraditionalForm]],ExpressionUUID->
  "91059a67-1c4d-4115-8485-1345d268c607"],
 "(time increment)  => model evolves daily.\n",
 StyleBox["RandomVariate[NormalDistribution[..]] ->\:200bThis generates 252 \
random numbers (steps=252); \nThey represent daily log returns.", "Code"],
 "\n",
 StyleBox["Accumulate[ ... ] -> computes the cumulative sum of the random \
returns.", "Code"]
}], "Text",
 CellChangeTimes->{{3.9820692291698236`*^9, 3.982069280414838*^9}, {
  3.982069332393261*^9, 3.982069377879122*^9}, {3.9820694356654587`*^9, 
  3.982069556555833*^9}, {3.982069619564197*^9, 
  3.982069619921583*^9}},ExpressionUUID->"a74f47d1-675b-4ecb-bf8c-\
feddb89d464a"],

Cell["\<\
Let\[CloseCurlyQuote]s generate 50 possible future stock trajectories, where \
each path represents one possible future of the stock.\
\>", "Text",
 CellChangeTimes->{{3.9820696339581547`*^9, 
  3.9820696519570436`*^9}},ExpressionUUID->"017d7ad7-7998-4b41-88be-\
effe2fe61a17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"paths", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"pricePath", "[", 
      RowBox[{"S0", ",", "mu", ",", "\[Sigma]", ",", "T", ",", "steps"}], 
      "]"}], ",", 
     RowBox[{"{", "50", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.978964517098361*^9, {3.978964612363106*^9, 3.978964616374906*^9}, {
   3.979115677109866*^9, 3.9791156778711157`*^9}, {3.979472049973653*^9, 
   3.9794720812703857`*^9}, 3.982056453284881*^9, 3.982069613755686*^9, {
   3.982069653967222*^9, 3.982069661303822*^9}, {3.982142801435793*^9, 
   3.982142828208346*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"9b2bcb15-1df6-4b6e-9abb-a7e0799f11d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"paths", ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"50", ",", "150"}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Monte Carlo Stock Price Projection\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.982069680964981*^9, 3.98206970773685*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"78f45c07-a6b3-478f-9536-192f4fff3add"],

