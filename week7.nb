   3.982029925433752*^9, 3.9820302339168997`*^9, {3.982139456293302*^9, 
   3.982139464077887*^9}},
 CellLabel->
  "During evaluation of \
In[20]:=",ExpressionUUID->"06dc3627-944b-4c32-862e-2ef1e18c39a8"]
}, Open  ]],

Cell["\<\
When one condition is False in intermediate steps, the loop stops immediately.\
\>", "Text",
 CellChangeTimes->{{3.982029929591528*^9, 
  3.98202995018922*^9}},ExpressionUUID->"ff9b65bc-6976-4a06-b6f7-\
51df08e4602a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"estimate", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"error", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.982030160147687*^9, 3.982030179445888*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"f12cb8bc-9761-4dd0-831a-b31f59e6b0f1"],

Cell[BoxData[
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "<", "100000"}], "&&", 
    RowBox[{"error", ">", "0.001"}]}], ",", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"estimate", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"estimate", "*", "n"}], "+", 
        RowBox[{"x", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"error", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"estimate", "-", 
       RowBox[{"1", "/", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"n", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.982030177081759*^9, 3.982030217488441*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"e841fd75-2226-45f6-9752-c4b7427f6c7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"estimate", ",", "n"}], "}"}]], "Input",
 CellChangeTimes->{3.9820302730535793`*^9},
 CellLabel->"In[51]:=",ExpressionUUID->"20c17b60-fab0-429f-83bb-ed971e703a9c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.332384914813981`", ",", "969"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9820302739898777`*^9, {3.982140235765881*^9, 3.982140246832919*^9}},
 CellLabel->"Out[51]=",ExpressionUUID->"9905d80c-3fc4-4e34-8ff2-29fdd52a6833"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{"x", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.982140182961692*^9, 3.98214021063384*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"492c896c-d5a0-437f-ad67-2942275c2e44"],

Cell[BoxData["0.3333333333333338`"], "Output",
 CellChangeTimes->{{3.982140196286858*^9, 3.9821402114319077`*^9}},
 CellLabel->"Out[44]=",ExpressionUUID->"f2a1a81a-4a0b-4352-93f5-19195b9c1bdc"]
}, Open  ]],

Cell["\<\
Stop when enough samples are generated OR accuracy is reached. This is a \
typical Monte Carlo stopping criterion.\
\>", "Text",
 CellChangeTimes->{{3.9820303201348553`*^9, 
  3.982030320435896*^9}},ExpressionUUID->"b77a071f-b411-4b88-bc6f-\
2509b3d3ceaa"],

Cell[TextData[{
 StyleBox["RandomReal[]", "Code"],
 " generates ",
 StyleBox["x\[Element][0,1]", "Code"],
 " uniformly. The above example is to find ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "1"], 
     RowBox[{
      SuperscriptBox["x", "2"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"95be7d5d-3e1e-42cd-984e-afbb047d0d29"],
 " ."
}], "Text",
 CellChangeTimes->{{3.9820309498648453`*^9, 3.982030954575638*^9}, {
  3.9820312947123957`*^9, 3.982031310348441*^9}, {3.982031351906355*^9, 
  3.982031380025441*^9}},ExpressionUUID->"d0507854-a867-4b95-9928-\
b0efc7b9260f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nmax", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"samples", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "nmax"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"samples", "^", "2"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9820312898826437`*^9, 3.982031292754266*^9}, {
   3.9820315942087717`*^9, 3.9820315972885103`*^9}, {3.982031955550078*^9, 
   3.982031962218666*^9}, 3.982031992614777*^9, 3.982139891081341*^9, {
   3.982139974770121*^9, 3.982139975257639*^9}, {3.982140032716481*^9, 
   3.9821400329961443`*^9}, {3.982140368802394*^9, 3.982140384555543*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"342921f1-663c-4059-ad94-45eee88ec38c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"estimate", "=", 
   RowBox[{
    RowBox[{"Accumulate", "[", "values", "]"}], "/", 
    RowBox[{"Range", "[", "nmax", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.982031400448299*^9, 3.9820314038435507`*^9}, 
   3.982031964431961*^9, 3.9821403875748577`*^9},
 CellLabel->"In[56]:=",ExpressionUUID->"ea0ad2da-3d51-415e-98eb-cc91ddd08488"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
   "0.05079224590370525`", "+", "0.3636469637789462`", "+", 
    "0.24453326007436996`"}], ")"}], "/", "3"}]], "Input",
 CellChangeTimes->{{3.982140011375998*^9, 3.982140018918996*^9}, {
  3.982140059998247*^9, 3.982140081051005*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"67593d4a-0e30-4c2c-951b-2985fedec207"],

Cell[BoxData["0.21965748991900713`"], "Output",
 CellChangeTimes->{
  3.982140026065889*^9, {3.9821400642389183`*^9, 3.9821400813806953`*^9}},
 CellLabel->"Out[41]=",ExpressionUUID->"0b2b4b95-b6e2-4bcc-9f3a-547908aa5dc5"]
}, Open  ]],

Cell[TextData[{
 "This calculates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["x", "i"], "2"], "/", "n", "  "}]}], TraditionalForm]],
  ExpressionUUID->"ce631331-f92f-4e95-9c11-02077d366323"],
 "for every ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "412c890d-133a-4fb7-9798-c9d4774f6c4e"],
 "."
}], "Text",
 CellChangeTimes->{{3.982032089957776*^9, 
  3.982032171865176*^9}},ExpressionUUID->"013586db-44df-46f9-b3a3-\
2dbcebc1b64a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"estimate", ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "0.5"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Number of samples\>\"", ",", "\"\<Estimate\>\""}], "}"}]}], 
   ",", 
   RowBox[{"PlotLabel", "->", "\"\<Monte Carlo Convergence\>\""}]}], 
  "]"}]], "Input",
