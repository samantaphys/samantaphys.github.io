Cell["\<\
\|01f535 Blue line \[RightArrow] path of the particle
\|01f534 Red point \[RightArrow] starting position
\|01f7e2 Green point \[RightArrow] final position\
\>", "Text",ExpressionUUID->"807f4407-dec2-4f23-ab66-6b72d8aa158b"],

Cell[TextData[StyleBox["Monte Carlo simulation for error propagation", \
"Subsection"]], "Text",ExpressionUUID->"1243990d-7aa8-438c-aac2-c3aefec62981"],

Cell[TextData[{
 "Instead of using calculus (derivatives) or the ",
 StyleBox["Around", "Code"],
 " object, we performing an experiment 100,000 times to see how the \
distribution of the result ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "030b41bc-86de-4942-935c-4fad52a138ca"],
 " behaves."
}], "Text",
 CellChangeTimes->{{3.979478253531294*^9, 3.979478275885363*^9}, {
  3.979724134431566*^9, 
  3.9797241360269623`*^9}},ExpressionUUID->"6e5941c3-4a0d-43d9-9de6-\
93a300302d3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.979478073971429*^9, 3.979478082132681*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"08f76f74-1192-450d-826e-6296c2ff04fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"x", " ", "y"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979478050451521*^9, 3.979478061667426*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9c090cd4-247f-46fe-b53d-8f09214c9b80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"samples", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0.50", ",", "0.01"}], "]"}], "]"}], ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"12.4", ",", "0.2"}], "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", "^", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978512285956051*^9, 3.978512305640705*^9}, {
  3.979031674956367*^9, 3.97903168505151*^9}, {3.979477964122528*^9, 
  3.979478011429693*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"d9f2d61a-c79c-4c32-8d85-d23fe3dba7e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Mean", "[", "samples", "]"}], "\n", 
 RowBox[{"StandardDeviation", "[", "samples", "]"}], "\n", 
 RowBox[{"Histogram", "[", 
  RowBox[{"samples", ",", "100"}], "]"}]}], "Input",
 CellChangeTimes->{{3.97851203125184*^9, 3.9785120378190203`*^9}, {
   3.9790313301695557`*^9, 3.979031338292841*^9}, {3.979117419014841*^9, 
