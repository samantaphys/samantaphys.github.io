Cell[TextData[{
 "The probability of a random point landing in the circle is: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "=", 
    RowBox[{"\[Pi]", "/", "4"}]}], TraditionalForm]],ExpressionUUID->
  "0a297803-43a9-4a2c-bf26-4344f2891b3c"],
