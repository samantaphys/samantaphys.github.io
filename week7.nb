Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"insidePoints", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"points", ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "<=", "1"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"outsidePoints", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"points", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], ">", "1"}], "&"}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"insidePoints", ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}], ",", 
