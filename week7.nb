Cell[TextData[{
 "In Mathematica, the ",
 StyleBox["Manipulate", "Code"],
 " command allows us to change the off-diagonal elements of the covariance \
matrix dynamically."
}], "Text",
 CellChangeTimes->{
  3.979481891976865*^9},ExpressionUUID->"8e41e7a4-f9c9-4ebf-a2c9-\
bb176f51af45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "cov", ",", "vals", ",", "vecs", ",", "axis1", ",", "axis2", ",", 
        "dist", ",", "pts"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cov", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "rho"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"rho", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"values", ",", "vectors"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", "cov", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"axis1", "=", 
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"values", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "*", 
         RowBox[{"vectors", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"axis2", "=", 
        RowBox[{"2", "*", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"values", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "*", 
         RowBox[{"vectors", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"SeedRandom", "[", "123", "]"}], ";", 
       RowBox[{"dist", "=", 
        RowBox[{"MultinormalDistribution", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "cov"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pts", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"dist", ",", "600"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ListPlot", "[", 
          RowBox[{"pts", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"PointSize", "[", "Small", "]"}], ",", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"AspectRatio", "->", "1"}]}], "]"}], ",", 
         RowBox[{"RegionPlot", "[", 
          RowBox[{
           RowBox[{"RegionMember", "[", 
            RowBox[{
             RowBox[{"Ellipsoid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", "cov"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", "Transparent"}], ",", 
           RowBox[{"BoundaryStyle", "->", 
            RowBox[{"{", 
             RowBox[{"Thick", ",", "Red"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", "Blue", ",", 
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", "axis1"}], "}"}], "]"}], 
            ",", 
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", "axis2"}], "}"}], 
             "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<Correlation (\[Rho]) = \>\"", "<>", 
             RowBox[{"ToString", "[", "rho", "]"}]}], ",", "14"}], "]"}]}]}], 
        "]"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rho", ",", "0.8", ",", "\"\<Correlation (\[Rho])\>\""}], 
       "}"}], ",", 
      RowBox[{"-", "0.99"}], ",", "0.99", ",", 
      RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], "]"}], " ", 
  
  RowBox[{"(*", 
   RowBox[{"Control", ":", 
    RowBox[{
     RowBox[{"rho", " ", "ranges", " ", "from"}], " ", "-", 
     RowBox[{
     "0.99", " ", "to", " ", "0.99", " ", "to", " ", "avoid", " ", "singular",
       " ", "matrices"}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.979481432908737*^9, {3.9794814658820972`*^9, 3.979481537259632*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"6211449c-d9db-4dc7-9537-b6bc995fcffd"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`rho$$ = -0.696, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`rho$$], 0.8, "Correlation (\[Rho])"}, -0.99, 0.99}}, 
    Typeset`size$$ = {360., {187., 195.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`rho$$ = 0.8}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`cov$, $CellContext`vals$, $CellContext`vecs$, \
$CellContext`axis1$, $CellContext`axis2$, $CellContext`dist$, \
$CellContext`pts$}, $CellContext`cov$ = {{
           1, $CellContext`rho$$}, {$CellContext`rho$$, 
            1}}; {$CellContext`values, $CellContext`vectors} = 
         Eigensystem[$CellContext`cov$]; $CellContext`axis1$ = (2 Sqrt[
             Abs[
              Part[$CellContext`values, 1]]]) 
          Part[$CellContext`vectors, 1]; $CellContext`axis2$ = (2 Sqrt[
             Abs[
              Part[$CellContext`values, 2]]]) Part[$CellContext`vectors, 2]; 
        SeedRandom[123]; $CellContext`dist$ = 
         MultinormalDistribution[{0, 
           0}, $CellContext`cov$]; $CellContext`pts$ = 
         RandomVariate[$CellContext`dist$, 600]; Show[
          ListPlot[$CellContext`pts$, PlotStyle -> Directive[
             PointSize[Small], 
             Opacity[0.3]], PlotRange -> {{-4, 4}, {-4, 4}}, Frame -> True, 
           AspectRatio -> 1], 
          RegionPlot[
           RegionMember[
            
            Ellipsoid[{0, 
             0}, $CellContext`cov$], {$CellContext`x, $CellContext`y}], \
{$CellContext`x, -4, 4}, {$CellContext`y, -4, 4}, PlotStyle -> Transparent, 
           BoundaryStyle -> {Thick, Red}], 
          Graphics[{Thick, Blue, 
            Arrow[{{0, 0}, $CellContext`axis1$}], 
            Arrow[{{0, 0}, $CellContext`axis2$}]}], PlotLabel -> 
          Style["Correlation (\[Rho]) = " <> ToString[$CellContext`rho$$], 
            14]]], "Specifications" :> {{{$CellContext`rho$$, 0.8, 
          "Correlation (\[Rho])"}, -0.99, 0.99, Appearance -> "Labeled"}}, 
      "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{408., {240., 249.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellChangeTimes->{3.979724911847888*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"5510088f-8e7f-45e9-9cf2-cb24fc23eb61"]
}, Open  ]],

Cell["\<\
The \"Error\" on the fit is essentially the length of that Minor Axis. If the \
minor axis is very short compared to the major axis, the fit is \"good\".\
\>", "Text",
 CellChangeTimes->{{3.979481967746285*^9, 
  3.979481968940034*^9}},ExpressionUUID->"5e528018-7abb-4373-80ef-\
63e2fb945479"],

Cell[TextData[{
 StyleBox["Problem-1: ", "Subsection"],
 "Find the integral",
 StyleBox[" ", "Subsection"],
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "1"], 
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", "+", 
        SuperscriptBox["x", "4"]}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"97f06890-6338-4170-862e-7cf5bc04ae49"],
 " , using the Monte-Carlo method."
}], "Text",
 CellChangeTimes->{{3.9781804773221416`*^9, 3.978180503519677*^9}, {
  3.982120259451467*^9, 3.9821202611012163`*^9}, {3.9821203302671833`*^9, 
  3.982120441257052*^9}},ExpressionUUID->"6576aaf0-18b8-4342-9732-\
cfdf9fb5da34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9821431859311523`*^9, 3.9821431962592907`*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"1baf37fe-0174-47f3-999e-8ed40815a651"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"x", "^", "4"}]}], ")"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"10", "^", "6"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xs", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "random", " ", "samples", " ", 
    RowBox[{"b", "/", 
     RowBox[{"w", " ", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"estInt", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"f", "/@", "xs"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.982120271694556*^9, 3.982120313449863*^9}, {
  3.9821204460617533`*^9, 3.982120469412999*^9}, {3.982143346054882*^9, 
  3.9821433701267843`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"99bd6c9f-f6d0-4685-8649-018b3a6cd340"],

Cell[BoxData["0.8668994021514612`"], "Output",
 CellChangeTimes->{
  3.982120449363265*^9, {3.982143179051836*^9, 3.982143217206614*^9}, {
   3.982143347541862*^9, 3.982143371097066*^9}},
 CellLabel->"Out[22]=",ExpressionUUID->"b664f440-0bc8-4db5-a5c4-f01feb86a11e"]
}, Open  ]],

Cell[TextData[{
 "Monte Carlo replaces the integral by the average value of the function over \
random points in the integration region.\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      StyleBox["a", "TI"], 
      StyleBox["b", "TI"]], 
     RowBox[{
      RowBox[{
       StyleBox["f", "TI"], "(", 
       StyleBox["x", "TI"], ")"}], 
      RowBox[{"\[DifferentialD]", 
       StyleBox["x", "TI"]}]}]}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["b", "TI"], "-", 
       StyleBox["a", "TI"]}], ")"}], 
     FractionBox["1", 
      StyleBox["N", "TI"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["i", "TI"], "=", "1"}], 
       StyleBox["N", "TI"],
       LimitsPositioning->True], 
      RowBox[{
       StyleBox["f", "TI"], "(", 
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["i", "TI"]], ")"}]}]}]}], TraditionalForm]],
  TextAlignment->Center,ExpressionUUID->"ddcdc3b1-e4fa-4880-a1fd-7698907ded6b"]
}], "Text",
 CellChangeTimes->{{3.982120588828792*^9, 
  3.9821206014588537`*^9}},ExpressionUUID->"df917790-3dc2-4328-b8fb-\
56923e5cac3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{3.982120657779805*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"438e3522-1615-47a9-84ae-36b6c69167c9"],

Cell[BoxData["0.8669729873399123`"], "Output",
 CellChangeTimes->{3.982120658750143*^9, 3.9821433243772163`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"fbd2d23d-b542-4a63-b704-19a8adba3fba"]
}, Open  ]],

Cell["Monte Carlo estimate converges nicely.", "Text",ExpressionUUID->"6df2559c-6881-4f84-a5a5-1ef636e3e8de"],

Cell[TextData[{
 StyleBox["Problem-2:", "Subsection"],
 " Draw random numbers from a uniform distribution on [0,1] and keep adding \
them until their sum exceeds 1. Let \[Xi] be the number of random variables \
required for the sum to exceed 1. Repeat this experiment 10,000 times, and \
estimate the mean value of \[Xi] using a Monte Carlo simulation."
}], "Text",
 CellChangeTimes->{{3.982120906849769*^9, 3.982120978839011*^9}, {
  3.98212165320709*^9, 3.9821216535442123`*^9}, {3.982143428150198*^9, 
  3.982143428464747*^9}},ExpressionUUID->"7249606c-f625-49c2-b836-\
6b871660d852"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trial", "[", "a_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sum", "=", "0"}], ",", 
      RowBox[{"count", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"sum", "<=", "a"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sum", "+=", 
         RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"count", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "count"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.982121080913025*^9, 3.982121112122346*^9}, {
   3.9821211433559732`*^9, 3.982121170343872*^9}, 3.982121204209062*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"d4268322-4e78-440c-8e8b-fbcda3ac364b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nExp", "=", "10000"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"trial", "[", "1", "]"}], ",", 
      RowBox[{"{", "nExp", "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Run", " ", "simulation"}], "*)"}]}], "\n", 
 RowBox[{"est", "=", 
  RowBox[{"N", "[", 
   RowBox[{"Mean", "[", "results", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.982121115461629*^9, 3.9821211388753147`*^9}, {
   3.982121448663415*^9, 3.982121454228511*^9}, 3.982121519862281*^9, {
   3.982121638825548*^9, 3.982121639065687*^9}, {3.982121744505753*^9, 
