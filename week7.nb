Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"runningMeans", "=", 
    RowBox[{"4.0", "*", 
     RowBox[{
      RowBox[{"Accumulate", "[", "insideQ", "]"}], "/", 
      RowBox[{"Range", "[", "n", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"runningMeans", ",", 
