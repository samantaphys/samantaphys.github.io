Cell[TextData[StyleBox["Count[list, condition]-> It counts how many elements \
in list satisfy the condition.", "Code"]], "Text",
 CellChangeTimes->{{3.982067784124538*^9, 
  3.982067808130191*^9}},ExpressionUUID->"b2d852d9-9843-4661-9020-\
01efcbd0636e"],

Cell["\<\
Monte Carlo estimates cluster around the true value (Gaussian-like)\
\>", "Text",
 CellChangeTimes->{{3.982067605267668*^9, 
  3.982067617794875*^9}},ExpressionUUID->"7762d918-311a-4c1d-bdb6-\
fd2e92033cd0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"mean", "=", 
  RowBox[{"Mean", "[", "simulations", "]"}]}], "\n", 
 RowBox[{"sigma", "=", 
  RowBox[{"StandardDeviation", "[", "simulations", "]"}]}]}], "Input",
 CellChangeTimes->{3.982067454157679*^9},
 CellLabel->"In[83]:=",ExpressionUUID->"881bc2e7-02fe-475b-ab9d-82c7ce8b8b25"],

Cell[BoxData["3.141415999999996`"], "Output",
 CellChangeTimes->{3.982067455074107*^9, 3.9821421908272467`*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"1e503370-78b3-4f76-b9c3-68a07d55f11b"],

Cell[BoxData["0.07134915308288999`"], "Output",
 CellChangeTimes->{3.982067455074107*^9, 3.982142190831468*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"d0354654-ee7c-4bb2-97f3-58e470d3cabd"]
}, Open  ]],

