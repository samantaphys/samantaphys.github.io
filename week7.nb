 CellChangeTimes->{{3.982122218128807*^9, 3.982122236230839*^9}, {
   3.982122453709236*^9, 3.982122509688727*^9}, 3.982122578317836*^9, 
   3.982143962006215*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"9b76edc1-e4c0-41ca-a10a-0a0a7d436bb9"]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s change the mean of random variables: ",
 StyleBox["a,b,c,d\[Tilde]Normal(1,1)", "Code"]
}], "Text",
 CellChangeTimes->{{3.9821226005293922`*^9, 
  3.982122631028083*^9}},ExpressionUUID->"4c735894-cd80-4f74-a010-\
d10d8bf93602"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "100000"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mats", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"1", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", 
    RowBox[{
    "generate", " ", "random", " ", "2", "*", "2", " ", "matrices", " ", "in",
      " ", "the", " ", "form", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "*)"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dets", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", 
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "4"}], "]"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "*", 
      RowBox[{"mats", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"compute", " ", "determinants"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"fraction", "=", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"dets", ",", 
       RowBox[{
        RowBox[{"#", "<", "0"}], "&"}]}], "]"}], "]"}], "/", "n"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.982122589281968*^9, 3.98212259255669*^9}, {
