Cell[TextData[{
 "Let\[CloseCurlyQuote]s runs 1000 Monte Carlo experiments, where each \
experiment throws 500 random darts in the square ",
 StyleBox["[\[Minus]1,1]\[Times][\[Minus]1,1]. ", "Code"]
}], "Text",
 CellChangeTimes->{{3.9820675239673567`*^9, 
  3.982067557196517*^9}},ExpressionUUID->"0ef54cda-8b1f-4a01-91db-\
27c01ab9ec61"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"numSimulations", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numDarts", "=", "5000"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"simulations", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"points", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"numDarts", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"inside", "=", 
        RowBox[{"Count", "[", 
         RowBox[{"points", ",", 
          RowBox[{"p_", "/;", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"p", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"p", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "<=", "1"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"4.0", "*", 
        RowBox[{"inside", "/", "numDarts"}]}]}], ",", 
      RowBox[{"{", "numSimulations", "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mean", "=", 
   RowBox[{"Mean", "[", "simulations", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", "=", 
    RowBox[{"StandardDeviation", "[", "simulations", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"simulations", ",", "30", ",", "\"\<PDF\>\"", ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Monte Carlo \[Pi] Estimates with Bell Curve\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Pi] estimate\>\"", ",", "\"\<Probability Density\>\""}],
        "}"}]}], ",", 
     RowBox[{"ChartStyle", "->", "LightBlue"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"mean", ",", "sigma"}], "]"}], ",", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Min", "[", "simulations", "]"}], ",", 
       RowBox[{"Max", "[", "simulations", "]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{
  3.9820563775548897`*^9, 3.982065651727737*^9, {3.982067183061873*^9, 
   3.982067208975975*^9}, {3.982067281977635*^9, 3.982067284853673*^9}, {
   3.9820673170017347`*^9, 3.98206733230964*^9}, 3.982142222535043*^9, {
   3.9821422594567966`*^9, 3.9821422617556467`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"d4c4aee6-4952-4164-9315-70b7bb030388"],

