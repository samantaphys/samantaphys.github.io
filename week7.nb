Cell[TextData[StyleBox["Randomness", "Subsection"]], "Text",
 CellChangeTimes->{{3.97851014404093*^9, 3.978510146044952*^9}, {
   3.978961906750209*^9, 3.9789620128714848`*^9}, {3.9789645928273373`*^9, 
   3.978964597173747*^9}, 3.9794718032917852`*^9, {3.9794718940024433`*^9, 
   3.979471905108098*^9}, 
   3.9820565394971437`*^9},ExpressionUUID->"878092f5-1f07-4700-b49d-\
7f7ffb42e545"],

Cell["\<\
In Monte Carlo, we use the mean of random samples to find a value we don\
\[CloseCurlyQuote]t know.\
\>", "Text",
 CellChangeTimes->{{3.982057661065051*^9, 
  3.9820576640082903`*^9}},ExpressionUUID->"3ca734f0-02c8-4ca4-b1dc-\
4b9ca775c11b"],

Cell["\<\
Example-1: Estimating \[Pi] by throwing \[OpenCurlyDoubleQuote]darts\
\[CloseCurlyDoubleQuote] at a square containing a circle. \
\>", "Text",
 CellChangeTimes->{{3.982057689070972*^9, 
  3.982057703444068*^9}},ExpressionUUID->"6f0e053a-2690-4fbf-ba01-\
0ac70acc3676"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"points", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "2"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"points", " ", "lie", " ", "in", " ", "the", " ", 
    RowBox[{"square", " ", "[", 
     RowBox[{
      RowBox[{"\[Minus]", "1"}], ",", "1"}], "]"}], "\[Times]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"\[Minus]", "1"}], ",", "1"}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"insideQ", "=", 
    RowBox[{"UnitStep", "[", 
     RowBox[{"1", "-", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"points", "^", "2"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", 
    RowBox[{"Logic", " ", "test", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}]}], "<=", "1"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Total", "[", "insideQ", "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "count", " ", "how", " ", "many", " ", "darts", " ", "hit", " ", "the", 
    " ", "circle"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"estPi", "=", 
  RowBox[{"4.", "*", 
   RowBox[{
    RowBox[{"Total", "[", "insideQ", "]"}], "/", "n", "   "}]}]}]}], "Input",
 CellChangeTimes->{
  3.9789620762376423`*^9, {3.9791153475144453`*^9, 3.9791153725967607`*^9}, {
   3.979115502664016*^9, 3.979115522504627*^9}, 3.979471808852975*^9, {
   3.979471854364623*^9, 3.979471879999661*^9}, {3.9794719784219227`*^9, 
   3.9794720038662357`*^9}, 3.982056340606093*^9, {3.982056579786788*^9, 
   3.982056614468995*^9}, {3.982057892344214*^9, 3.9820579059513903`*^9}, {
   3.9820580699775467`*^9, 3.9820580713530493`*^9}, {3.982058222088949*^9, 
   3.982058226466716*^9}, {3.9820583614485083`*^9, 3.982058362626361*^9}, {
   3.982058457075409*^9, 3.982058468316779*^9}, {3.982058526349118*^9, 
   3.9820585267804537`*^9}, {3.982058564095875*^9, 3.982058574738738*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"03ba6bec-115c-41f5-9622-0d69037a9e8c"],

Cell[BoxData["3.132`"], "Output",
 CellChangeTimes->{3.979720827369843*^9, 3.9820563444168863`*^9, 
  3.982056617356946*^9, 3.982058227748774*^9, 3.982058363580812*^9, 
  3.982058435993143*^9, 3.982058577286564*^9, 3.982140955841094*^9},
 CellLabel->"Out[69]=",ExpressionUUID->"1bfa3c64-03c9-4af7-988d-2728b68d5ba9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "-", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}], ")"}]}], " ", "->", " "}], 
   TraditionalForm]],ExpressionUUID->"9098c6de-41ae-4920-bd8a-a474ed474776"],
 "this quantity tells us whether a point is inside the unit circle."
}], "Text",
 CellChangeTimes->{{3.98205827974334*^9, 
  3.982058304218536*^9}},ExpressionUUID->"125e026a-a7ed-468a-b798-\
57861a88ed80"],

Cell[TextData[StyleBox["UniStep[]: step function, it\[CloseCurlyQuote]s \
returns 1 \[RightArrow] point inside the circle, or 0 \[RightArrow] point \
outside the circle.", "Code"]], "Text",
 CellChangeTimes->{{3.9820581286063223`*^9, 3.982058173009674*^9}, {
  3.98205849590486*^9, 
  3.9820585224071913`*^9}},ExpressionUUID->"74b16465-f749-48b6-b512-\
19a39797ba94"],

