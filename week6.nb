Cell["\<\
The steady-state solution can be written using complex notation:\
\>", "Text",
 CellChangeTimes->{{3.9814747070507727`*^9, 
  3.9814747275430317`*^9}},ExpressionUUID->"189450d9-37e5-4a9d-bc41-\
e22bafe0adce"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"x", "(", "t", ")"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["F", "0"], "/", "m"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[Omega]", "0"], "2"], "-", 
