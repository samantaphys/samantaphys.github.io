Cell[TextData[StyleBox["Example 1: A vertically falling object with quartic \
drag force.", "Subsection"]], "Text",
 CellChangeTimes->{{3.979471730090386*^9, 3.979471737280156*^9}, 
   3.980299129798504*^9, {3.980794771255699*^9, 3.980794787576828*^9}, {
   3.981508712097526*^9, 3.981508714946165*^9}, 3.981509010590453*^9, {
   3.98151168060954*^9, 
   3.981511681461143*^9}},ExpressionUUID->"98a74d4e-d2b3-4c05-a93d-\
5715dfbecbaf"],

Cell[TextData[{
 "We consider a body of mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "154b968d-f9ff-48f9-90c3-4cd329fc983c"],
 " falling under gravity ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "a00870d4-e709-400a-83b1-c3851f11f1a9"],
 " with a drag force ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["F", "TI"], 
         RowBox[{
           StyleBox["d", "TI"], 
           StyleBox["r", "TI"], 
           StyleBox["a", "TI"], 
           StyleBox["g", "TI"]}]], "\[LongEqual]", "-", 
        StyleBox["k", "TI"], 
        SuperscriptBox[
         StyleBox["v", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
    "input" -> "$F_{drag} = -kv^4$", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]],
  CellChangeTimes->{3.981508201169182*^9},ExpressionUUID->
  "2baa38f1-6623-44c4-a9c0-71b3be1ad607"],
 ". The equation of motion is:"
}], "Text",
 CellChangeTimes->{{3.9815079354098186`*^9, 3.981507939863409*^9}, {
   3.981508065413924*^9, 3.981508070478034*^9}, 3.9815082230214777`*^9, {
   3.981508988982957*^9, 
   3.9815089911347857`*^9}},ExpressionUUID->"8c1cc34f-0ed6-4489-b782-\
fc87ad7b4e34"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["m", "TI"], 
        FractionBox[
         RowBox[{
           SuperscriptBox[
            StyleBox["d", "TI"], "2"], 
           StyleBox["y", "TI"]}], 
         RowBox[{
           StyleBox["d", "TI"], 
           SuperscriptBox[
            StyleBox["t", "TI"], "2"]}]], "\[LongEqual]", 
        StyleBox["m", "TI"], 
        StyleBox["g", "TI"], "-", 
        StyleBox["k", "TI"], 
        SuperscriptBox[
         RowBox[{"(", 
           FractionBox[
            RowBox[{
              StyleBox["d", "TI"], 
              StyleBox["y", "TI"]}], 
            RowBox[{
              StyleBox["d", "TI"], 
              StyleBox["t", "TI"]}]], ")"}], "4"]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "$m \\frac{d^2y}{dt^2} = mg - k\\left(\\frac{dy}{dt}\\right)^4$", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"41aa6b67-b0f4-4901-8d7b-48cb556911a6"]], \
"Text",
 CellChangeTimes->{{3.98079480714357*^9, 3.980794881290851*^9}, {
  3.981508276519561*^9, 3.981508282755413*^9}},
 TextAlignment->Center,ExpressionUUID->"f4a43e62-c660-45af-bf4e-3c3931506da1"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s define dimensionless variables \[Tau] (time) and \
\[Chi] (distance) using the scales provided: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "=", 
     RowBox[{"t", "/", 
      SubscriptBox["t", "c"]}]}], " ", ",", " ", 
    RowBox[{"\[Chi]", "=", 
     RowBox[{"y", "/", 
      SubscriptBox["y", "c"]}]}], " ", ",", " ", "where"}], TraditionalForm]],
  ExpressionUUID->"da619381-86c8-4888-96ae-407dcc3b5b35"],
 "\nTime Scale: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["c", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox[
             StyleBox["m", "TI"], 
             RowBox[{
               StyleBox["k", "TI"], 
               SuperscriptBox[
                StyleBox["g", "TI"], "3"]}]], ")"}], 
          RowBox[{"1", "/", "4"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$t_c = \\left(\\frac{m}{kg^3}\\right)^{1/4}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5b6d191-d5a0-43ba-a03a-86bbc7980477"],
 " \nDistance Scale: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["c", "TI"]], "\[LongEqual]", 
         SqrtBox[
          FractionBox[
           StyleBox["m", "TI"], 
           StyleBox["k", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$y_c = \\sqrt{\\frac{m}{k}}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c0c3327-e155-404f-9049-1b330737dcbe"]
}], "Text",
 CellChangeTimes->{{3.980794901498982*^9, 3.9807949215822353`*^9}, {
  3.980795008112899*^9, 3.980795020199719*^9}, {3.9815083370731688`*^9, 
  3.9815084224401503`*^9}, {3.9815085397289867`*^9, 
  3.981508583985362*^9}},ExpressionUUID->"665d2cd4-667a-4b79-95c1-\
c9d64eab0296"],

Cell[BoxData[
 RowBox[{"dimensionless", " ", 
  RowBox[{"ODE", ":", "    ", 
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          FractionBox[
           RowBox[{
             SuperscriptBox[
              StyleBox["d", "TI"], "2"], "\[Chi]"}], 
           RowBox[{
             StyleBox["d", "TI"], 
             SuperscriptBox["\[Tau]", "2"]}]], "\[LongEqual]", "1", "-", 
          SuperscriptBox[
           RowBox[{"(", 
             FractionBox[
              RowBox[{
                StyleBox["d", "TI"], "\[Chi]"}], 
              RowBox[{
                StyleBox["d", "TI"], "\[Tau]"}]], ")"}], "4"]}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "$\\frac{d^2\\chi}{d\\tau^2} = 1 - \
\\left(\\frac{d\\chi}{d\\tau}\\right)^4$", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " ", "."}]}]}]], "Text",
 CellChangeTimes->{{3.9815084980884542`*^9, 3.981508516415513*^9}},
 TextAlignment->Center,ExpressionUUID->"d4d6ed8e-9030-4d8c-b852-67357a1a6ea4"],

Cell["\<\
We split the second-order ODE into a system of two first-order ODEs: \
\>", "Text",
 CellChangeTimes->{
  3.9815087735495768`*^9},ExpressionUUID->"c907bc8b-508f-4dc7-9387-\
a341cb43cb36"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"1.", "   ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          FractionBox[
           RowBox[{
             StyleBox["d", "TI"], "\[Chi]"}], 
           RowBox[{
             StyleBox["d", "TI"], "\[Tau]"}]], "\[LongEqual]", 
          StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "$\\frac{d\\chi}{d\\tau} = v$", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], "Text"], 
  StyleBox["  ", "Text"], 
  StyleBox[",", "Text"], 
  StyleBox["   ", "Text"], 
  FormBox[
   RowBox[{
    RowBox[{"2.", "    ", 
     FractionBox[
      StyleBox[
       RowBox[{"d", "v"}], "TI"], 
      RowBox[{
       StyleBox["d", "TI"], "\[Tau]"}]]}], "\[LongEqual]", 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["v", "TI"], "4"]}]}],
   TraditionalForm]}]], "Input",
 CellChangeTimes->{{3.981508472954845*^9, 3.981508493752385*^9}, {
  3.981508788274836*^9, 3.981508856970312*^9}},
 TextAlignment->Center,ExpressionUUID->"9312c0cb-0b57-493f-b8a7-f262c8c68d25"],

Cell[BoxData[
 FormBox["", TraditionalForm]], "Input",
 CellChangeTimes->{{3.9815082273974257`*^9, 3.981508227402822*^9}, {
  3.981508810346921*^9, 3.981508850240679*^9}},
 TextAlignment->Center,ExpressionUUID->"0cfda708-58d9-49b4-a7a6-e11ccd6779b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[Tau]_", ",", 
     RowBox[{"{", 
      RowBox[{"\[Chi]_", ",", "v_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"v", ",", 
     RowBox[{"1", "-", 
      SuperscriptBox["v", "4"]}]}], "}"}]}], ";"}]], "Input",
