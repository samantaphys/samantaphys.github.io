Cell[CellGroupData[{
Cell[TextData[{
 "Physics through Computational Thinking\n",
 StyleBox["Week-6: Mechanics & Oscillations",
  FontSize->36]
}], "Title",
 CellChangeTimes->{{3.978154444598084*^9, 3.97815454028798*^9}, {
   3.978154584958158*^9, 3.9781545857817307`*^9}, {3.9789595194053926`*^9, 
   3.978959519829749*^9}, 3.9789600051734943`*^9, {3.9794709052870703`*^9, 
   3.979470908000704*^9}, 3.9802980246361637`*^9, {3.9802990465751247`*^9, 
   3.9802990468343153`*^9}, {3.980781608176759*^9, 3.980781608481628*^9}, 
   3.9807823607652473`*^9, {3.981460070705426*^9, 3.981460071140088*^9}, 
   3.981460725036064*^9},
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"f530929d-449d-4ccc-ade4-cd49f17f0e2a"],

Cell[TextData[StyleBox["In this tutorial, we solve few classical mechanics \
problems using Mathematica, focusing on driven oscillations, resonance, air \
resistance, and planetary escape. \n",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978154735010868*^9, 3.978154791048909*^9}, 
   3.978155696134118*^9, {3.9789601022451677`*^9, 3.97896011256898*^9}, {
   3.97896015079508*^9, 3.978960160357774*^9}, {3.978960241220355*^9, 
   3.9789602415653667`*^9}, {3.9794709209781847`*^9, 3.97947097278484*^9}, 
   3.980298105994071*^9, {3.9802981595616217`*^9, 3.980298181861577*^9}, 
   3.9807827277906017`*^9, {3.980782904361061*^9, 3.980783001236928*^9}, {
   3.980783091941367*^9, 3.98078312965969*^9}, {3.981460687806612*^9, 
   3.981460708200652*^9}},
 FontSize->14,ExpressionUUID->"fb58e92b-222e-4ad7-a3a5-253cfc0f6d29"],

Cell[CellGroupData[{

Cell["1. Forced Oscillations, Friction & Resonance", "Section",
 CellChangeTimes->{{3.9781548853480597`*^9, 3.9781548905914392`*^9}, {
   3.9781549953001757`*^9, 3.978154996581554*^9}, 3.978960224929956*^9, {
   3.979470975355*^9, 3.979470977840033*^9}, 3.9802985857184467`*^9, {
   3.980298617958688*^9, 3.980298627073667*^9}, 3.98078264640161*^9, 
   3.980783143288808*^9, {3.9807831937118053`*^9, 3.980783196971957*^9}, {
   3.981461009574929*^9, 3.981461037204303*^9}},
 FontFamily->"Times",ExpressionUUID->"f7a55bbb-9574-4d38-833d-d883e069adaf"],

Cell["We study the damped driven oscillator:", "Text",
 CellChangeTimes->{{3.98078324595938*^9, 3.98078335371623*^9}, 
   3.981461017182596*^9},ExpressionUUID->"e20de147-e007-46da-ae55-\
cbe9ac88b2ee"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " ", 
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], " ", 
    RowBox[{"y", "(", "t"}]}], TraditionalForm]],ExpressionUUID->
  "123a401a-f705-4407-9150-6acc1b9be46c"],
 ") + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"b", 
      FractionBox["d", "dt"], 
      RowBox[{"y", "(", "t", ")"}]}], " ", "+", " ", 
     RowBox[{"k", " ", 
      RowBox[{"x", "(", "t", ")"}]}]}], "=", 
    RowBox[{
     SubscriptBox["F", "0"], 
     RowBox[{"cos", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"667585d3-a3f7-4128-b553-1dd1cfc76480"]
}], "Text",
 CellChangeTimes->{{3.981461124050372*^9, 3.981461189691897*^9}},
 TextAlignment->Center,ExpressionUUID->"29e195c6-9175-4f6d-9509-fe765893effa"],

Cell[TextData[{
 "The above equation can be written as (divided by ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99ff4294-4fe5-4dcd-bfb4-85ed189b52f6"],
 ") --"
}], "Text",
 CellChangeTimes->{{3.9807833791425953`*^9, 3.980783495338208*^9}, {
  3.981461210503633*^9, 
  3.981461256773878*^9}},ExpressionUUID->"fb3e5442-c1cb-411b-8dd0-\
087f9babb6d8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], " ", 
    RowBox[{"y", "(", "t"}]}], TraditionalForm]],ExpressionUUID->
  "a9198f62-17e7-477c-b79c-542bc294ac6a"],
 ") + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", "\[Gamma]", 
      FractionBox["d", "dt"], 
      RowBox[{"y", "(", "t", ")"}]}], " ", "+", " ", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Omega]", "0"], "2"], " ", 
      RowBox[{"x", "(", "t", ")"}]}]}], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["F", "0"], "m"], 
     RowBox[{"cos", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"84b3e67c-6e17-44db-81f5-28ebb64482e3"],
 " ,"
}], "Text",
 CellChangeTimes->{{3.9814612616449137`*^9, 3.981461302079454*^9}},
 TextAlignment->Center,ExpressionUUID->"9e17a99a-f724-453b-a0e6-a31f3da30c14"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Gamma]", "=", 
     RowBox[{"b", "/", 
      RowBox[{"(", 
       RowBox[{"2", "m"}], ")"}]}]}], " ", ",", " ", 
    RowBox[{
     RowBox[{"and", "  ", 
      SubscriptBox["\[Omega]", "0"]}], "=", 
     RowBox[{
      SqrtBox[
       RowBox[{"k", "/", "m"}]], " ", "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3277fef1-b47d-4230-81d0-f58484110c94"]
}], "Text",
 CellChangeTimes->{{3.9814613037648163`*^9, 
  3.981461356499016*^9}},ExpressionUUID->"df83588e-9f79-44cf-8132-\
3aea3ea422e6"],

Cell["\<\
The solution consists of: (i) Transient solution , and (ii) Steady-state \
solution. 
\
\>", "Text",
 CellChangeTimes->{{3.9814621948854933`*^9, 
  3.981462227109919*^9}},ExpressionUUID->"75746a58-a28c-4c0e-b210-\
90b4ebf7768c"],

Cell["Now, implement this in Mathematica ", "Text",
 CellChangeTimes->{{3.980784303422358*^9, 3.980784322802589*^9}, {
  3.981461385071095*^9, 
  3.981461407439261*^9}},ExpressionUUID->"a339946e-c4c9-4e3f-84a9-\
1583689e69c8"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{
  3.9794714641010036`*^9, {3.980298657717767*^9, 3.980298661345336*^9}, 
   3.98029869203461*^9, {3.980326838034441*^9, 3.980326848224606*^9}, {
   3.980783891282078*^9, 3.980783892141691*^9}, {3.98146141957677*^9, 
   3.981461420698292*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"dcc47e68-8f5c-4d23-ba01-aefe7dfe9904"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F0", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9814614339330063`*^9, 3.9814614349630947`*^9}, 
   3.981463346170433*^9, {3.981463772837079*^9, 3.981463773907337*^9}, {
   3.98153523539423*^9, 3.981535235869487*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"ff16c7fe-6992-4ce8-88c7-f80f438d02b9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Omega]0", "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{"k", "/", "m"}], "]"}]}], "\n", 
 RowBox[{"\[Gamma]", "=", 
  RowBox[{"b", "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", "m"}], ")"}]}]}]}], "Input",
 CellChangeTimes->{
  3.9814614485230083`*^9, {3.9814628167182693`*^9, 3.981462819802658*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"e49d4f80-4c7c-4f9c-b548-b701a06033c1"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{{3.9814628180657473`*^9, 3.98146282030764*^9}, 
   3.981463348653215*^9, 3.98146377740728*^9, 3.981476210608802*^9, 
   3.9815339838626204`*^9, 3.9815352406928596`*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"8a6f19af-51fe-40a2-bd0c-86690e6da828"],

Cell[BoxData[
 FractionBox["1", "2"]], "Output",
 CellChangeTimes->{{3.9814628180657473`*^9, 3.98146282030764*^9}, 
   3.981463348653215*^9, 3.98146377740728*^9, 3.981476210608802*^9, 
