Cell[TextData[{
 "The numerical steady-state oscillation amplitude of a damped driven \
harmonic oscillator as a function of \[Omega]. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[TildeTilde]", 
    SubscriptBox["\[Omega]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bc3c21e-6525-4c55-8ed5-65667462d20b"],
 " , there is a resonance. "
}], "Text",
 CellChangeTimes->{{3.9814629747632933`*^9, 3.98146302058634*^9}, {
  3.9814631708838663`*^9, 
  3.9814631810278893`*^9}},ExpressionUUID->"93c6b155-cf90-48b3-983d-\
329c335bbbd7"],

Cell[TextData[{
 "But, the actual resonance frequency :  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "r"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Omega]", "0"], "2"], "-", 
      RowBox[{"2", 
       SuperscriptBox["\[Gamma]", "2"]}]}]]}], TraditionalForm]],
  ExpressionUUID->"6cf5d601-c4d2-4642-a9d1-299f1b8edf3d"],
 "."
}], "Text",
 CellChangeTimes->{{3.9814631844678783`*^9, 
  3.981463240371439*^9}},ExpressionUUID->"65bad1bf-e37e-4edc-858d-\
f51d614a7188"],

Cell[TextData[{
 "If  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Gamma]", ">", "0"}], "  ", ",", " ", 
    RowBox[{
     RowBox[{"the", "  ", 
      SubscriptBox["\[Omega]", "r"]}], "<", 
     RowBox[{
      SubscriptBox["\[Omega]", "0"], " ", "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "145834df-dd5e-4fd7-a024-8ad3bc94688a"]
}], "Text",
 CellChangeTimes->{{3.981463258652869*^9, 
  3.981463286343753*^9}},ExpressionUUID->"fc1999ac-0c30-48f5-8888-\
59e6da5ca56c"],

Cell["\<\
This means the damping shifts the resonance peak to lower frequency. (slow \
response) \
\>", "Text",
 CellChangeTimes->{{3.9814632993226843`*^9, 
  3.9814633224249687`*^9}},ExpressionUUID->"6db48dad-72b6-4e53-ba2f-\
5134dd34b173"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amp", ",", "\[Omega]r"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Omega]r", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Omega]0", "^", "2"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "^", "2"}]}]}], ">", "0"}], ",", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"\[Omega]0", "^", "2"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "^", "2"}]}]}], "]"}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"amp", "[", "\[Omega]_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"F0", "/", "m"}], ")"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Omega]0", "^", "2"}], "-", 
             RowBox[{"\[Omega]", "^", "2"}]}], ")"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", " ", "\[Gamma]", " ", "\[Omega]"}], ")"}], "^", 
           "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"amp", "[", "\[Omega]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Omega]", ",", "0", ",", 
          RowBox[{"2", " ", "\[Omega]0"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", "Thick"}], ",", "\[IndentingNewLine]", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<\[Omega]\>\"", ",", "18", ",", "Red"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<A(\[Omega])\>\"", ",", "18", ",", "Red"}], "]"}]}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Resonance Curve   \>\"", ",", "\"\<\[Omega]r = \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"\[Omega]r", ",", 
                RowBox[{"{", 
                 RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",",
            "16"}], "]"}]}], ",", 
        RowBox[{"Epilog", "->", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", "Dashed", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\[Omega]0", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\[Omega]0", ",", "5"}], "}"}]}], "}"}], "]"}], ",", 
           "Red", ",", "Thick", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\[Omega]r", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\[Omega]r", ",", "5"}], "}"}]}], "}"}], "]"}]}], 
          "}"}]}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", "0.05", ",", "\"\<Damping \[Gamma]\>\""}], 
      "}"}], ",", "0", ",", "1", ",", "0.01", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.979719791542408*^9, 3.979719804225946*^9}, {
  3.979719858521278*^9, 3.979719866023157*^9}, {3.980298673948188*^9, 
  3.98029867818751*^9}, {3.980783919215063*^9, 3.9807839232817*^9}, {
  3.9807920657725067`*^9, 3.9807921663756933`*^9}, {3.980792506658862*^9, 
  3.980792512158471*^9}, {3.981463477498179*^9, 3.981463515484786*^9}, {
  3.9814635489844418`*^9, 3.9814635906748*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"3649eb79-3a02-40d4-a345-b72857654a8d"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`\[Gamma]$$ = 0.26, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`\[Gamma]$$], 0.05, "Damping \[Gamma]"}, 0, 1, 0.01}},
     Typeset`size$$ = {811., {265., 272.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`\[Gamma]$$ = 0.05}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`amp$, $CellContext`\[Omega]r$}, $CellContext`\
\[Omega]r$ = If[$CellContext`\[Omega]0^2 - 2 $CellContext`\[Gamma]$$^2 > 0, 
           Sqrt[$CellContext`\[Omega]0^2 - 2 $CellContext`\[Gamma]$$^2], 
           0]; $CellContext`amp$[
           Pattern[$CellContext`\[Omega]$, 
            Blank[]]] := ($CellContext`F0/$CellContext`m)/
          Sqrt[($CellContext`\[Omega]0^2 - $CellContext`\[Omega]$^2)^2 + (
             2 $CellContext`\[Gamma]$$ $CellContext`\[Omega]$)^2]; Plot[
          $CellContext`amp$[$CellContext`\[Omega]], {$CellContext`\[Omega], 0,
            2 $CellContext`\[Omega]0}, PlotRange -> All, PlotStyle -> Thick, 
          AxesLabel -> {
            Style["\[Omega]", 18, Red], 
            Style["A(\[Omega])", 18, Red]}, PlotLabel -> Style[
            Row[{"Resonance Curve   ", "\[Omega]r = ", 
              NumberForm[$CellContext`\[Omega]r$, {3, 2}]}], 16], 
          Epilog -> {Blue, Dashed, 
            Line[{{$CellContext`\[Omega]0, 0}, {$CellContext`\[Omega]0, 5}}], 
            Red, Thick, 
            
            Line[{{$CellContext`\[Omega]r$, 0}, {$CellContext`\[Omega]r$, 
               5}}]}]], 
      "Specifications" :> {{{$CellContext`\[Gamma]$$, 0.05, 
          "Damping \[Gamma]"}, 0, 1, 0.01, Appearance -> "Labeled"}}, 
      "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{859., {331., 340.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
