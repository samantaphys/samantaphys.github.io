Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nMax", "=", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Tau]max", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{"N", "[", 
     RowBox[{"\[Tau]max", "/", "nMax"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Chi]", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", "\[Chi]", ",", "v"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k1\[Chi]", "=", "v"}], ";", "\[IndentingNewLine]", 
     RowBox[{"k1v", "=", 
      RowBox[{"1", "-", 
       RowBox[{"v", "^", "4"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"k2\[Chi]", "=", 
      RowBox[{"v", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h", "/", "2"}], ")"}], " ", "k1v"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k2v", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"v", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", "/", "2"}], ")"}], " ", "k1v"}]}], ")"}], "^", 
        "4"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"k3\[Chi]", "=", 
      RowBox[{"v", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h", "/", "2"}], ")"}], " ", "k2v"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k3v", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"v", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", "/", "2"}], ")"}], " ", "k2v"}]}], ")"}], "^", 
        "4"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"k4\[Chi]", "=", 
      RowBox[{"v", "+", 
       RowBox[{"h", " ", "k3v"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k4v", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"v", "+", 
          RowBox[{"h", " ", "k3v"}]}], ")"}], "^", "4"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Chi]", "=", 
      RowBox[{"\[Chi]", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h", "/", "6"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"k1\[Chi]", "+", 
          RowBox[{"2", " ", "k2\[Chi]"}], "+", 
          RowBox[{"2", " ", "k3\[Chi]"}], "+", "k4\[Chi]"}], ")"}]}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"v", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h", "/", "6"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"k1v", "+", 
          RowBox[{"2", " ", "k2v"}], "+", 
          RowBox[{"2", " ", "k3v"}], "+", "k4v"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", "=", 
      RowBox[{"\[Tau]", "+", "h"}]}], ";"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", "nMax", "}"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.981509777429421*^9, 3.981509967871109*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"d51700bd-4fa6-49b0-9204-0cf44d6f65c1"],

