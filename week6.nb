Cell[BoxData[
 RowBox[{
  RowBox[{"solRK4", "=", 
   RowBox[{"RK4", "[", 
    RowBox[{"f", ",", "x0", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "5"}], "}"}], ",", "h"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9802987866136103`*^9, 3.9802987983510942`*^9}, {
   3.9803268221852837`*^9, 3.980326822567211*^9}, {3.980794059918981*^9, 
   3.9807940661750793`*^9}, 3.98093090461318*^9, {3.981476272720652*^9, 
