    Typeset`size$$ = {360., {185., 193.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = False}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`mu$$ = 1.}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`vdp$, $CellContext`solutions$, \
$CellContext`field$}, $CellContext`vdp$ = {
          Derivative[
            1][$CellContext`x][$CellContext`t] == \
$CellContext`v[$CellContext`t], 
           Derivative[
            1][$CellContext`v][$CellContext`t] == ($CellContext`mu$$ (
               1 - $CellContext`x[$CellContext`t]^2)) \
$CellContext`v[$CellContext`t] - $CellContext`x[$CellContext`t]}; \
$CellContext`solutions$ = Table[
           
           NDSolveValue[{$CellContext`vdp$, $CellContext`x[0] == 
             Part[$CellContext`ic, 1], $CellContext`v[0] == 
