Cell[BoxData[
 RowBox[{
  RowBox[{"RK4", "[", 
   RowBox[{"f_", ",", "y0_", ",", 
    RowBox[{"{", 
     RowBox[{"t0_", ",", "tmax_"}], "}"}], ",", "h_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tlist", ",", "ylist", ",", "nsteps", ",", "k1", ",", "k2", ",", "k3", 
      ",", "k4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tlist", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"t0", ",", "tmax", ",", "h"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nsteps", "=", 
      RowBox[{"Length", "[", "tlist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ylist", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "nsteps"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ylist", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", "y0"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k1", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"tlist", "[", 
            RowBox[{"[", "n", "]"}], "]"}], ",", 
           RowBox[{"ylist", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k2", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tlist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{"h", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{"ylist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"h", "/", "2"}], " ", "k1"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k3", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tlist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{"h", "/", "2"}]}], ",", 
           RowBox[{
            RowBox[{"ylist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"h", "/", "2"}], " ", "k2"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k4", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tlist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", "h"}], ",", 
           RowBox[{
            RowBox[{"ylist", "[", 
             RowBox[{"[", "n", "]"}], "]"}], "+", 
            RowBox[{"h", " ", "k3"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ylist", "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"ylist", "[", 
           RowBox[{"[", "n", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", "/", "6"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"k1", "+", 
             RowBox[{"2", " ", "k2"}], "+", 
             RowBox[{"2", " ", "k3"}], "+", "k4"}], ")"}]}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"nsteps", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", "ylist"}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.981507661110715*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"761ef4f1-92b9-4739-85e5-7dd060ee9789"],

