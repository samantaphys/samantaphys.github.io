Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", "dt"], 
     RowBox[{"(", GridBox[{
        {"x"},
        {"v"}
       }], ")"}]}], "=", 
    RowBox[{"(", GridBox[{
       {"v"},
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "\[DoubledGamma]", " ", "v"}], "-", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["\[Omega]", "0"], "2"], "x"}], " ", "+", 
         RowBox[{
          FractionBox[
           SubscriptBox["F", "0"], "m"], 
          RowBox[{"cos", "(", 
           RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cb480ccf-ef80-468f-9270-33da95a3af7a"],
 "   , where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     FractionBox["d", "dt"], "x"}]}], TraditionalForm]],ExpressionUUID->
  "3cd8ddc0-27e8-42ee-9cd6-c862c040ab3b"],
