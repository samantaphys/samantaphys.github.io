Cell["\<\
Limit Cycle: A closed, isolated trajectory in phase space. It is a \
self-sustained periodic motion and it does NOT depend on initial conditions.\
\>", "Text",
 CellChangeTimes->{{3.980860364419591*^9, 
  3.980860416346039*^9}},ExpressionUUID->"c2081c42-095a-49fd-b247-\
a9a6f233ffd1"],

Cell["Solve using NDSolve:", "Text",
 CellChangeTimes->{{3.980860494301162*^9, 
  3.980860506791176*^9}},ExpressionUUID->"1ebeb8a3-19b9-476d-8646-\
e9c2bdd977ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.981538996407188*^9, 3.981539014423046*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"be4dcea3-7931-4c1c-8656-dd95313dc988"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vdp", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"v", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"mu", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{"v", "[", "t", "]"}]}], "-", 
       RowBox[{"x", "[", "t", "]"}]}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{3.980860531993368*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"e2e38af3-112f-44e2-820b-335fbb09d4bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solutions", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vdp", ",", 
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "==", 
          RowBox[{"ic", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"v", "[", "0", "]"}], "==", 
          RowBox[{"ic", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "40"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ic", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.980860510911037*^9, 3.980860538536147*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"d2bdc85a-4ed5-4a79-a448-73b022307c04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "solutions", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Blue", ",", "Black"}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Position (x)\>\"", ",", "\"\<Velocity (v)\>\""}], "}"}]}], 
   ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Convergence to Limit Cycle (\[Mu] = 1)\>\""}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<x[0]=0.1, v[0]=0.\>\"", ",", "\"\<x[0]=3.0, v[0]=0.\>\"", ",", 
      "\"\<x[0]=-2.0, v[0]=1.0\>\""}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.98086055497924*^9, {3.980860604179797*^9, 3.980860721700218*^9}, {
   3.980919680522502*^9, 3.980919681003808*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"624f85c5-2308-4912-8cea-0756c337cfd9"],

