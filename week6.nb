Cell[BoxData[
 RowBox[{"solExact", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
        RowBox[{"x", "[", "t", "]"}]}], "==", 
       RowBox[{"t", "^", "3"}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.981511100945455*^9, 3.981511112015189*^9}, {
   3.9815111732237473`*^9, 3.9815111831499968`*^9}, 3.9815112517892227`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"25599d99-1de7-4d28-b3db-1a2532bdac1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "6"}], " ", "t"}], "+", 
     SuperscriptBox["t", "3"], "+", 
     RowBox[{"6", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.981511252310719*^9, 3.981538161397913*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"56f5753c-ba61-4973-b493-f94550ae5d38"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", " ", 
    RowBox[{"solExact", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "/.", " ", 
   RowBox[{"t", "->", "5"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.981511141767951*^9, {3.981511189145566*^9, 3.981511190032073*^9}, {
   3.981511259174345*^9, 3.981511269634823*^9}, {3.981511306700685*^9, 
   3.98151131171082*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"f9c6c967-59d8-4a9d-b0b8-53b526a4a7f8"],

Cell[BoxData["89.24645435202117`"], "Output",
 CellChangeTimes->{{3.98151114337609*^9, 3.981511195711556*^9}, {
   3.981511261734981*^9, 3.981511269958308*^9}, {3.9815113079780693`*^9, 
   3.9815113120967827`*^9}, 3.981538172355871*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"aefc1ca7-0695-4afd-8f62-30a83f2184fd"]
}, Open  ]],

Cell[TextData[StyleBox["Example 3: A projectile motion.", "Subsection"]], \
"Text",
 CellChangeTimes->{{3.981512512448535*^9, 3.981512512584997*^9}, {
  3.9815125443369913`*^9, 
  3.981512551060721*^9}},ExpressionUUID->"237814f8-049f-499c-bb95-\
d47dfb829278"],

Cell[TextData[{
 "We solve the non-dimensional equation:    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], "2"], 
            StyleBox["x", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            SuperscriptBox[
             StyleBox["t", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox["-1", 
          SuperscriptBox[
           StyleBox["x", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{d^2x}{dt^2}=\\frac{-1}{x^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ab74950-d2c4-4e25-81bd-eaba61ed1d81"],
 "  with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "(", "0", ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"eb5a7516-edf9-4bcf-93e9-baa879b4dfe1"],
 " and initial velocity equal to 1.5 times the escape velocity."
}], "Text",
 CellChangeTimes->{{3.981512260323682*^9, 3.9815123369149103`*^9}, {
  3.9815123744165077`*^9, 3.9815123748427887`*^9}, {3.981512419496338*^9, 
  3.981512462670179*^9}},ExpressionUUID->"985f0176-355e-4ac1-b485-\
698e398f2faa"],

Cell["First, we calculate the escape velocity: ", "Text",
 CellChangeTimes->{{3.981512614843458*^9, 
  3.9815126362761374`*^9}},ExpressionUUID->"3415aac8-a40b-4d36-b080-\
83f0223e1359"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox[
        SubscriptBox["v", "e"], "2"]}], "-", 
      FractionBox["1", "x"]}], "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "2103b59f-91b7-458c-99d7-bc024f971bbd"],
 " (for escape velocity). At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "f8750a86-568e-489e-871e-c86439127a24"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "e"], "=", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "f93c3c35-1e76-434d-bee7-c5b7b248ccec"],
 "."
}], "Text",
 CellChangeTimes->{{3.981512703020343*^9, 
  3.981512816085557*^9}},ExpressionUUID->"c06e64d5-b744-475a-bdee-\
e54f4482e164"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"t_", ",", "x1_", ",", "x2_"}], "]"}], ":=", "x2"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", 
    RowBox[{"t_", ",", "x1_", ",", "x2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "/", 
    RowBox[{"x1", "^", "2"}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tmax", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nMax", "=", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"tmax", "-", "t0"}], ")"}], "/", "nMax"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", "t0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x1", "=", "1"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"x", 
    RowBox[{"(", "t0", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x2", "=", 
    RowBox[{"1.5", " ", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"1.5", "\[Times]", " ", "escape", " ", "velocity"}], " ", "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k1x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{"t", ",", "x1", ",", "x2"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k1x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{"t", ",", "x1", ",", "x2"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k2x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k1x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k1x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k2x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k1x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k1x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k3x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k2x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k2x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k3x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k2x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k2x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k4x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", "h"}], ",", 
        RowBox[{"x1", "+", "k3x1"}], ",", 
        RowBox[{"x2", "+", "k3x2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"k4x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", "h"}], ",", 
        RowBox[{"x1", "+", "k3x1"}], ",", 
        RowBox[{"x2", "+", "k3x2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"x1", "=", 
     RowBox[{"x1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1x1", "+", 
         RowBox[{"2", " ", "k2x1"}], "+", 
         RowBox[{"2", " ", "k3x1"}], "+", "k4x1"}], ")"}], "/", "6"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"x2", "=", 
     RowBox[{"x2", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1x2", "+", 
         RowBox[{"2", " ", "k2x2"}], "+", 
         RowBox[{"2", " ", "k3x2"}], "+", "k4x2"}], ")"}], "/", "6"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"t", "=", 
     RowBox[{"t", "+", "h"}]}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", "nMax", "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.981512589874333*^9, 3.981512599890586*^9}, {
   3.981512892497978*^9, 3.98151296014885*^9}, 3.981516080468801*^9, {
   3.9815161292795258`*^9, 3.98151618111727*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"7a4e847f-ffdb-46db-bee5-9ad4fbb4b4b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xATt2", "=", "x1"}]], "Input",
 CellChangeTimes->{{3.981512978649325*^9, 3.9815129820303907`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"5420a893-e04a-4201-b70d-da8e17838d22"],

Cell[BoxData["4.63998250154868`"], "Output",
 CellChangeTimes->{
  3.981512982788661*^9, {3.981516143398192*^9, 3.981516185679228*^9}, 
   3.981538523091194*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"3271de88-ed0c-4dd3-a6c0-b892a8e3721f"]
}, Open  ]],

Cell[TextData[StyleBox["Example 4: Van der Pol oscillator ", "Subsection",
 FontFamily->"Times"]], "Text",
 CellChangeTimes->{{3.980306933161154*^9, 3.980306943064569*^9}, {
  3.980859124971703*^9, 3.980859131859919*^9}, {3.981516287455326*^9, 
  3.981516288181703*^9}},ExpressionUUID->"1243990d-7aa8-438c-aac2-\
c3aefec62981"],

Cell["\<\
Not all systems return to equilibrium. The nonlinear dynamics for the Van der \
Pol oscillator is described by \
\>", "Text",
 CellChangeTimes->{{3.980859164739808*^9, 
  3.980859198212555*^9}},ExpressionUUID->"bb5ddc82-9a16-40ac-902b-\
3158787f3dfd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["d", "2"], " ", "x"}], 
     SuperscriptBox["dt", "2"]], "-", 
    RowBox[{
     RowBox[{"\[Mu]", "(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}], 
     FractionBox[
      RowBox[{"d", " ", "x"}], "dt"]}], "+", "x"}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"a6557ee0-904c-4227-a4bb-2fa35d9b99f5"]], \
"Text",
 CellChangeTimes->{{3.9803070346389217`*^9, 3.980307106650503*^9}, {
  3.980859216012348*^9, 3.9808592502982883`*^9}},
 TextAlignment->Center,ExpressionUUID->"857ac12c-b21a-4354-b111-adec62f2ba9d"],

Cell["This can be written as a set of coupled equations: ", "Text",
 CellChangeTimes->{{3.980307108639838*^9, 
  3.980307130746019*^9}},ExpressionUUID->"3faa1c54-88c9-48c4-a11e-\
15f3422beffb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     FractionBox[
      RowBox[{"d", " ", "v"}], "dt"], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]", "(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}], " ", "v"}], " ", "-", "x"}]}]}], 
   TraditionalForm]],ExpressionUUID->"ff86bdfe-769e-44e4-b4fc-4b26b3267444"],
 " ,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    FractionBox[
     RowBox[{"d", " ", "x"}], "dt"]}], TraditionalForm]],ExpressionUUID->
  "646d2b02-8aa8-417a-8e71-81e5876c7134"],
 ","
}], "Text",
 CellChangeTimes->{{3.9803071415375834`*^9, 3.980307213728881*^9}, {
  3.980859276632968*^9, 3.980859321657311*^9}},
 TextAlignment->Center,ExpressionUUID->"5b7dbebf-d135-4fc0-be49-2f10cd5b13a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mu", " ", "=", " ", "1.0"}], ";"}]], "Input",
 CellChangeTimes->{{3.9808594418281727`*^9, 3.980859441831295*^9}, {
  3.980860198366146*^9, 3.980860218292657*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"9b61edab-4d47-41af-a40f-253c3b0d583f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "v_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"v", ",", 
     RowBox[{
      RowBox[{"mu", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "^", "2"}]}], ")"}], " ", "v"}], "-", "x"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.980859572256689*^9, 3.9808595877393923`*^9}, {
  3.980859778544526*^9, 3.980859791816822*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"eed15034-ce2f-4bff-a9f6-5a8b552a1018"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", "0"}], "}"}]}], ";", 
  RowBox[{"(*", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", 
      RowBox[{"(", "0", ")"}]}], ",", 
     RowBox[{"v", 
      RowBox[{"(", "0", ")"}]}]}], "}"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.980859489308633*^9, 3.9808595029439*^9}, {
  3.9808596530251827`*^9, 3.9808596618124123`*^9}, {3.9808601819013157`*^9, 
  3.980860182439664*^9}, {3.980860220634487*^9, 3.9808602231485977`*^9}, {
  3.981538892154421*^9, 3.9815388926653423`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"424c4adb-5c19-4637-86be-3a33304b0f54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solRK2", "=", 
   RowBox[{"RK2", "[", 
    RowBox[{"f", ",", "x0", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "50"}], "}"}], ",", "h"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.980859683160708*^9, 3.9808596907208223`*^9}, 
   3.9808597431503487`*^9, 3.9808598734643908`*^9, {3.980860230676105*^9, 
   3.9808602310266438`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"ae7b1fa8-42dd-4168-908a-a55db7068fbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phaseData", "=", 
   RowBox[{"solRK2", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.980859878216259*^9, {3.980859918733182*^9, 3.980859928104177*^9}, {
   3.9815387732669153`*^9, 3.981538778185117*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"c854e169-cc15-4f79-b77f-66d08db2dc7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"phaseData", ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Thick"}], "}"}]}], ",", 
