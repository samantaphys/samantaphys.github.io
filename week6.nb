Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vdp", ",", "solutions", ",", "field"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vdp", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"v", "[", "t", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"mu", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}], " ", 
            RowBox[{"v", "[", "t", "]"}]}], "-", 
           RowBox[{"x", "[", "t", "]"}]}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solutions", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vdp", ",", 
             RowBox[{
              RowBox[{"x", "[", "0", "]"}], "==", 
              RowBox[{"ic", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"v", "[", "0", "]"}], "==", 
              RowBox[{"ic", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], ",", 
             RowBox[{"v", "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ic", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.1", ",", "0.1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"2.5", ",", "2.5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "2.5"}], ",", 
               RowBox[{"-", "0.5"}]}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"field", "=", 
       RowBox[{"StreamPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", ",", 
           RowBox[{
            RowBox[{"mu", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"x", "^", "2"}]}], ")"}], " ", "v"}], "-", "x"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"StreamStyle", "->", 
          RowBox[{"Arrowheads", "[", "0.02", "]"}]}], ",", 
         RowBox[{"StreamColorFunction", "->", "\"\<Rainbow\>\""}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{"field", ",", 
        RowBox[{"ParametricPlot", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", "solutions", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Red", ",", "Blue", ",", "Black"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Position (x)\>\"", ",", "\"\<Velocity (v)\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Phase Space & Limit Cycles\>\"", ",", "14"}], 
          "]"}]}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mu", ",", "1.0", ",", "\"\<Nonlinearity (\[Mu])\>\""}], "}"}], 
     ",", "0.", ",", "4.0"}], "}"}], ",", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.980308501824218*^9, 3.980308510267622*^9}, 
   3.980858985630519*^9, {3.980860735143786*^9, 3.9808607868809767`*^9}, {
