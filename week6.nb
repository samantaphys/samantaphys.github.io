Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "phase", ",", "\[Omega]r", ",", "power"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "[", "\[Omega]_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"F0", "/", "m"}], ")"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Omega]0", "^", "2"}], "-", 
             RowBox[{"\[Omega]", "^", "2"}]}], ")"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", " ", "\[Gamma]", " ", "\[Omega]"}], ")"}], "^", 
           "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"phase", "[", "\[Omega]_", "]"}], ":=", 
       RowBox[{"Arg", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Omega]0", "^", "2"}], "-", 
           RowBox[{"\[Omega]", "^", "2"}]}], ")"}], "+", 
         RowBox[{"I", " ", "2", " ", "\[Gamma]", " ", "\[Omega]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"\[Omega]r", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Omega]0", "^", "2"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "^", "2"}]}]}], ">", "0"}], ",", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"\[Omega]0", "^", "2"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "^", "2"}]}]}], "]"}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"power", "[", "\[Omega]_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"F0", "^", "2"}], "/", "m"}], ")"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "\[Gamma]", " ", 
           RowBox[{"\[Omega]", "^", "2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Omega]0", "^", "2"}], "-", 
              RowBox[{"\[Omega]", "^", "2"}]}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Gamma]", " ", "\[Omega]"}], ")"}], "^", 
            "2"}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"A", "[", "\[Omega]", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Omega]", ",", "0", ",", 
              RowBox[{"2", " ", "\[Omega]0"}]}], "}"}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<Amplitude\>\""}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Omega]\>\"", ",", "16", ",", "Red"}], "]"}], 
               ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<A(\[Omega])\>\"", ",", "16", ",", "Red"}], 
                "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotStyle", "->", "Thick"}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Dashed", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"\[Omega]r", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"\[Omega]r", ",", "5"}], "}"}]}], "}"}], "]"}]}], 
              "}"}]}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"phase", "[", "\[Omega]", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Omega]", ",", "0", ",", 
              RowBox[{"2", " ", "\[Omega]0"}]}], "}"}], ",", 
            RowBox[{
            "PlotLabel", "->", "\"\<Phase Shift \[Delta](\[Omega])\>\""}], 
            ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Omega]\>\"", ",", "16", ",", "Red"}], "]"}], 
               ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[Delta]\>\"", ",", "16", ",", "Red"}], "]"}]}], 
              "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"0", ",", "Pi"}], "}"}]}], ",", 
            RowBox[{"PlotStyle", "->", "Blue"}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Dashed", ",", "Black", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"2", " ", "\[Omega]0"}], ",", 
                    RowBox[{"Pi", "/", "2"}]}], "}"}]}], "}"}], "]"}]}], 
              "}"}]}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"power", "[", "\[Omega]", "]"}], ",", 
