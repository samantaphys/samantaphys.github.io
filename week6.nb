 CellLabel->
  "Out[123]=",ExpressionUUID->"5141f805-5077-4530-8b9d-32a57843fc02"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]", "=", "0.8"}], ";"}]], "Input",
 CellChangeTimes->{3.98146146136377*^9},
 CellLabel->
  "In[124]:=",ExpressionUUID->"4d6e56f4-40dd-48ac-8b47-b9fcc2e44a35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
        RowBox[{"2", " ", "\[Gamma]", " ", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"\[Omega]0", "^", "2"}], " ", 
         RowBox[{"y", "[", "t", "]"}]}]}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"F0", "/", "m"}], ")"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "y", 
    ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "200"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.979471487607291*^9, {3.9802986639182787`*^9, 3.9802986944675837`*^9}, 
   3.9807839070451803`*^9, {3.981461473738153*^9, 3.9814614749004183`*^9}, {
