            2.5}, {-2.5, -0.5}}}]; $CellContext`field$ = 
         StreamPlot[{$CellContext`v, ($CellContext`mu$$ (
               1 - $CellContext`x^2)) $CellContext`v - $CellContext`x}, \
{$CellContext`x, -3, 3}, {$CellContext`v, -3, 3}, StreamStyle -> 
           Arrowheads[0.02], StreamColorFunction -> "Rainbow"]; 
        Show[$CellContext`field$, 
          ParametricPlot[
           Evaluate[$CellContext`solutions$], {$CellContext`t, 0, 50}, 
           PlotStyle -> {Red, Blue, Black}], 
          FrameLabel -> {"Position (x)", "Velocity (v)"}, PlotLabel -> 
          Style["Phase Space & Limit Cycles", 14]]], 
