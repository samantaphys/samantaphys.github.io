Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]", "=", "0.8"}], ";"}]], "Input",
 CellChangeTimes->{{3.9814762382853317`*^9, 3.9814762431334887`*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"21835460-b6b6-4e88-a018-98b23bcdb0fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "v_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"v", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Gamma]", " ", "v"}], "-", 
      RowBox[{
       RowBox[{"\[Omega]0", "^", "2"}], " ", "x"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"F0", "/", "m"}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}]}], "}"}]}], ";"}]], "Input",\

 CellChangeTimes->{
  3.981475931113549*^9, {3.981475981683514*^9, 3.981475998818165*^9}, {
   3.981476066312001*^9, 3.9814761070910683`*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"9508aee0-4633-43a0-9d8f-9e7317110abf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9814762548231783`*^9, 3.981476265651038*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"46c5de5e-fc27-4471-8730-1fe21e0759cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RK2", "[", 
   RowBox[{"f_", ",", "y0_", ",", 
    RowBox[{"{", 
     RowBox[{"t0_", ",", "tmax_"}], "}"}], ",", "h_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tlist", ",", "ylist", ",", "nsteps", ",", "k1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tlist", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"t0", ",", "tmax", ",", "h"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nsteps", "=", 
      RowBox[{"Length", "[", "tlist", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ylist", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "nsteps"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ylist", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", "y0"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"k1", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"tlist", "[", 
            RowBox[{"[", "n", "]"}], "]"}], ",", 
           RowBox[{"ylist", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ylist", "[", 
          RowBox[{"[", 
           RowBox[{"n", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"ylist", "[", 
           RowBox[{"[", "n", "]"}], "]"}], "+", 
          RowBox[{"h", " ", 
           RowBox[{"f", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"tlist", "[", 
               RowBox[{"[", "n", "]"}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{"h", "/", "2"}], ")"}]}], ",", 
             RowBox[{
              RowBox[{"ylist", "[", 
               RowBox[{"[", "n", "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"h", "/", "2"}], ")"}], " ", "k1"}]}]}], "]"}]}]}]}], 
        ";"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"nsteps", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", "ylist"}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
