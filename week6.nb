Cell["", "Text",
 CellChangeTimes->{{3.981462872395866*^9, 
  3.981462874708503*^9}},ExpressionUUID->"2d9baa72-76bf-4b6a-a542-\
e6273e4867b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\[Omega]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.981462926999709*^9, 3.981462942144302*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"c6b0e6db-14f4-459d-af5a-f13a10b0eeb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amplitude", "[", "\[Omega]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sol", ",", "steady", ",", "tvals"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
            RowBox[{"2", " ", "\[Gamma]", " ", 
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
            RowBox[{
             RowBox[{"\[Omega]0", "^", "2"}], " ", 
             RowBox[{"y", "[", "t", "]"}]}]}], "==", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"F0", "/", "m"}], ")"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
        "\[IndentingNewLine]", "y", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "200"}], "}"}]}], "\[IndentingNewLine]", 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"steady", "=", 
      RowBox[{"y", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tvals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"150", ",", "200", ",", "0.1"}], "]"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"only", " ", "steady"}], "-", 
       RowBox[{"state", " ", "oscillation"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"steady", "/@", "tvals"}], "]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.981461698332292*^9, 3.9814617186290483`*^9}, {
   3.98146176067251*^9, 3.981461761668849*^9}, 3.981461806947523*^9, {
   3.981461853502453*^9, 3.9814619168858547`*^9}, {3.981462357735257*^9, 
   3.9814623870428257`*^9}, {3.981534479672284*^9, 3.981534510732521*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"57c746c3-ce74-47d0-9480-3d8504bac4dd"],

Cell[TextData[{
 StyleBox["steady/@tvals", "Code"],
 " : gives the numerical value of the solution at time ",
 Cell[BoxData[
  FormBox["tvals", TraditionalForm]], "Code",
  FormatType->TraditionalForm,ExpressionUUID->
  "dc7352d5-776c-4be9-ad76-5c86ed3d0e09"],
 " ."
}], "Text",
 CellChangeTimes->{{3.981462287882193*^9, 
  3.981462326692111*^9}},ExpressionUUID->"c35254d8-c024-47f5-b52c-\
a85b9bf990a2"],

Cell["The steady-state solution of the form:  \
x(t)\[TildeTilde]A(\[Omega])cos(\[Omega]t\[Minus]\[Delta]) .", "Text",
 CellChangeTimes->{{3.9814625283764772`*^9, 
  3.981462563803055*^9}},ExpressionUUID->"0d10475b-fbff-4038-9910-\
fe777fd6b203"],

Cell["\<\
For each driving frequency \[Omega] , A(\[Omega]) = maximum steady-state \
displacement .\
\>", "Text",
 CellChangeTimes->{{3.981462621796259*^9, 
  3.9814626402814903`*^9}},ExpressionUUID->"d04bc751-4e2b-40fa-b719-\
18cccae6f583"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"A", 
    RowBox[{"(", "\[Omega]", ")"}]}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["F", "0"], "/", "m"}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[Omega]", "0"], "2"], "-", 
         SuperscriptBox["\[Omega]", "2"]}], ")"}], "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "\[Gamma]", " ", "\[Omega]"}], ")"}], "2"]}]]]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{3.981462773432008*^9},
 TextAlignment->Center,ExpressionUUID->"c5216819-a71d-4aa6-adda-94d6ba27c42e"],

Cell["", "Text",
 CellChangeTimes->{{3.981462682486052*^9, 
  3.981462766027399*^9}},ExpressionUUID->"e20cf164-aeac-4339-9373-\
d38bf059d1d5"],

