Cell[TextData[StyleBox["Example 2: A harmonic oscillator is subjected to an \
external force.", "Subsection"]], "Text",
 CellChangeTimes->{{3.9815116924609213`*^9, 
  3.981511715523391*^9}},ExpressionUUID->"538a1a7c-8990-4f9e-a19d-\
515ef12663b6"],

Cell[TextData[{
 "The non-dimensionalized differential equation for a harmonic oscillator \
driven by a force proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77304cc5-472c-4c37-8dfd-50a44dd91d06"],
 ":"
}], "Text",
 CellChangeTimes->{{3.98151162683121*^9, 
  3.981511639536787*^9}},ExpressionUUID->"afd9e0ad-be75-42ff-afc9-\
ba514422a0bb"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "2"], 
      StyleBox["x", "TI"]}], 
     RowBox[{
      StyleBox["d", "TI"], 
      SuperscriptBox[
       StyleBox["t", "TI"], "2"]}]], "+", 
    StyleBox["x", "TI"]}], "\[LongEqual]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "3"]}], 
  TraditionalForm]],ExpressionUUID->"e411b0b0-c1fb-4f57-8933-ba5464da7b48"]], \
"Text",
 CellChangeTimes->{{3.981511652665635*^9, 3.981511672475637*^9}},
 TextAlignment->Center,ExpressionUUID->"75df27a0-eaa8-41d5-8393-55a481b81c50"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"t_", ",", "x1_", ",", "x2_"}], "]"}], ":=", "x2"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", 
    RowBox[{"t_", ",", "x1_", ",", "x2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "x1"}], "+", 
    RowBox[{"t", "^", "3"}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tmax", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nMax", "=", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"tmax", "-", "t0"}], ")"}], "/", "nMax"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", "t0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x1", "=", "0"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"x", 
    RowBox[{"(", "t0", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x2", "=", "0"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"x", "'"}], 
    RowBox[{"(", "t0", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k1x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{"t", ",", "x1", ",", "x2"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k1x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{"t", ",", "x1", ",", "x2"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k2x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k1x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k1x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k2x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k1x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k1x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k3x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k2x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k2x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"k3x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"x1", "+", 
         RowBox[{"k2x1", "/", "2"}]}], ",", 
        RowBox[{"x2", "+", 
         RowBox[{"k2x2", "/", "2"}]}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"k4x1", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f1", "[", 
       RowBox[{
        RowBox[{"t", "+", "h"}], ",", 
        RowBox[{"x1", "+", "k3x1"}], ",", 
        RowBox[{"x2", "+", "k3x2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"k4x2", "=", 
     RowBox[{"h", " ", 
      RowBox[{"f2", "[", 
       RowBox[{
        RowBox[{"t", "+", "h"}], ",", 
        RowBox[{"x1", "+", "k3x1"}], ",", 
        RowBox[{"x2", "+", "k3x2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"x1", "=", 
     RowBox[{"x1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1x1", "+", 
         RowBox[{"2", " ", "k2x1"}], "+", 
         RowBox[{"2", " ", "k3x1"}], "+", "k4x1"}], ")"}], "/", "6"}]}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"x2", "=", 
     RowBox[{"x2", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k1x2", "+", 
         RowBox[{"2", " ", "k2x2"}], "+", 
         RowBox[{"2", " ", "k3x2"}], "+", "k4x2"}], ")"}], "/", "6"}]}]}], 
    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"t", "=", 
     RowBox[{"t", "+", "h"}]}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", "nMax", "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.981510604808936*^9, 3.981510707414874*^9}, 
   3.981510859887515*^9},
 CellLabel->
  "In[171]:=",ExpressionUUID->"ee57fdf4-9479-46d1-a466-d79b82389c39"],

