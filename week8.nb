Cell["The central moment only measures the \[OpenCurlyDoubleQuote]Spread\
\[CloseCurlyDoubleQuote].", "Text",
 CellChangeTimes->{{3.9825561246359587`*^9, 
  3.9825561359948072`*^9}},ExpressionUUID->"f5a8cd89-20cd-4a26-a62d-\
d86345a875f9"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s given the probability density function (PDF) for a \
single step ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$x$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d7ad50a-b279-42e7-9744-d3bc38e87e64"],
 " is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "2", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-2", 
            StyleBox["x", "TI"]}]], ",  ", 
         StyleBox["x", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$P(x) = 2e^{-2x}, \\quad x \\geq 0$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e74fe660-3243-442f-be4f-8a51a3f41343"],
 "\n=> This is a standard Exponential Distribution with rate parameter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Lambda]", "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\lambda = 2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37ff207c-cf6f-46fb-ac73-aa6653b63511"],
 "."
}], "Text",
 CellChangeTimes->{{3.9825585381172323`*^9, 
  3.9825586223750973`*^9}},ExpressionUUID->"ba1d6d30-0f71-4a82-9c14-\
16f4fa0f28e5"],

Cell[TextData[{
 "The \"spread\" requested is the Standard Deviation of the total distance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["X", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$X$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "653df0a3-f563-4662-977e-c0c9744c4b19"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Spread", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            RowBox[{"\[LeftAngleBracket]", 
              SuperscriptBox[
               StyleBox["X", "TI"], "2"], "\[RightAngleBracket]"}], "-", 
            SuperscriptBox[
             RowBox[{"\[LeftAngleBracket]", 
               StyleBox["X", "TI"], "\[RightAngleBracket]"}], "2"]}]], 
         "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            StyleBox["V", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["r", "TI"], 
            RowBox[{"(", 
              StyleBox["X", "TI"], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\text{Spread} = \\sqrt{\\langle X^2 \\rangle - \\langle X \\rangle^2} \
= \\sqrt{Var(X)}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8efbfbb8-d0ac-44e8-8070-01f17502c735"],
 " ."
}], "Text",
 CellChangeTimes->{{3.982558648508731*^9, 
  3.982558678826741*^9}},ExpressionUUID->"98163343-f604-4909-8b81-\
fb8815ab9ff2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambda", "=", "2"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dist", "=", 
    RowBox[{"ExponentialDistribution", "[", "lambda", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"exponential", " ", "distribution"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Simulate", " ", "10"}], ",", 
    RowBox[{
    "000", " ", "walkers", " ", "taking", " ", "N", " ", "steps", " ", 
     "each"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nwalk", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"samples", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"dist", ",", "n"}], "]"}], "]"}], ",", 
      RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "numerical", " ", "Spread"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numericalSpread", "=", 
   RowBox[{
    RowBox[{"StandardDeviation", "[", "samples", "]"}], "//", "N"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"theoreticalSpread", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "n", "]"}], "/", "lambda"}], "//", "N"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Numerical Spread: \>\"", ",", "numericalSpread"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<Theoretical Spread (\!\(\*SqrtBox[\(N\)]\)/2): \>\"", ",", 
     "theoreticalSpread"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "Visualization", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{
  "samples", ",", "Automatic", ",", "\"\<PDF\>\"", ",", "\[IndentingNewLine]", 
   RowBox[{
   "PlotLabel", "->", "\"\<Distribution of Distance X for N=1000\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Distance X\>\"", ",", "\"\<Density\>\""}], "}"}]}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Thick", ",", "Dashed", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theoreticalSpread", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"theoreticalSpread", ",", "0.05"}], "}"}]}], "}"}], "]"}]}],
      "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.982558703713347*^9, 3.98255879381075*^9}, {
   3.98255886253041*^9, 3.982558929906361*^9}, {3.98255922299651*^9, 
   3.98255922453852*^9}, 3.982559341891774*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"0e5fcf24-d272-44fb-8545-7161d67169fe"],

