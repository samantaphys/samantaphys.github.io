Cell["Now compute how the spread grows with time.", "Text",ExpressionUUID->"4963c36d-8290-40ff-9262-2cc0859ac451"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rms", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"randomWalk", "[", "nsteps", "]"}], ",", "t"}], "]"}], "^", 
        "2"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "10", ",", "nsteps", ",", "10"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9825443129464903`*^9, 3.9825443424213543`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"2d43421a-4c65-4468-b561-10a227ef8008"],

