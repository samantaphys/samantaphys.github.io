Cell[BoxData[{
 RowBox[{
  RowBox[{"nsteps", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"finalpos", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "nsteps"}], "]"}], 
       "]"}], ",", 
      RowBox[{"{", "50", "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"final", " ", "position", " ", "for", " ", "50", " ", "paths"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{
  3.982543793871253*^9, {3.982543931131921*^9, 3.982544064151862*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"ecd199cb-b514-4190-8926-363d9446a511"],

