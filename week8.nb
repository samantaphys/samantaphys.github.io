    0, Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`prob$$ = 0.6}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`nsteps$ = 200, $CellContext`nwalk$ = 
         50, $CellContext`fairPaths$, $CellContext`biasedPaths$, \
$CellContext`fairAvg$, $CellContext`biasedAvg$}, $CellContext`fairPaths$ = 
         Table[
           Accumulate[
            Prepend[
             RandomChoice[{0.5, 0.5} -> {-1, 1}, $CellContext`nsteps$], 
             0]], {$CellContext`nwalk$}]; $CellContext`fairAvg$ = 
         Mean[$CellContext`fairPaths$]; $CellContext`biasedPaths$ = Table[
           Accumulate[
            Prepend[
             
             RandomChoice[{
               1 - $CellContext`prob$$, $CellContext`prob$$} -> {-1, 
               1}, $CellContext`nsteps$], 
             0]], {$CellContext`nwalk$}]; $CellContext`biasedAvg$ = 
         Mean[$CellContext`biasedPaths$]; GraphicsGrid[{{
            ListLinePlot[$CellContext`fairPaths$, PlotStyle -> Directive[
               Opacity[0.2], Blue], Epilog -> {Red, Thick, 
               Line[
                Thread[{
                  Range[0, $CellContext`nsteps$], $CellContext`fairAvg$}]]}, 
             PlotLabel -> "Fair Walk (p=0.5)", Frame -> True, ImageSize -> 
             Medium], 
            ListLinePlot[$CellContext`biasedPaths$, PlotStyle -> Directive[
               Opacity[0.2], Green], Epilog -> {Red, Thick, 
               Line[
                Thread[{
                  Range[0, $CellContext`nsteps$], $CellContext`biasedAvg$}]]},
              PlotLabel -> 
             "Biased Walk (p=" <> ToString[$CellContext`prob$$] <> ")", Frame -> 
             True, ImageSize -> Medium]}}]], 
      "Specifications" :> {{{$CellContext`prob$$, 0.6, 
          "Right-move Probability (p)"}, 0.1, 0.9, 0.05, Appearance -> 
         "Labeled"}}, "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{1031., {211., 219.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
