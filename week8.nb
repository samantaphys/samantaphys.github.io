Cell[TextData[{
 StyleBox["Problem-1:", "Subsubsection"],
 " A random walker walking along the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3430ce6a-d11c-4e4b-9497-9bd99242fea1"],
 "-axis, has a slight bias to move towards the right. At each point, he moves \
to the right with probability ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", "0.65"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p=0.65$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0b67de2-b438-4e4e-9f9c-6bb4d44bf233"],
 " . If he starts at the origin and takes 100 steps, what is the probability \
of finding him at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     StyleBox["x", "TI"],
     TraditionalForm], "=", 
    RowBox[{"50", "?"}]}], TraditionalForm]],ExpressionUUID->
  "89e57399-b3df-4e6c-8544-0a7d88f9de3d"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.982550953609372*^9, 
  3.982551060740981*^9}},ExpressionUUID->"4d912716-5cfc-45e3-ad11-\
c5828c6465f8"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$n_R$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4580f177-d4ea-4151-b906-82f0fe7acb39"],
 " be the number of steps to the right (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "$+1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d4ce297-d6d1-467a-8dbd-3d69661c5fa8"],
 ") and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["L", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$n_L$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f580e20a-e141-454e-b59a-9b1019e3bf2c"],
 " be the number of steps to the left (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-1", TraditionalForm], "errors" -> {}, "input" -> 
     "$-1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fda0f19c-8fef-46aa-b975-bc77ed678686"],
 ")."
}], "Text",
 CellChangeTimes->{{3.982551170495407*^9, 
  3.98255119424964*^9}},ExpressionUUID->"a9d36917-8d9e-4377-aa59-\
d0b4afeb3496"],

Cell[TextData[{
 "Total steps, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["n", "R"], "+", 
      SubscriptBox["n", "L"]}], "=", "100"}]}], TraditionalForm]],
  ExpressionUUID->"45c13e28-1140-4d80-895c-d59e61390159"],
 "."
}], "Text",
 CellChangeTimes->{{3.982551202753755*^9, 
  3.982551233175404*^9}},ExpressionUUID->"7df86aec-6e3f-4fec-89ba-\
2db5f976b2ac"],

Cell[TextData[{
 "Net displacement, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["n", "R"], "-", 
      SubscriptBox["n", "L"]}], "=", "50"}]}], TraditionalForm]],
  ExpressionUUID->"8d3569e5-ebe0-4b7d-85f3-88aa27c23bba"],
 "."
}], "Text",
 CellChangeTimes->{{3.98255123550268*^9, 
  3.982551268150662*^9}},ExpressionUUID->"b2214c7f-a05c-4ddb-849b-\
be59433bbc39"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nsteps", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", "0.65"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nR", "=", "75"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"prob", "=", 
  RowBox[{
   RowBox[{"Binomial", "[", 
    RowBox[{"nsteps", ",", "nR"}], "]"}], "*", 
   RowBox[{"p", "^", "nR"}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "p"}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"nsteps", "-", "nR"}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.982551283617687*^9, 3.982551296534893*^9}, {
  3.98255133727269*^9, 3.982551421559133*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"78f1f084-4c49-4396-8e6a-0c548353462e"],

Cell[BoxData["0.00901465496456041`"], "Output",
 CellChangeTimes->{{3.982551328595039*^9, 3.982551377262497*^9}, 
   3.982551422073923*^9, 3.9827465287231617`*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"2c1db3a7-695e-44b5-9bca-3e573def87fd"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Problem-2:", "Subsubsection"],
 " Calculate the ratio of Stirling\[CloseCurlyQuote]s approximation to the \
exact factorial, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          SqrtBox[
           RowBox[{"2", "\[Pi]", 
             StyleBox["n", "TI"]}]], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["n", "TI"], "/", 
               StyleBox["e", "TI"]}], ")"}], 
           StyleBox["n", "TI"]]}], 
        RowBox[{
          StyleBox["n", "TI"], "!"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\frac{\\sqrt{2\\pi n}(n/e)^n}{n!}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b560f0b-d9f2-4b27-9fe5-d1f16dc6ff54"],
 ", for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "10"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$n=10$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c29ce496-9e71-450d-b985-117562469fd0"],
 ". Then, determine the minimum integer ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$n$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebe66576-5ac6-434b-aa9a-d888f312a915"],
 " required for this ratio to be within ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0.1%", TraditionalForm], "errors" -> {}, "input" -> 
     "$0.1\\%$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6f703c80-9494-446d-a5d1-4ce1ad1acae5"],
 " of unity (i.e., the ratio must be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[GreaterEqual]", "0.999"}], TraditionalForm], "errors" -> {},
      "input" -> "$\\ge 0.999$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "343c24a7-4d02-4976-bd8e-5eff9b99bf82"],
 ")"
}], "Text",
 CellChangeTimes->{{3.9825516980788116`*^9, 
  3.982551783983025*^9}},ExpressionUUID->"0fa22b65-f4df-4f84-aecc-\
2938b4cf8821"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stirling", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "*", "Pi", "*", "n"}], "]"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "/", 
       RowBox[{"Exp", "[", "1", "]"}]}], ")"}], "^", "n"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"actual", "=", 
    RowBox[{"Factorial", "[", "10", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ratio", "=", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"stirling", "/", "actual"}], ",", "20"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9825518053066607`*^9, 3.9825518385636*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"83b16f78-1a2d-4e4f-863a-7a26fcb73885"],

Cell[BoxData["0.99170403955606148633795633069588901706`20."], "Output",
 CellChangeTimes->{3.982551840920087*^9},
 CellLabel->
  "Out[141]=",ExpressionUUID->"6d750151-2e9d-4cc4-a3ed-66b41ad119cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"exact", ",", "approx", ",", "error", ",", "ratio"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"exact", "=", 
       RowBox[{"Factorial", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"approx", "=", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", "*", "Pi", "*", "n"}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "/", "E"}], ")"}], "^", "n"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"error", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"exact", "-", "approx"}], "]"}], "/", "exact"}], "*", 
        "100"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratio", "=", 
       RowBox[{"approx", "/", "exact"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<n\>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Exact Factorial\>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Stirling Approx\>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Ratio\>\"", ",", "Bold"}], "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"n", ",", 
                RowBox[{"ScientificForm", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"exact", ",", "5"}], "]"}], "]"}], ",", 
                RowBox[{"ScientificForm", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"approx", ",", "5"}], "]"}], "]"}], ",", 
                RowBox[{"N", "[", 
                 RowBox[{"ratio", ",", 
                  RowBox[{"{", 
                   RowBox[{"6", ",", "5"}], "}"}]}], "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Frame", "->", "All"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"Background", "->", 
             RowBox[{"{", 
              RowBox[{"None", ",", 
               RowBox[{"{", 
                RowBox[{"Lighter", "[", 
                 RowBox[{"Gray", ",", "0.9"}], "]"}], "}"}]}], "}"}]}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ",", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"2", "*", "Pi", "*", "x"}], "]"}], "*", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "/", "E"}], ")"}], "^", "x"}], "/", 
              RowBox[{"Gamma", "[", 
               RowBox[{"x", "+", "1"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "1", ",", "100"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"0.9", ",", "1.05"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"GridLines", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "}"}], ",", 
               RowBox[{"{", "1", "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Darker", "[", "Green", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", "400"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"n", ",", "ratio"}], "}"}], "]"}]}], "}"}]}]}], 
           "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "10", ",", "\"\<Value of n\>\""}], "}"}], ",", "1", 
     ",", "100", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.982551863809206*^9, 3.982551950449257*^9}, 
   3.982551983189538*^9, {3.982552013294355*^9, 3.98255202434149*^9}, 
   3.98255215415699*^9, 3.9825522322464523`*^9, {3.982552294794421*^9, 
   3.982552403061863*^9}, {3.9825524729096193`*^9, 3.982552612336647*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"4deaa144-dc87-4275-b2e8-b935ac1c7f85"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`n$$ = 100, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
