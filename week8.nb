Cell[TextData[{
 "This is the RMS of one path, it won't consistently show the ",
 Cell[BoxData[
  FormBox[
   SqrtBox["t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24d4770a-b72e-477d-b02c-a75a746f3361"],
 " scaling because a single walker might just happen to stay near the origin \
or drift far away by pure luck. To see the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["t"], " ", "behavior"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a7e3c1b-0685-4b95-9d72-42f09b3a4d74"],
 ", you need to average over many different walkers, i.e., the RMS of all \
their positions at each time step ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "125c4711-e3cd-4e54-90ff-b33a003194c9"],
 "."
}], "Text",
 CellChangeTimes->{{3.982546067027792*^9, 3.982546118147181*^9}, {
  3.982548802962541*^9, 3.982548803445265*^9}, {3.9825488343071117`*^9, 
  3.982548847156568*^9}},ExpressionUUID->"3453d62d-8704-4ffd-a0c4-\
21c4af293dc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nsteps", "=", "500"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nwalk", "=", "1000"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ensemble", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"randomWalk", "[", "nsteps", "]"}], ",", 
     RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Generate", " ", "an", " ", 
     RowBox[{"ensemble", ":", 
      RowBox[{"rows", " ", "are", " ", "walkers"}]}]}], ",", 
    RowBox[{"columns", " ", "are", " ", "time", " ", "steps"}]}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"timeSlices", "=", 
   RowBox[{"Transpose", "[", "ensemble", "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{
   "Transpose", " ", "to", " ", "look", " ", "at", " ", "all", " ", "walkers",
     " ", "at", " ", "each", " ", "specific", " ", "time", " ", "t"}], "*)"}],
   "\n", "\[IndentingNewLine]", 
  RowBox[{"avg", "=", 
   RowBox[{"Mean", "/@", "timeSlices"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rms", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mean", "[", 
       RowBox[{"#", "^", "2"}], "]"}], "&"}], "/@", "timeSlices"}], "]"}]}], 
  ";", " ", 
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "Average", " ", "and", " ", "RMS", " ", "for", " ", 
    "each", " ", "time", " ", "point"}], "*)"}], "\n", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{"Visualize", " ", "both"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"avg", ",", "rms", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "10", ",", "nsteps", ",", "1"}], "}"}]}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Average Position\>\"", ",", "\"\<RMS Displacement\>\"", ",", 
       "\"\<\!\(\*SqrtBox[\(t\)]\)\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Red"}], "]"}], ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Blue"}], "]"}], ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Black"}], "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Time (t)\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "PlotLabel", "->", "\"\<Statistical Evolution of 1D Random Walk\>\""}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{
  3.9825453899781647`*^9, {3.982545466219233*^9, 3.982545616994493*^9}, {
   3.982545661078117*^9, 3.9825456699672413`*^9}, {3.982545707088387*^9, 
