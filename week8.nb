 CellLabel->"Out[18]=",ExpressionUUID->"f8a97f90-391b-4b92-886f-38f740ed7d72"]
}, Open  ]],

Cell[TextData[{
 "Generate an ensemble of unbiased random walks for a range of steps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["N", "TI"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{"50", ",", "100", ",", "200", ",", "500", ",", "1000"}], "}"}]}],
    TraditionalForm]],ExpressionUUID->
  "680fa528-1b09-4aa9-87c7-ba571d3d3600"],
 ". For each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5392bdc-bf53-4cac-b28b-4fdf1082d6a2"],
 ", calculate the ratio: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[LeftAngleBracket]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "4"], "\[RightAngleBracket]"}], 
          SuperscriptBox[
           RowBox[{"\[LeftAngleBracket]", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], "\[RightAngleBracket]"}], "2"]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\kappa = \\frac{\\langle m^4 \\rangle}{\\langle m^2 \\rangle^2}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9db4d553-c850-4e6c-81af-f3392294db86"],
 ".\n\nUsing Mathematica, plot this ratio ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
     "$\\kappa$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4daaedcc-4390-4cf3-b25c-59a008dc1d41"],
 " against ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b181d65-9b65-471f-82bb-7612162af998"],
 ". What value does the ratio approach as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dcc4a352-12c7-454b-ace6-b18933d8fd49"],
 " becomes large, and what does this tell us about the shape of the random \
walk's distribution?"
}], "Text",
 CellChangeTimes->{{3.982554436979088*^9, 3.982554498081635*^9}, {
  3.982554655651621*^9, 
  3.982554659268858*^9}},ExpressionUUID->"7ee859a6-2aff-462a-944e-\
982800d883c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nList", "=", 
    RowBox[{"{", 
     RowBox[{"50", ",", "100", ",", "200", ",", "500", ",", "1000"}], "}"}]}],
    ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"create", " ", "a", " ", "list", " ", "for", " ", "N"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nwalk", "=", "10000"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Large", " ", "ensemble"}], "*)"}], "\n"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"ratio", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"endpoints", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Last", "[", 
           RowBox[{"Accumulate", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}], 
            "]"}], "]"}], ",", 
          RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"m2", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"endpoints", "^", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m4", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"endpoints", "^", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"m4", "/", 
          RowBox[{"(", 
           RowBox[{"m2", "^", "2"}], ")"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nList"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "Ratio", " ", "for", " ", "each", " ", "N"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ratio", ",", 
   RowBox[{"Mesh", "->", "All"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"2.5", ",", "3.5"}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "3", "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", 
      RowBox[{"Darker", "[", "Cyan", "]"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Number of Steps (N)\>\"", ",", "\"\<Ratio <m^4> / <m^2>^2\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Convergence of ratios\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.982554516022855*^9, 3.9825546002209806`*^9}, {
  3.982554662926383*^9, 3.982554743950877*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"25481894-f80e-4579-bee2-569c72c45010"],

