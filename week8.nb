Cell["\<\
Note that the green line stays below 1.0. This tells us Stirling's \
approximation always slightly underestimates the factorial.\
\>", "Text",
 CellChangeTimes->{{3.982553585841688*^9, 
  3.982553589958853*^9}},ExpressionUUID->"54236025-6a13-499e-a362-\
166592e73968"],

Cell[TextData[StyleBox["Problem-3: ", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.982553540445663*^9, 3.982553540744956*^9}, {
  3.982553788659047*^9, 3.982553789153709*^9}, {3.982554186823476*^9, 
  3.982554197384197*^9}},ExpressionUUID->"bbc9b6cf-de3d-467d-8afc-\
699a4502f9b0"],

Cell[TextData[{
 "For an unbiased random walk, the mean square displacement scales linearly \
with the number of steps: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], "\[RightAngleBracket]"}], 
         "\[Proportional]", 
         SuperscriptBox[
          StyleBox["N", "TI"], "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\langle m^2 \\rangle \\propto N^1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6a09ead-4c02-40fb-bba2-67589aefa6d5"],
 ". We now, investigate the scaling behavior of the fourth moment, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftAngleBracket]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "4"], "\[RightAngleBracket]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\langle m^4 \\rangle$",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2242bd24-5778-4d0c-959e-0858f5c02f02"],
 "."
}], "Text",
 CellChangeTimes->{{3.982554213769902*^9, 3.9825542496933737`*^9}, {
  3.9825542815870953`*^9, 
  3.9825543298934603`*^9}},ExpressionUUID->"d0696cdc-cc17-4eab-a5ec-\
bf4c4528eb7c"],

Cell["", "Text",
 CellChangeTimes->{{3.982554007755015*^9, 
  3.9825540092002983`*^9}},ExpressionUUID->"3a7a0867-184e-4c21-b055-\
daf9ca64dc7f"],

Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.982554013311511*^9, 3.982554014540958*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"e3b6f309-3b48-41b5-89ff-281b80f093f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"steps", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"100", ",", "1000", ",", "100"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nwalk", "=", "5000"}], 
   RowBox[{"(*", 
    RowBox[{"Large", " ", "ensemble"}], "*)"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m4Data", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"endpoints", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Last", "[", 
           RowBox[{"Accumulate", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}], 
            "]"}], "]"}], ",", 
          RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"Mean", "[", 
          RowBox[{"endpoints", "^", "4"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "steps"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nlm", "=", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"m4Data", ",", 
      RowBox[{"a", "*", 
       RowBox[{"x", "^", "b"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"power", "-", 
    RowBox[{"law", " ", "fit"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resultB", "=", 
    RowBox[{"b", "/.", " ", 
     RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
