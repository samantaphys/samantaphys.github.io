Cell["\<\
Average position of the walker stays at the origin (both +1 and -1 step have \
equal probability), even after many steps.\
\>", "Text",
 CellChangeTimes->{{3.982543462607288*^9, 
  3.9825435068448143`*^9}},ExpressionUUID->"dd1b1a31-36a7-4b34-a202-\
7c599994e004"],

Cell[TextData[{
 "Since all the steps are independent, the variance is ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "e9ed0b4a-8d9e-48be-9135-6ded8254c780"],
 " and the standard deviation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "=", 
    RowBox[{
     SqrtBox["n"], "."}]}], TraditionalForm]],ExpressionUUID->
  "746f5d6c-cec7-4657-8995-2890ee5c02a3"]
}], "Text",
 CellChangeTimes->{{3.982543547369247*^9, 
  3.982543618456204*^9}},ExpressionUUID->"816f1643-eb09-4cb6-8033-\
93796a5a34dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"paths", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"randomWalk", "[", "1000", "]"}], ",", 
     RowBox[{"{", "50", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{"Visualize", " ", "50", " ", "paths", " ", "simultaneously"}], 
   "*)"}], "\n", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{"paths", ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Blue"}], "]"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Ensemble of 50 Random Walks\>\""}]}], 
   "]"}]}]], "Input",
