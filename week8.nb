     15.954589770191003`, RotateLabel -> 0], 
    Charting`ScaledTicks[{Log, Exp}, {Log, Exp}, "Nice", WorkingPrecision -> 
     15.954589770191003`, RotateLabel -> 0]}]], "Output",
 CellChangeTimes->{{3.9825539762422647`*^9, 3.98255398823081*^9}, {
   3.982554020272519*^9, 3.9825540447347383`*^9}, {3.982554127975831*^9, 
   3.982554153443729*^9}, 3.9825549360126123`*^9, {3.982747472992141*^9, 
