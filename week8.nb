      Module[{$CellContext`exact$, $CellContext`approx$, $CellContext`error$, \
$CellContext`ratio$}, $CellContext`exact$ = 
         Factorial[$CellContext`n$$]; $CellContext`approx$ = 
         Sqrt[2 Pi $CellContext`n$$] ($CellContext`n$$/
            E)^$CellContext`n$$; $CellContext`error$ = (
           Abs[$CellContext`exact$ - \
$CellContext`approx$]/$CellContext`exact$) 
          100; $CellContext`ratio$ = $CellContext`approx$/$CellContext`exact$; 
        Column[{
           Grid[{{
              Style["n", Bold], 
              Style["Exact Factorial", Bold], 
              Style["Stirling Approx", Bold], 
              Style["Ratio", Bold]}, {$CellContext`n$$, 
              ScientificForm[
               N[$CellContext`exact$, 5]], 
              ScientificForm[
               N[$CellContext`approx$, 5]], 
              N[$CellContext`ratio$, {6, 5}]}}, Frame -> All, 
            Spacings -> {2, 1}, Background -> {None, {
               Lighter[Gray, 0.9]}}], 
           Spacer[10], 
           Plot[
           Sqrt[2 Pi $CellContext`x] (($CellContext`x/E)^$CellContext`x/
             Gamma[$CellContext`x + 1]), {$CellContext`x, 1, 100}, 
            PlotRange -> {0.9, 1.05}, Frame -> True, GridLines -> {{}, {1}}, 
            PlotStyle -> Darker[Green], ImageSize -> 400, Epilog -> {Red, 
              PointSize[Medium], 
              Point[{$CellContext`n$$, $CellContext`ratio$}]}]}, Alignment -> 
          Center]], 
      "Specifications" :> {{{$CellContext`n$$, 10, "Value of n"}, 1, 100, 1, 
         Appearance -> "Labeled"}}, "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{678., {281., 289.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
