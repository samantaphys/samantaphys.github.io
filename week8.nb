Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}],
    ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"x", "=", 
    RowBox[{"{", 
     RowBox[{"x1", ",", "x2", ",", "x3", ",", "..."}], "}"}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "=", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "0.1", ",", "0.3", ",", "0.6", ",", "1.0", ",", "1.5"}], 
     "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"y", "=", 
    RowBox[{"{", 
     RowBox[{"y1", ",", "y2", ",", "y3", ",", "..."}], "}"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Thread", "[", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], "]"}], 
  RowBox[{"(*", " ", 
   RowBox[{"return", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "y1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x2", ",", "y2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x3", ",", "y3"}], "}"}], ",", "..."}], "}"}]}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.982549502301457*^9, 3.982549593277985*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"21756024-5487-4135-8f54-9108e9ae5f0a"],

