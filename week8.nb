Cell[TextData[StyleBox["In this tutorial, we discuss random walks using \
Mathematica. A random walk is  a stochastic/random process -- describes a \
path consisting of successive random steps.",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978154735010868*^9, 3.978154791048909*^9}, 
   3.978155696134118*^9, {3.9789601022451677`*^9, 3.97896011256898*^9}, {
   3.97896015079508*^9, 3.978960160357774*^9}, {3.978960241220355*^9, 
   3.9789602415653667`*^9}, {3.9794709209781847`*^9, 3.97947097278484*^9}, {
   3.982028260930374*^9, 3.982028276733375*^9}, {3.982542124560158*^9, 
   3.9825421547050037`*^9}, {3.982542355414287*^9, 3.982542434975643*^9}, {
   3.982542466510014*^9, 3.982542506962129*^9}},
 FontSize->14,ExpressionUUID->"fb58e92b-222e-4ad7-a3a5-253cfc0f6d29"],

