   3.982552025246539*^9, 3.982552155598477*^9, 3.982552233218254*^9, {
   3.9825524117231894`*^9, 3.982552417011612*^9}, 3.982552502451252*^9, 
   3.9825525413963013`*^9, 3.9825526271692677`*^9, 3.9827469705138693`*^9, 
