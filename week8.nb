Cell["\<\
In practice, we use the \[OpenCurlyDoubleQuote]PDF\[CloseCurlyDoubleQuote] \
(Probability Density Function) such that the total area of the bars sums to 1.\
\>", "Text",
 CellChangeTimes->{{3.982550635371149*^9, 
  3.9825506755871353`*^9}},ExpressionUUID->"5d02c874-d8d7-43ef-a8a8-\
19a2f24bc56d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Theoretical", " ", "Gaussian", " ", "curve", " ", "with", " ", "Mean"}], 
    "=", 
    RowBox[{
     RowBox[{"0", " ", "and", " ", "StdDev"}], "=", 
     SqrtBox["n"]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gaussCurve", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Sqrt", "[", "1000", "]"}]}], "]"}], ",", "x"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Min", "[", "endpoints", "]"}], ",", 
         RowBox[{"Max", "[", "endpoints", "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Gaussian Fit\>\"", "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"hist", ",", "gaussCurve"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.982550353322139*^9, 3.98255042964128*^9}, {
