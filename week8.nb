Cell["\<\
This ratio converge to 3. This is the definition of the Kurtosis of a normal \
distribution.\
\>", "Text",
 CellChangeTimes->{{3.982554915575328*^9, 
  3.9825549202499037`*^9}},ExpressionUUID->"3f02680d-95ca-4f84-871e-\
e83f000284cc"],

Cell[TextData[{
 "As ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c11ac4b0-e712-4079-bd30-0452c1d7aec1"],
 " increases, the Central Limit Theorem (CLT) ensures the discrete binomial \
distribution of the random walk transforms into a Gaussian Distribution."
}], "Text",
 CellChangeTimes->{{3.982554818667901*^9, 
  3.982554861184362*^9}},ExpressionUUID->"aa115ea7-3317-4d21-b679-\
8c1d1c0a08ef"],

Cell[TextData[{
 "For a Gaussian distribution (which the random walk approaches via the CLT), \
the moments are related. If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["X", "TI"], "\[Tilde]", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           RowBox[{"0", ",", "\[Sigma]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$X \\sim N(0, \\sigma)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "565683d0-cbbf-484f-931a-c5885b3aad47"],
 ", then:"
}], "Text",
 CellChangeTimes->{
  3.982555181204193*^9},ExpressionUUID->"3f95fb8e-0a60-4c72-91b0-\
b98f47fdc7fc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           SuperscriptBox[
            StyleBox["X", "TI"], "2"], "\[RightAngleBracket]"}], 
         "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\langle X^2 \\rangle = \\sigma^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5667ad32-bf3e-4f9a-b59e-4b49c221c2b6"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           SuperscriptBox[
            StyleBox["X", "TI"], "4"], "\[RightAngleBracket]"}], 
         "\[LongEqual]", "3", 
         SuperscriptBox["\[Sigma]", "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\langle X^4 \\rangle = 3\\sigma^4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "047f516c-639d-4a4b-83cf-4d825a42bfa7"]
}], "Text",
 CellChangeTimes->{{3.9825551972115383`*^9, 
  3.982555208616983*^9}},ExpressionUUID->"b1ee25b2-45be-4d23-9655-\
0356cb219cd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Kappa]", "\[LongEqual]", 
    FractionBox[
     RowBox[{"\[LeftAngleBracket]", 
      SuperscriptBox[
       StyleBox["m", "TI"], "4"], "\[RightAngleBracket]"}], 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], "\[RightAngleBracket]"}], "2"]]}], "=", 
   "3.0"}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.982555345186447*^9, 
  3.98255535417688*^9}},ExpressionUUID->"1bf5e6cb-ef2f-46f3-a2b4-\
6b7cac807406"],

Cell["\<\
Next, we discuss the kurtosis of a biased walk , which helps us to understand \
how the symmetry of a distribution (or lack thereof) affects higher-order \
moments.\
\>", "Text",
 CellChangeTimes->{{3.982555428778303*^9, 
  3.982555454480423*^9}},ExpressionUUID->"3e406ea0-b145-41bc-ac76-\
5bc2f8aa649e"],

Cell[TextData[{
 "In the unbiased case (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", "0.5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p=0.5$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7612b73f-71b9-4b91-8776-671f1573c731"],
 "), we saw the ratio ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", 
         RowBox[{"\[LeftAngleBracket]", 
           SuperscriptBox[
            StyleBox["m", "TI"], "4"], "\[RightAngleBracket]"}], "/", 
         SuperscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], "\[RightAngleBracket]"}], "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\kappa = \\langle m^4 \\rangle / \\langle m^2 \\rangle^2$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7de3794c-6646-4778-8c08-6f5ffb00e63e"],
 " converge to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["3", TraditionalForm], "errors" -> {}, "input" -> 
     "$3$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ae88909-fa0a-47cc-a997-d21b9d94cfc8"],
 ". Now, we introduce a strong bias (e.g., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", "0.8"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p = 0.8$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0fb544d-44d7-4c90-afd6-df86ce8c6e3c"],
 ")."
}], "Text",
 CellChangeTimes->{{3.982555499040537*^9, 
  3.982555528607429*^9}},ExpressionUUID->"0089ac9e-37bd-49f4-9bf6-\
2991a022f7db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nList", "=", 
   RowBox[{"{", 
    RowBox[{"100", ",", "200", ",", "500", ",", "1000"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"nwalk", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", "0.8"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Strong", " ", "Bias"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratio", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"endpoints", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Last", "[", 
           RowBox[{"Accumulate", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "-", "p"}], ",", "p"}], "}"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", "n"}], "]"}], 
            "]"}], "]"}], ",", 
          RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"m2", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"endpoints", "^", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m4", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"endpoints", "^", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"m4", "/", 
          RowBox[{"(", 
           RowBox[{"m2", "^", "2"}], ")"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nList"}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Moment", " ", "Ratio", " ", "for", " ", "Biased", " ", "Walk"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ratio", ",", 
   RowBox[{"Mesh", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Number of Steps (N)\>\"", ",", 
      "\"\<Moment Ratio <m^4> / <m^2>^2\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<The 'Drift' Effect: Moment Ratio for p=0.8\>\""}]}], "]"}]}], "Input",\

 CellChangeTimes->{{3.982555560811957*^9, 3.982555642821721*^9}, {
  3.982738074754766*^9, 3.9827380948182793`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"6b9d6651-cc79-4dd1-9b45-52380032bb11"],

Cell[BoxData[
 GraphicsBox[{{}, 
   GraphicsComplexBox[{{100., 1.0680682356784579`}, {200., 
    1.0347824017684157`}, {500., 1.0139491190740477`}, {1000., 
    1.0070339083974298`}, {100., 1.0680682356784579`}, {200., 
    1.0347824017684157`}, {500., 1.0139491190740477`}, {1000., 
    1.0070339083974298`}}, {{{}, {}, 
      {RGBColor[1, 0, 0], PointSize[
        NCache[
         Rational[7, 360], 0.019444444444444445`]], Thickness[Large], 
       StyleBox[LineBox[{1, 2, 3, 4}],
        FontFamily->"Baskerville"]}}, {
      {RGBColor[1, 0, 0], PointSize[
        NCache[
         Rational[7, 360], 0.019444444444444445`]], Thickness[Large], 
       StyleBox[PointBox[{1, 2, 3, 4}],
        FontFamily->"Baskerville"]}, {}}}], {{}, {}}},
  AspectRatio->NCache[GoldenRatio^(-1), 0.6180339887498948],
  Axes->{True, True},
  AxesLabel->{None, None},
  AxesOrigin->{0, 1.003643112437375},
  BaseStyle->{FontFamily -> "Baskerville"},
  DisplayFunction->Identity,
  Frame->{{True, True}, {True, True}},
  FrameLabel->{{
     FormBox["\"Moment Ratio <m^4> / <m^2>^2\"", TraditionalForm], None}, {
     FormBox["\"Number of Steps (N)\"", TraditionalForm], None}},
  FrameTicks->{{Automatic, Automatic}, {Automatic, Automatic}},
  GridLines->{None, None},
  GridLinesStyle->Directive[
    GrayLevel[0.5, 0.4]],
  LabelStyle->{FontFamily -> "Baskerville"},
  Method->{
   "OptimizePlotMarkers" -> True, "OptimizePlotMarkers" -> True, 
    "CoordinatesToolOptions" -> {"DisplayFunction" -> ({
        Identity[
         Part[#, 1]], 
        Identity[
         Part[#, 2]]}& ), "CopiedValueFunction" -> ({
        Identity[
         Part[#, 1]], 
        Identity[
         Part[#, 2]]}& )}},
  PlotLabel->FormBox[
   "\"The 'Drift' Effect: Moment Ratio for p=0.8\"", TraditionalForm],
  PlotRange->{{0, 1000.}, {1.003643112437375, 1.0680682356784579`}},
  PlotRangeClipping->True,
  PlotRangePadding->{{
     Scaled[0.02], 
     Scaled[0.02]}, {
     Scaled[0.05], 
     Scaled[0.05]}},
  Ticks->{Automatic, Automatic}]], "Output",
 CellChangeTimes->{{3.982555624930291*^9, 3.982555645448635*^9}, 
   3.982738083943404*^9, 3.9827478797702103`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"a736bdf5-af31-437c-a909-4d9e51f08cc2"]
}, Open  ]],

Cell["We see that the ratio converges to ~1, not 3.", "Text",
 CellChangeTimes->{{3.982555675984313*^9, 
  3.982555698060809*^9}},ExpressionUUID->"e5b7f764-1749-44f8-8dfd-\
07b2c0b17e2a"],

Cell[TextData[{
 "This is because, in a biased walk, the displacement is dominated by the \
drift (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[TildeTilde]", 
         StyleBox["v", "TI"], "\[CenterDot]", 
         StyleBox["N", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$m \\approx v \\cdot N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5e2d796a-a3ec-4cf9-a329-8baf2ba3d91e"],
 ")."
}], "Text",
 CellChangeTimes->{{3.982555767942678*^9, 
  3.982555797240427*^9}},ExpressionUUID->"318fd26f-9579-4307-b2bc-\
65769f64beff"],

Cell[TextData[{
 "To get the value of 3, we must use Central Moments:\n                       \
                        ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", 
          StyleBox["c", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[LeftAngleBracket]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["m", "TI"], "-", 
                 RowBox[{"\[LeftAngleBracket]", 
                   StyleBox["m", "TI"], "\[RightAngleBracket]"}]}], ")"}], 
             "4"], "\[RightAngleBracket]"}], 
          SuperscriptBox[
           RowBox[{"\[LeftAngleBracket]", 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["m", "TI"], "-", 
                  RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["m", "TI"], "\[RightAngleBracket]"}]}], ")"}], 
              "2"], "\[RightAngleBracket]"}], "2"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\kappa_{c} = \\frac{\\langle (m - \\langle m \\rangle)^4 \
\\rangle}{\\langle (m - \\langle m \\rangle)^2 \\rangle^2}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  TextAlignment->Center,ExpressionUUID->"c5196699-0664-438a-b689-62ed73a505b6"]
}], "Text",
 CellChangeTimes->{{3.982555808547065*^9, 
  3.9825558754954643`*^9}},ExpressionUUID->"826ceddf-b599-4a0d-9689-\
27ca4ddbba3e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nList", "=", 
   RowBox[{"{", 
    RowBox[{
    "10", ",", "50", ",", "100", ",", "200", ",", "500", ",", "1000"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nwalk", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", "0.8"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ratio", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"endpoints", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Last", "[", 
           RowBox[{"Accumulate", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "-", "p"}], ",", "p"}], "}"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", "n"}], "]"}], 
            "]"}], "]"}], ",", 
          RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"cm2", "=", 
        RowBox[{"CentralMoment", "[", 
         RowBox[{"endpoints", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cm4", "=", 
        RowBox[{"CentralMoment", "[", 
         RowBox[{"endpoints", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"cm4", "/", 
          RowBox[{"(", 
           RowBox[{"cm2", "^", "2"}], ")"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "nList"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"calculate", " ", "central", " ", "moment", " ", "ratio"}], "*)"}],
   "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ratio", ",", 
   RowBox[{"Mesh", "->", "All"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"2.5", ",", "3.5"}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "3", "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", 
      RowBox[{"Darker", "[", "Orange", "]"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Steps (N)\>\"", ",", "\"\<Ratio\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Central Moment Ratio\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.982555921345417*^9, 3.982556046058106*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"83efd8eb-c41e-4d4f-bcdf-d70d9c26f1de"],

