Cell[BoxData[
 RowBox[{
  RowBox[{"randomWalk", "[", "n_", "]"}], ":=", 
  RowBox[{"Accumulate", "[", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}], ",", "0"}],
     "]"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"simple", " ", "random", " ", "walk"}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.982542597625236*^9, {3.98254280969429*^9, 3.9825428449494457`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"ef0ebeba-fba3-40f4-8657-b5c414f7342a"],

