Cell["\<\
Even though the walker only moves right (a completely biased walk in terms of \
direction), there is still a \"spread\" in their final position. This is \
because the length of the steps is uncertain.\
\>", "Text",ExpressionUUID->"03525e9b-7d82-475b-b68b-43c52fca051b"],

Cell[TextData[{
 "This is a fundamental result of the Central Limit Theorem: the sum of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$N$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef0df6e3-e9ae-488b-9432-11bd66e65bda"],
 " exponential variables will eventually look like a Gaussian centered at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$N/2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b072b148-f806-4182-859e-018a154119f7"],
 " with a width of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          StyleBox["N", "TI"]], "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\sqrt{N}/2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "567d4f0e-9201-402e-a5c7-85d8996b57bb"],
 "."
}], "Text",
