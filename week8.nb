Cell["\<\
This is known as Central Limit Theorem (CLT) 
Now, we adding a drift (bias) -- this represents an external force (for \
example, an electric field acting on a charged particle).\
\>", "Text",
 CellChangeTimes->{{3.982548936610372*^9, 3.982548978455469*^9}, {
  3.982550558820304*^9, 
  3.982550586776836*^9}},ExpressionUUID->"24def8ef-d897-463c-a28f-\
49a3d21340fd"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$p$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31c8d25f-d110-409e-a135-5532f086cfdb"],
 " is the probability of moving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "$+1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c2a15c7-8aa0-48bb-8cbd-7c743cc8c765"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["p", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "$q = (1-p)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "180044f0-26c3-494f-89ef-295d8230bd7c"],
 " is the probability of moving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-1", TraditionalForm], "errors" -> {}, "input" -> 
     "$-1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69341f7b-a5c2-4e6d-b902-fe1ca49970e0"],
 ":"
}], "Text",
 CellChangeTimes->{{3.982548995698018*^9, 
  3.982549063928508*^9}},ExpressionUUID->"15627a28-25b8-436f-911d-\
dd632b62c8f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nsteps", "=", "200"}], ",", 
       RowBox[{"nwalk", "=", "50"}], ",", "fairPaths", ",", "biasedPaths", 
       ",", "fairAvg", ",", "biasedAvg"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Generate", " ", "Fair", " ", "Walk", " ", 
       RowBox[{"(", 
        RowBox[{"p", "=", "0.5"}], ")"}]}], "*)"}], 
     RowBox[{
      RowBox[{"fairPaths", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0.5", ",", "0.5"}], "}"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", "nsteps"}], 
             "]"}], ",", "0"}], "]"}], "]"}], ",", 
         RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"fairAvg", "=", 
       RowBox[{"Mean", "[", "fairPaths", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Generate", " ", "Biased", " ", "Walk", " ", 
        RowBox[{"(", 
         RowBox[{"p", "=", "prob"}], ")"}]}], "*)"}], 
      RowBox[{"biasedPaths", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"RandomChoice", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "-", "prob"}], ",", "prob"}], "}"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", "nsteps"}], 
             "]"}], ",", "0"}], "]"}], "]"}], ",", 
         RowBox[{"{", "nwalk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"biasedAvg", "=", 
       RowBox[{"Mean", "[", "biasedPaths", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"GraphicsGrid", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"fairPaths", ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"Opacity", "[", "0.2", "]"}], ",", "Blue"}], "]"}]}], 
            ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Thick", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"0", ",", "nsteps"}], "]"}], ",", "fairAvg"}], 
                  "}"}], "]"}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"PlotLabel", "->", "\"\<Fair Walk (p=0.5)\>\""}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"biasedPaths", ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"Opacity", "[", "0.2", "]"}], ",", "Green"}], "]"}]}], 
            ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Thick", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"0", ",", "nsteps"}], "]"}], ",", "biasedAvg"}], 
                  "}"}], "]"}], "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"\"\<Biased Walk (p=\>\"", "<>", 
              RowBox[{"ToString", "[", "prob", "]"}], "<>", "\"\<)\>\""}]}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "}"}], 
        "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}],
    ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"prob", ",", "0.6", ",", "\"\<Right-move Probability (p)\>\""}],
       "}"}], ",", "0.1", ",", "0.9", ",", "0.05", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{
  3.979720525127068*^9, {3.982028892992097*^9, 3.982028930321375*^9}, {
   3.982549082130065*^9, 3.982549193419404*^9}, {3.982549223664978*^9, 
   3.982549296414578*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"4ab24a06-5871-4706-9e91-9b8eb576c910"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`prob$$ = 0.2, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
