}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"meanVs", "=", 
  RowBox[{"Mean", "[", "Data", "]"}]}], "\n", 
 RowBox[{"sdVs", "=", 
  RowBox[{
   RowBox[{"StandardDeviation", "[", "Data", "]"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Length", "[", "Data", "]"}], "-", "1"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Length", "[", "Data", "]"}], "]"}]}], ")"}]}]}], "\n", 
 RowBox[{"semVs", "=", 
  RowBox[{"sdVs", "/", 
   RowBox[{"Sqrt", "[", "n", "]"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"error", "-", "bar"}], " ", "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.979523404277513*^9, 3.979523433282009*^9}, {
  3.9795235323232813`*^9, 3.9795235443293877`*^9}, {3.979725261944511*^9, 
  3.979725296146944*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"37fb333d-2f3f-4927-af66-59aafb8c88eb"],

