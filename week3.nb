Cell[TextData[{
 "Ex-1: Let\[CloseCurlyQuote]s generate pseudo data that mimics a real \
experiment, such as a falling object ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"v", "=", 
     RowBox[{
      SubscriptBox["v", "0"], "+", 
      RowBox[{"g", " ", "t"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "379f6eaf-8b83-4e7b-82d4-ddc81759d303"],
 ")."
}], "Text",
 CellChangeTimes->{{3.97964251320382*^9, 
  3.979642580290388*^9}},ExpressionUUID->"845759ed-103a-43a7-8651-\
1714481fbd65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v0", "=", "2.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "9.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"v0", "+", 
        RowBox[{"g", "*", "t"}], "+", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "5", ",", "0.5"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.979642591834283*^9, 3.979642609574152*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"ce50f78e-a4a9-4df7-a38e-a256b7358e61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Lm", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "t"}], "}"}], ",", "t"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Perform", " ", "the", " ", "fit"}], " ", "*)"}], "\n", 
   RowBox[{"Lm", "[", "\"\<BestFitParameters\>\"", "]"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Returns", " ", 
     RowBox[{"{", 
      RowBox[{"v0", ",", "g"}], "}"}]}], "*)"}], "\n", 
   RowBox[{"Lm", "[", "\"\<ParameterTable\>\"", "]"}], "    "}]}]], "Input",
 CellChangeTimes->{{3.979642614947763*^9, 3.979642644889099*^9}, {
  3.9796426766897287`*^9, 3.9796426829925947`*^9}},
