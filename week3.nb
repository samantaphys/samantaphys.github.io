Cell["", "Text",
 CellChangeTimes->{
  3.9794762914113407`*^9},ExpressionUUID->"565b3412-5070-41b7-b0d6-\
b1e829a0fa37"],

Cell[TextData[StyleBox["Visualizing Correlation: Confidence Ellipses", \
"Subsection"]], "Text",
 CellChangeTimes->{3.9781767624486237`*^9, 3.979031532722184*^9, 
  3.9794762322911654`*^9},ExpressionUUID->"18d94ca3-b6b9-4cad-a4aa-\
f818fd05a116"],

Cell["\<\
To see how variables are correlated in your data analysis, you can plot a \
confidence ellipse. If the ellipse is tilted, the variables are correlated.\
\>", "Text",
 CellChangeTimes->{{3.9790315681915092`*^9, 3.979031643351562*^9}, 
   3.979476294915003*^9},ExpressionUUID->"fd6ee361-ac31-4017-a721-\
31dbd3e893e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Blue", ",", 
     RowBox[{"ConfidenceLevel", "->", "0.95"}], ",", 
     RowBox[{"Ellipsoid", "[", 
      RowBox[{"meanValues", ",", "covMatrix"}], "]"}]}], "}"}], ",", 
   RowBox[{"Axes", "->", "True"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Measurement X\>\"", ",", "\"\<Measurement Y\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.978176797341427*^9, {3.97903166315967*^9, 3.9790316702549887`*^9}, {
   3.979476272733817*^9, 3.9794762815587053`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"ca443ee5-f5f0-4a5b-bf95-4fd13e1704bb"],

Cell[BoxData[
 GraphicsBox[
  {RGBColor[0, 0, 1], Opacity[0.3], 
   StyleBox[
    InterpretationBox[
     GeometricTransformationBox[
      DiskBox[{0, 0}], {{{0.31622776601683794`, 0.}, {0.15811388300841897`, 
       0.4183300132670378}}, {10., 5.}}],
     Ellipsoid[{10., 5.}, {{0.1, 0.05}, {0.05, 0.2}}]],
    ConfidenceLevel -> 0.95]},
  Axes->True,
  Frame->True,
  FrameLabel->{
    FormBox["\"Measurement X\"", TraditionalForm], 
    FormBox["\"Measurement Y\"", TraditionalForm]},
  ImageSize->{256.4214131297522, Automatic}]], "Output",
 CellChangeTimes->{3.979724037004944*^9},
 CellLabel->
  "Out[143]=",ExpressionUUID->"b3844bfc-2fdd-4003-8b10-d8637637f7fb"]
}, Open  ]],

Cell[TextData[StyleBox["Monte Carlo simulation for error propagation", \
"Subsection"]], "Text",ExpressionUUID->"1243990d-7aa8-438c-aac2-c3aefec62981"],

Cell[TextData[{
 "Instead of using calculus (derivatives) or the ",
 StyleBox["Around", "Code"],
 " object, we performing an experiment 100,000 times to see how the \
distribution of the result ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "030b41bc-86de-4942-935c-4fad52a138ca"],
 " behaves."
}], "Text",
 CellChangeTimes->{{3.979478253531294*^9, 3.979478275885363*^9}, {
  3.979724134431566*^9, 
  3.9797241360269623`*^9}},ExpressionUUID->"6e5941c3-4a0d-43d9-9de6-\
93a300302d3f"],

