Cell[TextData[{
 "A ",
 StyleBox["residual", "Code"],
 " is the difference between the observed data and the model's prediction. If \
the residuals look like random dots around the zero line, then the model is \
likely correct."
}], "Text",
 CellChangeTimes->{{3.9796438597045603`*^9, 3.979643860671268*^9}, {
  3.979643909369136*^9, 
