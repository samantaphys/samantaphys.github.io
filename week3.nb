Cell["\<\
\"Goodness of Fit\" -- the quantitative way to answer the question: \"How \
much should I trust this model?\".\
\>", "Text",
 CellChangeTimes->{{3.9796452209878674`*^9, 
  3.979645228410502*^9}},ExpressionUUID->"3666fc0e-c272-4cda-a7f4-\
744e0a3273e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Chi]", "\[Nu]", "2"], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"d", ".", "o", ".", "f"}]], 
    RowBox[{"\[Sum]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox[
            RowBox[{"o", "b", "s"}], "TI"]], "-", 
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox[
            RowBox[{"f", "i", "t"}], "TI"]]}], ")"}], "2"], 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox[
         RowBox[{"e", "r", "r", "o", "r"}], "TI"], "2"]], "   ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Reduced", " ", "Chi"}], "-", "Squared"}], ")"}]}]}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{3.979645249480843*^9, 3.979645262454198*^9}, {
  3.9796456395708323`*^9, 3.9796456445001297`*^9}},
 TextAlignment->Center,ExpressionUUID->"3ff9c15e-c1d7-4923-a18d-9a59fa43d8b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", "2.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "5.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"initialize", " ", "the", " ", "pseudo"}], "-", 
    RowBox[{"random", " ", "number", " ", "generator"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"a", "*", "x"}], "+", "b", "+", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"data", ",", 
   RowBox[{"PlotStyle", "->", "Red"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Scattered  Data\>\""}]}], "]"}]}], "Input",\

 CellChangeTimes->{
  3.979645669081319*^9, {3.979645810455229*^9, 
   3.979645837098711*^9}},ExpressionUUID->"f863e246-1218-4cf3-991a-\
c594c55cbd9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9796457008769693`*^9, 3.9796457018842697`*^9}},
 CellLabel->
  "In[200]:=",ExpressionUUID->"3b319528-d493-4713-aac7-ad68c9d2b348"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigmaError", "=", "4.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estVar", "=", 
   RowBox[{"Lm", "[", "\"\<EstimatedVariance\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"reducedChiSq", "=", 
  RowBox[{"estVar", "/", 
   RowBox[{"(", 
    RowBox[{"sigmaError", "^", "2"}], ")"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Calculate", " ", "Reduced", " ", "Chi"}], "-", "Squared"}], 
    "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.9796454532606287`*^9, 3.979645521587225*^9}, {
  3.979645556635462*^9, 3.979645557258994*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"a7e842e9-e981-47b7-9c27-58dd724dbc70"],

Cell[TextData[{
 StyleBox["Problem-2:", "Subsection"],
 "\nGenerate a table of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "66bbba80-13ea-4815-b9f5-3b6e416d294e"],
 " random numbers using the ",
 StyleBox["RandomReal[{-1, 1}]", "Input"],
 " function (note that these numbers are centered at zero). Calculate the \
Standard Deviation of these ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "df959052-8a11-4a5e-bb02-7084e40db77a"],
 " numbers. Repeat this process for ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "f0568e69-89c7-4155-8605-60e914d83838"],
 " running from 100 to 2000 in steps of 200."
}], "Text",
 CellChangeTimes->{{3.979646606465822*^9, 3.979646647936653*^9}, {
  3.9796471449258966`*^9, 
  3.979647149016903*^9}},ExpressionUUID->"91d1f07a-42f8-4ad5-aaa1-\
f3f68639609e"],

Cell["Fit the result to the power-law form:", "Text",
 CellChangeTimes->{{3.979646696004362*^9, 
  3.979646713864439*^9}},ExpressionUUID->"79937d92-4d01-4aa4-83b0-\
ad3717a5762b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    StyleBox["a", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["b", "TI"]]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{
  3.979646680713702*^9, {3.979647091434987*^9, 3.979647091685034*^9}},
 TextAlignment->Center,ExpressionUUID->"f61c5cad-e511-4ab5-84b8-8e0ec1e39fbf"],

Cell[TextData[{
 "Q. What value is the exponent ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea0b4366-41e8-4981-b02f-3124c7e4b8b5"],
 " closest to ?"
}], "Text",
 CellChangeTimes->{{3.979646735192709*^9, 3.9796467533367043`*^9}, {
  3.979647096515603*^9, 
  3.979647101055396*^9}},ExpressionUUID->"1496d172-ab04-4cdd-b740-\
ebe16d6f03bd"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.979646917235735*^9, 3.9796469258176813`*^9}, {
  3.9796469850357323`*^9, 3.979646985390032*^9}, {3.979647083770699*^9, 
  3.9796470839230633`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"a40cf1cf-a65f-4907-ab69-443d90331b65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"StandardDeviation", "[", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "100", ",", "2000", ",", "200"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NLm", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"a", "*", 
      RowBox[{"n", "^", "b"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Best Fit Parameters: \>\"", ",", 
    RowBox[{"NLm", "[", "\"\<BestFitParameters\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Parameter Table:\>\"", "]"}], ";"}], "\n", 
 RowBox[{"NLm", "[", "\"\<ParameterTable\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.979646775244315*^9, 3.979646815329636*^9}, {
   3.979646857445319*^9, 3.979646893424322*^9}, 3.979647024937146*^9, {
