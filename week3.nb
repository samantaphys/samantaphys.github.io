Cell[TextData[StyleBox["Monte Carlo methods are computational algorithms that \
rely on repeated random sampling to obtain numerical results. In this \
tutorial, we learn the basics of Monte Carlo simulation using Mathematica.",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978154735010868*^9, 3.978154791048909*^9}, 
   3.978155696134118*^9, {3.9789601022451677`*^9, 3.97896011256898*^9}, {
