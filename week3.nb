Cell["", "Text",
 CellChangeTimes->{{3.979722193631056*^9, 
  3.979722195784617*^9}},ExpressionUUID->"9a782c2e-3168-4189-9cc4-\
3ae3196a1d5c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "m", ",", "r", ",", "h", ",", "\[Sigma]m", ",", "\[Sigma]r", ",", 
     "\[Sigma]h"}], "]"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rho", "=", 
    RowBox[{"m", "/", 
     RowBox[{"(", 
      RowBox[{"Pi", "*", 
       RowBox[{"r", "^", "2"}], "*", "h"}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Example", ":", " ", "\[Rho]"}], "=", 
    RowBox[{"m", "/", 
     RowBox[{"(", 
      RowBox[{"\[Pi]", " ", 
       RowBox[{"r", "^", "2"}], " ", "h"}], ")"}]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.979474326971871*^9, 3.979474336594688*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"646b474e-2dbc-4e46-a167-c6b4fcd3e84f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PropagateError", "[", 
   RowBox[{"rho", ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "r", ",", "h"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Sigma]m", ",", "\[Sigma]r", ",", "\[Sigma]h"}], "}"}]}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.979474340370315*^9, 3.979474355082684*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"1ec61a52-9df9-492c-bfda-b4d8347245ae"],

Cell[BoxData[
 FractionBox[
  SqrtBox[
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["h", "2"], " ", 
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox["\[Sigma]m", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["m", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["r", "2"], " ", 
         SuperscriptBox["\[Sigma]h", "2"]}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["h", "2"], " ", 
         SuperscriptBox["\[Sigma]r", "2"]}]}], ")"}]}]}], 
    RowBox[{
     SuperscriptBox["h", "4"], " ", 
     SuperscriptBox["r", "6"]}]]], "\[Pi]"]], "Output",
 CellChangeTimes->{3.979722295204867*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"30f38542-5e02-41cf-ad89-e6600db9edb9"]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s say you are measuring the Kinetic Energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["K", "E"], "=", 
     RowBox[{
      FractionBox["1", "2"], "m", " ", 
      SuperscriptBox["v", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a3ac0190-9e06-4738-b163-9268332cd2e0"],
 ") of an object. You have the mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "07bd5762-9a97-4cd0-b072-3f0b6e9b62ed"],
 " and velocity ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "b52fb570-004a-4249-a560-d66f6264ce06"],
 ", both with known uncertainties ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "m"], " ", "and", " ", 
    SubscriptBox["\[Sigma]", "v"]}], TraditionalForm]],ExpressionUUID->
  "59259e3a-f740-46a1-946b-fbfbba80fb00"],
 " . "
}], "Text",
 CellChangeTimes->{{3.9794747700155087`*^9, 
  3.979474859780653*^9}},ExpressionUUID->"e0033339-9090-42f8-8982-\
c596fb04229c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ke", "=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], "*", "m", "*", 
    RowBox[{"v", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{"keError", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"PropagateError", "[", 
     RowBox[{"ke", ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "v"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]m", ",", "\[Sigma]v"}], "}"}]}], "]"}], "//", 
    "PowerExpand"}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.979474873918071*^9, 3.9794748805178413`*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"1b8b40fe-acac-45d1-9061-4cc4d2e6f6d8"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["v", "4"], " ", 
     SuperscriptBox["\[Sigma]m", "2"]}], "4"], "+", 
   RowBox[{
    SuperscriptBox["m", "2"], " ", 
    SuperscriptBox["v", "2"], " ", 
    SuperscriptBox["\[Sigma]v", "2"]}]}]]], "Output",
 CellChangeTimes->{3.9797224459282703`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"309e952c-8119-4214-bf88-0a2cf6cb2c1e"]
}, Open  ]],

