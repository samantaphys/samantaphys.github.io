Cell[TextData[{
 "In modern Mathematica (12.0+),  the built-in ",
 StyleBox["Around", "Code"],
 " object encapsulates a value and its uncertainty. Mathematica will \
automatically handle the error propagation using first-order Taylor series \
expansion."
}], "Text",
 CellChangeTimes->{{3.979475038494101*^9, 3.979475088110467*^9}, {
  3.9794751420189877`*^9, 
  3.979475169647975*^9}},ExpressionUUID->"466467e8-ead0-487f-9ba5-\
ad563df69248"],

