Cell[TextData[StyleBox["Correlation", "Subsection"]], "Text",
 CellChangeTimes->{{3.979475569216028*^9, 
  3.9794755862194147`*^9}},ExpressionUUID->"d5cbb7b5-66c9-4e1a-92d2-\
aa01ba71db81"],

Cell[TextData[{
 "If you measure the length and width of a metal plate as it heats up, both \
measurements will increase together -- then the errors are \
\[OpenCurlyDoubleQuote]correlated\[CloseCurlyDoubleQuote]. \n\nThe \
generalized error propagation formula for a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dce9491b-4174-4c7f-ab37-9b0e8cd2518f"],
 " is:"
}], "Text",
 CellChangeTimes->{{3.979475624998302*^9, 
  3.9794756676457567`*^9}},ExpressionUUID->"0e006a03-a714-4e20-b7a6-\
159afd9a6102"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sigma]", "F"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Delta]", " ", "F"}], 
         RowBox[{"\[Delta]", " ", "x"}]], 
        SubscriptBox["\[Sigma]", "x"]}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Delta]", " ", "F"}], 
         RowBox[{"\[Delta]", " ", "y"}]], 
        SubscriptBox["\[Sigma]", "y"]}], ")"}], "2"], "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"\[Delta]", " ", "F"}], 
        RowBox[{"\[Delta]", " ", "x"}]], ")"}], " ", 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"\[Delta]", " ", "F"}], 
        RowBox[{"\[Delta]", " ", "y"}]], ")"}], " ", 
      SubscriptBox["\[Sigma]", 
       RowBox[{"x", " ", "y"}]]}]}]}], " ", ","}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.97947568840272*^9, 3.979475787036852*^9}, {
  3.979723405028331*^9, 3.979723405945086*^9}},
 TextAlignment->Center,ExpressionUUID->"eb52793a-3d04-4618-9354-e997ef35e95e"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"x", " ", "y"}]], TraditionalForm]],ExpressionUUID->
  "016acc60-00d4-4426-83c2-868fd8093793"],
 " is the covariance."
}], "Text",
 CellChangeTimes->{{3.979475793662671*^9, 
  3.979475803981077*^9}},ExpressionUUID->"2b99d4c8-a2fc-4d38-bb94-\
a920d2c1b4ab"],

Cell["\<\
In Mathematica, we represent these relationships using a symmetric matrix:\
\>", "Text",
 CellChangeTimes->{{3.979475840493011*^9, 
  3.9794758442012167`*^9}},ExpressionUUID->"9c07e907-b6a7-4b0d-a88c-\
5dbbb7f77de9"],

Cell[TextData[{
 "\[CapitalSigma]=",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       SubsuperscriptBox["\[Sigma]", "x", "2"], 
       SubscriptBox["\[Sigma]", 
        RowBox[{"x", " ", "y"}]]},
      {
       SubscriptBox["\[Sigma]", 
        RowBox[{" ", 
         RowBox[{"x", " ", "y"}]}]], 
       SubsuperscriptBox["\[Sigma]", "y", "2"]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "40d7b130-d3a5-4ce0-8358-cc834b99fae5"]
}], "Text",
 CellChangeTimes->{{3.979475848326939*^9, 3.979475853405631*^9}, {
  3.979475915626684*^9, 3.979475991874486*^9}, {3.979723500822908*^9, 
  3.9797235045790873`*^9}},
 TextAlignment->Center,ExpressionUUID->"9b3d8ffc-132d-4c37-9884-f84655437b9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"x", "*", "y"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"covMatrix", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.05"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.2"}], "}"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979476010733828*^9, 3.979476026112627*^9}},
 CellLabel->
  "In[133]:=",ExpressionUUID->"3a916769-06e2-4dd7-9dd3-43ac9641fc61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"jacobian", "=", 
  RowBox[{"D", "[", 
   RowBox[{"f", ",", 
    RowBox[{"{", "vars", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.979476034151389*^9, 3.97947604802206*^9}, 
   3.979723585347028*^9},
 CellLabel->
  "In[136]:=",ExpressionUUID->"5a3d897d-a0b0-4885-b43e-414e69184f7f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"y", ",", "x"}], "}"}]], "Output",
 CellChangeTimes->{3.9797235858696423`*^9},
 CellLabel->
  "Out[136]=",ExpressionUUID->"fb39d49e-88c9-422f-8528-ee2e5952637d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"propagatedVariance", "=", 
  RowBox[{
   RowBox[{"jacobian", ".", "covMatrix", ".", 
    RowBox[{"Transpose", "[", "jacobian", "]"}]}], " ", "//", 
   "Expand"}]}]], "Input",
 CellChangeTimes->{{3.9794760528865843`*^9, 3.9794760980245256`*^9}, {
  3.9797182565279293`*^9, 3.979718261398692*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"c6b42b88-43a2-4865-a848-8c072d53bd29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"0.2`", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  RowBox[{"0.1`", " ", "x", " ", "y"}], "+", 
  RowBox[{"0.1`", " ", 
   SuperscriptBox["y", "2"]}]}]], "Output",
 CellChangeTimes->{3.979723630257337*^9},
 CellLabel->
  "Out[137]=",ExpressionUUID->"acf7be95-ea15-4e50-92d3-713bb93908e8"]
}, Open  ]],

Cell["\<\
This is used to estimate the variance of a multivariate function based on the \
uncertainties of its input variables.\
\>", "Text",ExpressionUUID->"8532f8c5-f24b-411a-a120-160ddd7a40f2"],

Cell[TextData[{
 "The ",
 StyleBox["Around", "Code"],
 " object can also handle correlations, but it requires you to define a ",
 StyleBox["MultivariateDistribution", "Code"],
 " or use the ",
 StyleBox["VectorAround", "Code"],
 " command. ",
 StyleBox["VectorAround", "Code"],
 " is specifically designed to hold a list of values and their associated \
covariance matrix."
}], "Text",
 CellChangeTimes->{{3.979476137209119*^9, 
  3.979476138722232*^9}},ExpressionUUID->"d6f8f5c4-dffc-4b40-a865-\
76e8c23bd9b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"meanValues", "=", 
   RowBox[{"{", 
    RowBox[{"10.0", ",", "5.0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"valsWithCov", "=", 
   RowBox[{"VectorAround", "[", 
    RowBox[{"meanValues", ",", "covMatrix"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979116964880481*^9, 3.979116975327444*^9}, {
  3.979476180980802*^9, 3.979476188990841*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"7dd089a9-841b-4c48-af91-2eeae5a5b1eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"valsWithCov", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",
 CellChangeTimes->{3.9797238879973097`*^9},
 CellLabel->
  "In[141]:=",ExpressionUUID->"f0252aec-dd6f-4b93-a400-3440829ac505"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10.`", ",", "5.`"}], "}"}]], "Output",
 CellChangeTimes->{3.9797238891152973`*^9},
 CellLabel->
  "Out[141]=",ExpressionUUID->"a5ba0d0d-a916-4528-9168-7cdafaa782bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"valsWithCov", "[", 
  RowBox[{"[", "2", "]"}], "]"}]], "Input",
 CellChangeTimes->{3.9797239036798*^9},
 CellLabel->
  "In[142]:=",ExpressionUUID->"fae741d5-fa35-4e37-ae2c-c0387a7581dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.1`", ",", "0.05`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.05`", ",", "0.2`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.979723904474869*^9},
 CellLabel->
  "Out[142]=",ExpressionUUID->"c48c417a-9662-469f-8d97-284884c31e5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"area", "=", 
  RowBox[{
   RowBox[{"valsWithCov", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "*", 
   RowBox[{"valsWithCov", "[", 
    RowBox[{"[", "2", "]"}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "Area"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{
  3.9790311122189074`*^9, {3.979116991489016*^9, 3.9791169918339653`*^9}, {
   3.979117046906067*^9, 3.979117047472756*^9}, {3.979476195274188*^9, 
   3.979476202973463*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"9885537e-3133-4dfa-bbb4-d289ce19656b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1.`", ",", "0.5`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.25`", ",", "1.`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.97972387434256*^9},
 CellLabel->
  "Out[140]=",ExpressionUUID->"ebec3dfa-1d8d-47a3-b15e-4fe46ad8c2f8"]
