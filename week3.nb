Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RandomVariate", "[", 
     RowBox[{"dist", ",", " ", "1000"}], "]"}], " ", "//", " ", "ListPlot"}], 
   ",", " ", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"RegionMember", "[", 
      RowBox[{
       RowBox[{"Ellipsoid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0.8"}], "}"}], ",", " ", 
