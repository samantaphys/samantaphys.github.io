    RowBox[{"x", " ", "y"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"sx", ",", "sy"}], "}"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.979474543743462*^9, 3.979474579597381*^9}, {
  3.979474610449736*^9, 3.979474610905011*^9}, {3.979722050844451*^9, 
  3.9797220517046833`*^9}},ExpressionUUID->"52290541-aa5a-4540-89cf-\
9ad6408a1ed5"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["sy", "2"], " ", 
    SuperscriptBox["x", "2"]}], "+", 
   RowBox[{
    SuperscriptBox["sx", "2"], " ", 
    SuperscriptBox["y", "2"]}]}]]], "Output",
 CellChangeTimes->{3.979722041267404*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"9fe74011-efbb-468e-ad38-89e0a5ef433f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PropagateError", "[", 
   RowBox[{
    RowBox[{"x", " ", "y", " ", "z"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"sx", ",", "sy", ",", "sz"}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.979722066783999*^9, 3.9797220811451597`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"a199f8fe-301b-4e15-8b2a-e7a3c45ca424"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   RowBox[{
