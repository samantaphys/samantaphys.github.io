Cell["\<\
Stop when enough samples are generated OR accuracy is reached. This is a \
typical Monte Carlo stopping criterion.\
\>", "Text",
 CellChangeTimes->{{3.9820303201348553`*^9, 
  3.982030320435896*^9}},ExpressionUUID->"b77a071f-b411-4b88-bc6f-\
2509b3d3ceaa"],

Cell[TextData[{
 StyleBox["RandomReal[]", "Code"],
 " generates ",
 StyleBox["x\[Element][0,1]", "Code"],
 " uniformly. The above example is to find ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "1"], 
     RowBox[{
      SuperscriptBox["x", "2"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95be7d5d-3e1e-42cd-984e-afbb047d0d29"],
 " ."
}], "Text",
 CellChangeTimes->{{3.9820309498648453`*^9, 3.982030954575638*^9}, {
  3.9820312947123957`*^9, 3.982031310348441*^9}, {3.982031351906355*^9, 
  3.982031380025441*^9}},ExpressionUUID->"d0507854-a867-4b95-9928-\
b0efc7b9260f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nmax", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"samples", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "nmax"}], "]"}]}], ";"}], "\n", 
 RowBox[{"values", "=", 
  RowBox[{"samples", "^", "2"}]}]}], "Input",
 CellChangeTimes->{{3.9820312898826437`*^9, 3.982031292754266*^9}, {
   3.9820315942087717`*^9, 3.9820315972885103`*^9}, {3.982031955550078*^9, 
   3.982031962218666*^9}, 3.982031992614777*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"342921f1-663c-4059-ad94-45eee88ec38c"],

