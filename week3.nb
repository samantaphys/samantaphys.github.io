Cell[TextData[StyleBox["Generating and Visualizing Data", "Subsection"]], \
"Text",
 CellChangeTimes->{{3.97851014404093*^9, 3.978510146044952*^9}, {
   3.978961906750209*^9, 3.9789620128714848`*^9}, {3.9789645928273373`*^9, 
   3.978964597173747*^9}, 3.9794718032917852`*^9, {3.9794718940024433`*^9, 
   3.979471905108098*^9}},ExpressionUUID->"878092f5-1f07-4700-b49d-\
7f7ffb42e545"],

Cell["\<\
We start by generating a sample of 100 measurements for a physical quantity \
(e.g., the length of a rod) with a known mean and standard deviation.\
\>", "Text",ExpressionUUID->"3ca734f0-02c8-4ca4-b1dc-4b9ca775c11b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"10.5", ",", "0.2"}], "]"}], ",", "100"}], "]"}]}], ";"}], 
  "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"sample", " ", "data"}], " ", "-", " ", 
    RowBox[{"Gaussian", " ", "shaped"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Histogram", "[", 
  RowBox[{"data", ",", "Automatic", ",", "\"\<Probability\>\"", ",", 
   RowBox[{"ChartStyle", "->", "LightBlue"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Experimental Data Distribution\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Value\>\"", ",", "\"\<Probability\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{
  3.9789620762376423`*^9, {3.9791153475144453`*^9, 3.9791153725967607`*^9}, {
   3.979115502664016*^9, 3.979115522504627*^9}, 3.979471808852975*^9, {
   3.979471854364623*^9, 3.979471879999661*^9}, {3.9794719784219227`*^9, 
   3.9794720038662357`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"03ba6bec-115c-41f5-9622-0d69037a9e8c"],

