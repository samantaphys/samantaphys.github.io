Cell[TextData[{
 "If your function was highly non-linear (e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "bd780ab4-d4d2-455f-bf4f-faae882863b4"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"x", "/", "y"}]], TraditionalForm]],ExpressionUUID->
  "2b40640a-ac61-4b89-92a5-2239711e241e"],
 "), the standard error formula might be slightly wrong ( because ",
 StyleBox["Around", "Code"],
 " object uses a linear approximation -- first-order Taylor expansion), while \
Monte Carlo handles \"curved\" error spaces perfectly and is exact."
}], "Text",
 CellChangeTimes->{{3.979478418040992*^9, 
  3.9794785151104183`*^9}},ExpressionUUID->"36f7ecd1-c069-4b11-b40a-\
d77334a25a38"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hist", "=", 
    RowBox[{"Histogram", "[", 
     RowBox[{"samples", ",", "50", ",", "\"\<PDF\>\""}], "]"}]}], ";"}], " ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
   "Comparing", " ", "to", " ", "the", " ", "\"\<Exact\>\"", " ", "analytic", 
    " ", "result"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distPlot", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{
          RowBox[{"Mean", "[", "samples", "]"}], ",", 
          RowBox[{"StandardDeviation", "[", "samples", "]"}]}], "]"}], ",", 
        "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "5.5", ",", "6.9"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"hist", ",", "distPlot"}], "]"}]}], "Input",
 CellChangeTimes->{
  3.979478533604857*^9, {3.979478564784163*^9, 3.979478578344844*^9}, {
   3.97947864372222*^9, 3.979478659468053*^9}},
