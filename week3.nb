 RowBox[{"{", 
  RowBox[{
  "0.009609085172599969`", ",", "0.49346611048826705`", ",", 
   "0.13580093647085315`", ",", "0.1488842154167132`", ",", 
   "0.9069242604117564`", ",", "0.5182179876653116`", ",", 
