Cell[TextData[{
 "Two useful methods for doing iterative calculations in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". \n(i) ",
 StyleBox["Do",
  FontWeight->"Bold"],
 " loop : It works well for simple and  nested loops.\n(ii) ",
 StyleBox["While",
  FontWeight->"Bold"],
 " loop: It is useful for complex loops."
}], "Text",
 CellChangeTimes->{{3.979471747525167*^9, 3.979471777373878*^9}, {
