Cell[CellGroupData[{

Cell["2. Symbolic Error Propagation", "Section",
 CellChangeTimes->{{3.9781548853480597`*^9, 3.9781548905914392`*^9}, {
   3.9781549953001757`*^9, 3.978154996581554*^9}, {3.97817477170082*^9, 
   3.9781747757483263`*^9}, {3.9790308993502817`*^9, 3.979030915508259*^9}, 
   3.9794725142187347`*^9},
 FontFamily->"Times",ExpressionUUID->"f5d792e6-c49a-4281-84dd-88c79feb7b7c"],

Cell[TextData[{
 "We use Mathematica\[CloseCurlyQuote]s symbolic engine to calculate how \
errors in inputs affect a calculated result.\nThe uncertainty of a function  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ",", "..."}], ")"}], " "}], TraditionalForm]],
  ExpressionUUID->"bc8d33ee-343f-47f0-b8fb-d550295a7b04"],
 " is determined by the partial derivatives of the function with respect to \
each variable ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "a4eeac93-81e0-49ea-8608-f00af3a19240"],
 ", weighted by their individual uncertainties ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    SubscriptBox["x", "i"]], TraditionalForm]],ExpressionUUID->
  "cb3ef218-591b-4b0c-8c3f-8cd9c528c9e0"],
 " ."
}], "Text",
 CellChangeTimes->{{3.979472666551186*^9, 3.97947266802059*^9}, {
  3.979473859198835*^9, 
  3.9794739853441257`*^9}},ExpressionUUID->"9af3ffbf-78c7-4127-91ca-\
23cc9241f798"],

Cell["The general formula for uncorrelated variables is:", "Text",
 CellChangeTimes->{{3.979474007928719*^9, 
  3.9794741382743673`*^9}},ExpressionUUID->"5f557fd6-6ea5-46d8-b0ce-\
2c350503a358"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Sigma]", "F"], "=", 
   SqrtBox[
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "i"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[Delta]", " ", "F"}], 
         RowBox[{"\[Delta]", " ", 
          SubscriptBox["x", "i"]}]], 
        SubscriptBox["\[Sigma]", 
         SubscriptBox["x", "i"]]}], ")"}], "2"]}]]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{3.979474141598029*^9, 3.979474153842629*^9}, {
  3.9797217548582497`*^9, 3.979721756030611*^9}},
 TextAlignment->Center,ExpressionUUID->"a31d4c6d-c281-4150-b95a-cea8fcd0fa67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"x", " ", "y"}]}]], "Input",
 CellChangeTimes->{
  3.979474410908413*^9, {3.979474485787072*^9, 3.979474487597334*^9}, {
   3.9794746383634243`*^9, 3.9794746388171797`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"18d0361e-bfd1-4bbd-9c3e-fa3817ddcf8b"],

