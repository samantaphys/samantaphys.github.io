        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "axis1"}], "}"}], "]"}], ",", 
      RowBox[{"Arrow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "axis2"}], "}"}], "]"}]}], 
     "}"}], "]"}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<Error Ellipse with Principal Component Axes\>\""}]}], "\n", 
  "]"}]], "Input",
