Cell["\<\
When one condition is False in intermediate steps, the loop stops immediately.\
\>", "Text",
 CellChangeTimes->{{3.982029929591528*^9, 
  3.98202995018922*^9}},ExpressionUUID->"ff9b65bc-6976-4a06-b6f7-\
51df08e4602a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"estimate", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"error", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.982030160147687*^9, 3.982030179445888*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f12cb8bc-9761-4dd0-831a-b31f59e6b0f1"],

Cell[BoxData[
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "<", "100000"}], "&&", 
    RowBox[{"error", ">", "0.001"}]}], ",", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"estimate", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"estimate", "*", "n"}], "+", 
        RowBox[{"x", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"error", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"estimate", "-", 
       RowBox[{"1", "/", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"n", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.982030177081759*^9, 3.982030217488441*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"e841fd75-2226-45f6-9752-c4b7427f6c7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"estimate", ",", "n"}], "}"}]], "Input",
 CellChangeTimes->{3.9820302730535793`*^9},
