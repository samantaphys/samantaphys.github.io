Cell[TextData[{
 "In Mathematica, a ",
 StyleBox["While",
  FontWeight->"Bold"],
 " loop runs as long as its condition is ",
 StyleBox["True", "Code"],
 ". You can include multiple conditions using logical operators: ",
 StyleBox["&& \[RightArrow] AND", "Code"],
 " , ",
 StyleBox["|| \[RightArrow] OR", "Code"],
 " , ",
 StyleBox["! \[RightArrow] NOT", "Code"]
}], "Text",
 CellChangeTimes->{{3.979522767923794*^9, 3.9795227953909187`*^9}, 
   3.982028646002522*^9, {3.982029561848257*^9, 3.982029575258222*^9}, 
   3.9820296078312473`*^9},ExpressionUUID->"3640e07f-8db4-4c11-bfb2-\
3c8f2cfd9f27"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"i", "=", "1"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"initial", " ", "number"}], "*)"}]}], "\n", 
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"i", "<", "20"}], "&&", 
    RowBox[{
     RowBox[{"EvenQ", "[", "i", "]"}], "==", "False"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "i", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.98202972444037*^9, 3.982029772409753*^9}, {
   3.982029824441321*^9, 3.982029834992206*^9}, 3.982030233420946*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"69a7537d-dbd8-40b0-9ba6-1f45b952953a"],

