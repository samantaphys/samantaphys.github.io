Cell[TextData[{
 "To fit a model of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", " ", "x"}], "+", "b"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "227f3c3f-9507-47a4-bf1d-7e2ee7a4e9ef"],
 " :"
}], "Text",
 CellChangeTimes->{{3.979641970715353*^9, 
  3.979641991636466*^9}},ExpressionUUID->"a895caec-3753-4450-8c7f-\
8a8910a6eb6b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1"}], "}"}], ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lm", "[", "\"\<BestFitParameters\>\"", "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"best", " ", "fit", " ", "value", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}]}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.978183076994295*^9, 3.978183123989231*^9}, {
   3.9790385954150887`*^9, 3.9790386386331053`*^9}, 3.979641820171092*^9, {
