Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", "2.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "5.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
