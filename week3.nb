Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sigmaf", "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], " ", "sx"}], 
      ")"}], "^", "2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], " ", "sy"}], 
      ")"}], "^", "2"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.979474431679858*^9, 3.97947448268277*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"55ab28de-8420-42b4-95ce-0cc1cced6b42"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["sy", "2"], " ", 
    SuperscriptBox["x", "2"]}], "+", 
   RowBox[{
    SuperscriptBox["sx", "2"], " ", 
    SuperscriptBox["y", "2"]}]}]]], "Output",
 CellChangeTimes->{3.9797219107297087`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"bfd27f0e-3802-4098-bedd-d4dc88859079"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PropagateError", "[", 
    RowBox[{"func_", ",", "vars_List", ",", "sigmas_List"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"func", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "^", "2"}], "*", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], ")"}], "&"}], "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"vars", ",", "sigmas"}], "}"}], "]"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.979474208563395*^9, 3.979474236046068*^9}, {
  3.9794742814055967`*^9, 3.9794743321142406`*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"0577f05e-e9a7-4dc6-a666-249eab9ce120"],

