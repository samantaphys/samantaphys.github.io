   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"x", " ", "y"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979478050451521*^9, 3.979478061667426*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9c090cd4-247f-46fe-b53d-8f09214c9b80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"samples", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0.50", ",", "0.01"}], "]"}], "]"}], ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"12.4", ",", "0.2"}], "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"10", "^", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978512285956051*^9, 3.978512305640705*^9}, {
  3.979031674956367*^9, 3.97903168505151*^9}, {3.979477964122528*^9, 
