}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"estimate", "=", 
  RowBox[{
   RowBox[{"Accumulate", "[", "values", "]"}], "/", 
   RowBox[{"Range", "[", "nmax", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.982031400448299*^9, 3.9820314038435507`*^9}, 
