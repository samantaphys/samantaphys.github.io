  3.979725173401307*^9}},ExpressionUUID->"1f80f57a-35d7-4ad0-925d-\
fa5f3b15a6a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9797251774300213`*^9, 3.979725180248068*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"c4a524dc-fd21-4cbd-9650-6d1f1cfa3b7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"{", 
    RowBox[{
    "338.0", ",", "340.0", ",", "341.5", ",", "343.0", ",", "344.5", ",", 
     "346.0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"freqs", "=", 
   RowBox[{"{", 
    RowBox[{"8", ",", "12", ",", "25", ",", "35", ",", "10", ",", "10"}], 
    "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9795233351629267`*^9, 3.979523353515409*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"ec7831e6-20aa-45cb-9940-cde8f7753f06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Data", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{"ConstantArray", ",", 
      RowBox[{"{", 
       RowBox[{"values", ",", "freqs"}], "}"}]}], "]"}], "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{"Build", " ", "the", " ", "full", " ", "dataset"}], "*)"}], "\n", 
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "Data", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979523365565755*^9, 3.979523376456819*^9}, {
   3.979725120131976*^9, 3.979725125510743*^9}, 3.9797251637336082`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"e2f73bc9-7a85-45eb-8919-a34b3a55554e"],

Cell[CellGroupData[{

Cell[BoxData["n"], "Input",
 CellChangeTimes->{3.979725092080271*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"f37a51de-5241-4d5b-aba1-036f3efb381f"],

