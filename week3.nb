Cell[TextData[{
 "This calculates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["x", "i"], "2"], "/", "n", "  "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce631331-f92f-4e95-9c11-02077d366323"],
 "for every ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "412c890d-133a-4fb7-9798-c9d4774f6c4e"],
 "."
}], "Text",
 CellChangeTimes->{{3.982032089957776*^9, 
  3.982032171865176*^9}},ExpressionUUID->"013586db-44df-46f9-b3a3-\
2dbcebc1b64a"],

