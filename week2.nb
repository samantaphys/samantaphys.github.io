Cell[TextData[{
 "This plot shows:\n (i)  \[Omega] = 0.5 \[RightArrow] slow driving \
(oscillations with small amplitude)\n (ii) \[Omega] = 1.0 \[RightArrow] \
resonance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Omega]", "=", 
     SubscriptBox["\[Omega]", "0"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1c538d5-ab51-473d-87f7-48b8ac1600fb"],
 "\n(iii) \[Omega] = 1.2 \[RightArrow] off-resonance (bounded oscillation) \n\
"
}], "Text",
 CellChangeTimes->{{3.978963602344969*^9, 3.978963636715848*^9}, {
  3.978963784249467*^9, 
  3.9789638865221167`*^9}},ExpressionUUID->"58b33fb4-7a53-4fdb-867d-\
fe2e139624f2"],

Cell[TextData[StyleBox["Anharmonic Oscillator", "Subsection"]], "Text",
 CellChangeTimes->{{3.978964043697019*^9, 
  3.978964105157189*^9}},ExpressionUUID->"a663e0f3-f801-46b3-bede-\
ff38adc37e63"],

Cell[TextData[{
 "In the real world, springs aren't perfectly linear. The Duffing Oscillator \
adds a cubic term ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af95d37b-9e2f-405f-b3c2-604f4ad91003"],
 ". This introduces \"Anharmonicity\", where the period depends on the \
amplitude. The equation is "
}], "Text",
 CellChangeTimes->{{3.9789643941991262`*^9, 
  3.978964433055996*^9}},ExpressionUUID->"eb05a1a9-2c6c-4486-9b82-\
bc7d7cd73e9f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["d", "2"], 
      SuperscriptBox["d\[Tau]", "2"]], "x"}], "+", "x", "+", 
    RowBox[{"4", "\[Lambda]", " ", 
     SuperscriptBox["x", "3"]}]}], "=", "0"}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.9789641083939743`*^9, 3.978964133074217*^9}, {
  3.9791164687066593`*^9, 3.979116473710949*^9}},
 TextAlignment->Center,ExpressionUUID->"5d6fd7d0-1047-48c3-85d6-8c4d96d96349"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Lambda]", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anh", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{"x", "[", "t", "]"}], "+", 
         RowBox[{"4", " ", "\[Lambda]", " ", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "3"}]}]}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "x", 
     ",", 
