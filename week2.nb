Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Physics through Computational Thinking\n",
 StyleBox["Week-2: Dimensional Analysis and Scales of Physical Problems ",
  FontSize->36]
}], "Title",
 CellChangeTimes->{{3.978154444598084*^9, 3.97815454028798*^9}, {
   3.978154584958158*^9, 3.9781545857817307`*^9}, {3.9789595194053926`*^9, 
   3.978959519829749*^9}, 3.9789600051734943`*^9},
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"f530929d-449d-4ccc-ade4-cd49f17f0e2a"],

Cell[TextData[StyleBox["In this week, we introduce dimensional analysis and \
non-dimensionalization as essential tools for understanding physical systems. \
By identifying the natural scales of a problem, we simplify equations, reduce \
the number of parameters",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978154735010868*^9, 3.978154791048909*^9}, 
   3.978155696134118*^9, {3.9789601022451677`*^9, 3.97896011256898*^9}, {
   3.97896015079508*^9, 3.978960160357774*^9}, {3.978960241220355*^9, 
   3.9789602415653667`*^9}},
 FontSize->14,ExpressionUUID->"fb58e92b-222e-4ad7-a3a5-253cfc0f6d29"],

Cell[CellGroupData[{

Cell["1. Non-Dimensionalization", "Section",
 CellChangeTimes->{{3.9781548853480597`*^9, 3.9781548905914392`*^9}, {
   3.9781549953001757`*^9, 3.978154996581554*^9}, 3.978960224929956*^9},
 FontFamily->"Times",ExpressionUUID->"f7a55bbb-9574-4d38-833d-d883e069adaf"],

Cell["\<\
The aim is to reduce the number of parameters. In a Spring-Mass system, \
instead of tracking m, k, and t, we use a single dimensionless time \[Tau].\
\>", "Text",
 CellChangeTimes->{{3.9781551865778027`*^9, 3.9781552107944717`*^9}, {
  3.9781552656989527`*^9, 3.9781552672005577`*^9}, {3.9789603081291227`*^9, 
  3.978960355569916*^9}, {3.978960392044528*^9, 
  3.978960472356228*^9}},ExpressionUUID->"fcb4d3f8-5101-4b56-a2b5-\
9ac9b86fb1df"],

Cell[TextData[StyleBox["The Parametric View", "Subsection"]], "Text",
 CellChangeTimes->{
  3.978960505928475*^9},ExpressionUUID->"a28d8ad1-60a4-4c95-b85d-\
7b814f0b5b6f"],

Cell[TextData[{
 "Example equation:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", 
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], "x"}], TraditionalForm]],ExpressionUUID->
  "33d522e6-e4ce-49e2-8928-834363a4e00f"],
 " + ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "3ab940d9-ead1-4559-afa1-e9757b79ce57"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "722e70a5-2465-4d83-80a3-6ccbcb80f535"],
 "       -- (1)\n\nNatural time scale:   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]],ExpressionUUID->
  "d0ebe9fb-b7c0-4a69-9f33-b84f01d2f713"],
 " = ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FractionBox["m", "k"]], TraditionalForm]],ExpressionUUID->
  "0b6c6651-bcb7-4bf5-8717-8e85a5bc1a0d"],
 "\nDefine dimensionless time (\[Tau]) :   ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "9ead5fe5-b2c0-4a0b-9194-0a5e2e749953"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]],ExpressionUUID->
  "5c19942f-edd5-4e94-89de-4826c4680f73"],
 "\[Tau]\n \n Eq. (1) becomes,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["d", "2"], 
       SuperscriptBox["d\[Tau]", "2"]], 
      RowBox[{"x", "(", "\[Tau]", ")"}]}], "+", 
     RowBox[{"x", "(", "\[Tau]", ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"a0fbc07a-d6ad-477b-a88d-95e88def2f96"],
 "  "
}], "Text",
 CellChangeTimes->{{3.978960660498054*^9, 3.978960790103318*^9}, {
   3.978960820141343*^9, 3.978960988307704*^9}, 3.978961025969944*^9, {
   3.978961220715026*^9, 3.9789612416307783`*^9}, {3.978961384359775*^9, 
   3.9789613849511013`*^9}, {3.9789617749859953`*^9, 
   3.9789617998263807`*^9}, {3.979114852032267*^9, 
   3.979114859588838*^9}},ExpressionUUID->"2e659133-85b4-4b79-aec7-\
8c11d80a68f7"],

Cell[TextData[{
 "This is a dimensionless equation. One equation fits all masses and springs \
- only one parameter. \n\nA solution is:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", "(", "\[Tau]", ")"}], "=", 
     RowBox[{"cos", "(", "\[Tau]", ")"}]}], "  ", ",", "  ", 
    RowBox[{
     RowBox[{"v", "(", "\[Tau]", ")"}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["d", "d\[Tau]"], 
       RowBox[{"x", "(", "\[Tau]", ")"}]}], "=", 
      RowBox[{"-", 
       RowBox[{"sin", "(", "\[Tau]", ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e444ee98-f8df-42aa-8814-8a46c8922c6a"]
}], "Text",
 CellChangeTimes->{{3.978961031928301*^9, 3.978961042830035*^9}, {
  3.97896124795223*^9, 
  3.978961367020513*^9}},ExpressionUUID->"b884706b-c6ee-46e0-824b-\
0e03275d4c20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "tau", "]"}], ",", 
     RowBox[{"-", 
      RowBox[{"Sin", "[", "tau", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tau", ",", "0", ",", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Position (x)\>\"", ",", "\"\<Velocity (v)\>\""}], "}"}]}], 
   ",", 
   RowBox[{"PlotLabel", "->", "\"\<Dimensionless Phase Space\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.978155234077742*^9, 3.978155245112795*^9}, {
   3.978509750388301*^9, 3.978509775726165*^9}, 3.978960516270561*^9, 
   3.9789614213281*^9, {3.978961648722804*^9, 3.97896164994693*^9}, {
   3.979115297451462*^9, 3.9791153013403482`*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"43bbb451-7fe2-4870-aa65-004e176222da"],

