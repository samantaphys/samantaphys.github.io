Cell[CellGroupData[{

Cell["2. Mathematical properties of Sequences", "Section",
 CellChangeTimes->{{3.9781548853480597`*^9, 3.9781548905914392`*^9}, {
  3.9781549953001757`*^9, 3.978154996581554*^9}, {3.97817477170082*^9, 
