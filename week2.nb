 FontFamily->"Times",ExpressionUUID->"f5d792e6-c49a-4281-84dd-88c79feb7b7c"],

Cell[TextData[StyleBox["The Fibonacci Sequence", "Subsection"]], "Text",
 CellChangeTimes->{
  3.978155002165979*^9, {3.9781550367355967`*^9, 3.978155040671198*^9}, {
   3.978155101737219*^9, 3.978155135387121*^9}, 3.978155194025982*^9, 
   3.978155262095471*^9, 3.9781748064372597`*^9, 3.979030925940213*^9},
 TextAlignment->Left,ExpressionUUID->"c4b29a1b-9aaf-43e2-a402-94193b84253a"],

Cell["\<\
The Fibonacci sequence is defined by the recurrence relation:\
\>", "Text",
 CellChangeTimes->{{3.979030954444255*^9, 
  3.9790309730948544`*^9}},ExpressionUUID->"9427977f-0580-43c0-b702-\
80b1633e46f3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "n"], TraditionalForm]],ExpressionUUID->
  "3e358541-8481-4721-bc2d-6db6f2046aa1"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "c00c1e75-65d1-4755-b3eb-26cb5c60af25"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"n", "-", "2"}]], TraditionalForm]],ExpressionUUID->
  "3cdb4ba3-6ad9-4f29-9a76-5ab4b7509917"]
}], "Text",
 CellChangeTimes->{{3.979030980433537*^9, 3.97903101781602*^9}},
 TextAlignment->Center,ExpressionUUID->"5837b403-e3f0-4318-930b-43e75acd61e1"],

Cell[TextData[{
 "with seed values ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "0"], TraditionalForm]],ExpressionUUID->
  "2f803851-c7f8-4a4e-a97d-53f6de39a8a9"],
 " = 0 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "1"], TraditionalForm]],ExpressionUUID->
  "4ed9e0ee-70ac-40c5-b6ec-eccd2cd7b3d3"],
 " = 1."
}], "Text",
 CellChangeTimes->{{3.979031024779626*^9, 
  3.9790310385115957`*^9}},ExpressionUUID->"eedd8216-1e71-4fc7-84d4-\
89990d98cbb3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fibo", "[", "0", "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fibo", "[", "1", "]"}], "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fibo", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"fibo", "[", "n", "]"}], "=", 
    RowBox[{
     RowBox[{"fibo", "[", 
      RowBox[{"n", "-", "1"}], "]"}], "+", 
     RowBox[{"fibo", "[", 
      RowBox[{"n", "-", "2"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.978174839390822*^9, 3.978174847462922*^9}, 
   3.9785120227395678`*^9, 3.97851207745033*^9, {3.979031062197736*^9, 
