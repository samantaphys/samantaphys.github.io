Cell[BoxData[{
 RowBox[{
  RowBox[{
   StyleBox[
    RowBox[{"For", " ", "the", " ", "Sequence"}], "Text"], 
   StyleBox[",", "Text"], 
   StyleBox["   ", "Text"], 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "DisplayFormula"], 
     RowBox[{"n", "+", "1"}]], 
    StyleBox["=", "DisplayFormula"], 
    RowBox[{
     RowBox[{
      FractionBox["7", "2"], 
      StyleBox["log", "DisplayFormula"], 
      RowBox[{
       StyleBox["(", "DisplayFormula"], 
       SubscriptBox[
        StyleBox["x", "DisplayFormula"], "n"], 
       StyleBox[")", "DisplayFormula"]}]}], 
     StyleBox["+", "DisplayFormula"], 
     RowBox[{
      FractionBox["2", "7"], 
      SubscriptBox[
       StyleBox["x", "DisplayFormula"], "n"]}]}]}], 
   StyleBox[" ", "DisplayFormula"], 
   StyleBox[",", "DisplayFormula"], 
   StyleBox["  ", "DisplayFormula"], 
   RowBox[{
    RowBox[{
     StyleBox["with", "DisplayFormula"], 
     StyleBox["   ", "DisplayFormula"], 
     SubscriptBox[
      StyleBox["x", "DisplayFormula"], "0"]}], 
    StyleBox[">", "DisplayFormula"], 
    StyleBox["1.4", "DisplayFormula"]}]}], 
  StyleBox[" ", "DisplayFormula"]}], "\n", 
 RowBox[{
  StyleBox[" ", "Text"], 
  StyleBox[
   RowBox[{
    RowBox[{"(", "ii", ")"}], "  ", "Find", " ", "the", " ", "convergence", 
    " ", 
    RowBox[{"value", "."}]}], "Text"]}]}], "Text",
