Cell[TextData[{
 "The Lucas sequence ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "n"], TraditionalForm]],ExpressionUUID->
  "48a07ee6-cc2e-4642-86d5-6c9d3961d37d"],
 " uses the same recurrence relation as Fibonacci, but with different initial \
conditions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["L", "0"], "=", "2", "  "}]}], TraditionalForm]],
  ExpressionUUID->"3ed60105-bd00-47f3-b155-ac0fa6a4c49f"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "1"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "31ad3932-34db-4077-848b-c2da2038fec8"],
 "."
}], "Text",
 CellChangeTimes->{{3.9790315681915092`*^9, 
  3.979031643351562*^9}},ExpressionUUID->"fd6ee361-ac31-4017-a721-\
31dbd3e893e8"],

