Cell[TextData[{
 "For Fibonacci numbers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "n"], TraditionalForm]],ExpressionUUID->
  "bf0c6b9e-5748-4a0d-bf0d-6652b162d89b"],
 ", the quantity \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["F", 
       RowBox[{"n", "+", "2"}]], 
      SubscriptBox["F", "n"]], "-", 
     FractionBox[
      SubscriptBox["F", "n"], 
      SubscriptBox["F", 
       RowBox[{"n", "+", "2"}]]]}]}], TraditionalForm]],ExpressionUUID->
  "4db6ffae-96ff-4164-8dcf-270adde3836c"],
 " converges to ... (up to three significant digit)"
}], "Text",
 CellChangeTimes->{{3.979113133213326*^9, 
  3.97911322431089*^9}},ExpressionUUID->"3c4a7f07-446d-4c72-bfd2-\
a8969ab0b045"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"r", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Fibonacci", "[", 
      RowBox[{"n", "+", "2"}], "]"}], "/", 
     RowBox[{"Fibonacci", "[", "n", "]"}]}], "-", 
    RowBox[{
     RowBox[{"Fibonacci", "[", "n", "]"}], "/", 
     RowBox[{"Fibonacci", "[", 
      RowBox[{"n", "+", "2"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978180697264781*^9, 3.97818071909055*^9}, {
   3.978180939233715*^9, 3.978180939735382*^9}, {3.9781810204798822`*^9, 
   3.9781810216709538`*^9}, 3.978181105477242*^9, 3.978181231239365*^9, {
   3.979112959675827*^9, 3.9791130415373297`*^9}, {3.9791193063353243`*^9, 
   3.9791193289569187`*^9}},
 CellLabel->
