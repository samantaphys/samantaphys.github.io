Cell["\<\
This space is called phase space. The radius corresponds to the total \
(dimensionless) energy. This is the geometric representation of an ideal \
harmonic oscillator.\
\>", "Text",
 CellChangeTimes->{{3.978961439102976*^9, 3.978961439458541*^9}, {
   3.978961515909585*^9, 3.978961566006362*^9}, 3.978961634837151*^9, 
   3.9789622056045017`*^9},ExpressionUUID->"0d695902-109d-485e-81ce-\
cc2cc997ba1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SHM", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "tau", "]"}], "+", 
         RowBox[{"x", "[", "tau", "]"}]}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "x", 
     ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.978962212117489*^9, 3.978962268576209*^9}, {
  3.979114819121043*^9, 3.979114826049262*^9}, {3.979114882645301*^9, 
  3.979114904277135*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"670bd646-6b61-41ff-a4e0-64d08da69abb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SHM", "[", "tau", "]"}], ",", 
     RowBox[{
      RowBox[{"SHM", "'"}], "[", "tau", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"tau", ",", "0", ",", "20"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Position (x)\>\"", ",", "\"\<Velocity (v)\>\""}], "}"}]}]}],
   "]"}]], "Input",
