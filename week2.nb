 RowBox[{
  RowBox[{
   RowBox[{"lucas", "[", "0", "]"}], "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lucas", "[", "1", "]"}], "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lucas", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"lucas", "[", "n", "]"}], "=", 
    RowBox[{
     RowBox[{"lucas", "[", 
      RowBox[{"n", "-", "1"}], "]"}], "+", 
     RowBox[{"lucas", "[", 
      RowBox[{"n", "-", "2"}], "]"}]}]}]}], ";"}]}], "Input",
