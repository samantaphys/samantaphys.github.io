    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "15"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "the", " ", "first", " ", "15", " ", "terms"}], 
   "*)"}]}]], "Input",
