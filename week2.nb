Cell[TextData[{
 "As ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "3fc2e468-40ed-4edc-88ed-64d557f57d85"],
 " increases, the ratio of successive Fibonacci numbers ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["F", 
     RowBox[{"n", "+", "1"}]], 
    SubscriptBox["F", "n"]], TraditionalForm]],ExpressionUUID->
  "5a720497-b299-4948-bb3a-654815c0c8ce"],
 " converges to the Golden Ratio: "
}], "Text",
 CellChangeTimes->{{3.9790311768154488`*^9, 
  3.979031264207144*^9}},ExpressionUUID->"c9eda022-cc7f-4c07-ae44-\
c93af0fe0a64"],

Cell[TextData[{
 "\[Phi] = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"1", "+", 
     SqrtBox["5"]}], "2"], TraditionalForm]],ExpressionUUID->
  "a09bc6b3-dc40-47de-930d-9d6cd34f3729"]
}], "Text",
 CellChangeTimes->{{3.979031271471691*^9, 3.97903131594207*^9}},
 TextAlignment->Center,ExpressionUUID->"d4c0ec4a-f2b4-4494-a1d4-c8fe94477b52"],

