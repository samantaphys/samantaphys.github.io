Cell["\<\
Ex-1: Add damping and observe how the phase\:2011space trajectory changes.\
\>", "Text",
 CellChangeTimes->{{3.9789623384056053`*^9, 
  3.978962340901648*^9}},ExpressionUUID->"43ffcb01-bb86-464c-b104-\
4d3ddcba2737"],

Cell[TextData[StyleBox["Damped oscillator", "Subsection"]], "Text",
 CellChangeTimes->{3.978155809038623*^9, 
  3.978961596064107*^9},ExpressionUUID->"5a8e58e6-e3e5-47b8-8c8c-\
6ec1b07c3728"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"m", 
     FractionBox[
      SuperscriptBox["d", "2"], 
      SuperscriptBox["dt", "2"]], "x"}], "+", 
    RowBox[{"c", " ", 
     FractionBox["d", "dt"], "x"}], "+", 
    RowBox[{"k", " ", "x"}]}], " ", "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"9bbc5a5d-31ee-4c92-ad79-1df4cef125b4"]], \
"Text",
 CellChangeTimes->{{3.9781558906416407`*^9, 3.9781558935729637`*^9}, 
   3.978961708848538*^9, {3.978961741966804*^9, 3.978961760267825*^9}, {
   3.978961818129595*^9, 3.9789618656676893`*^9}},
 TextAlignment->Center,ExpressionUUID->"3d2e5d40-e637-4cfa-816a-a6e67716a68e"],

Cell[TextData[{
 "Natural time scale:   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]],ExpressionUUID->
  "eb1d8002-6d11-43fb-8626-7c0af22831ce"],
 " = ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    FractionBox["m", "k"]], TraditionalForm]],ExpressionUUID->
  "747b975f-a95e-4bb5-ab33-1e630e7cfc2d"],
 "\nDimensionless form :   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["d", "2"], 
       SuperscriptBox["d\[Tau]", "2"]], "x"}], "+", 
     RowBox[{"\[Gamma]", 
      FractionBox["d", "d\[Tau]"], "x"}], "+", "x"}], " ", "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"3ba98458-2806-4548-aa9f-a0e3807b8166"],
 " , where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", " ", 
    FractionBox["c", 
     SqrtBox[
      RowBox[{"m", " ", "k"}]]], " "}], TraditionalForm]],ExpressionUUID->
  "fb0bb307-e2cb-4c4b-93f2-ae9fbb9c2d42"]
}], "Text",
 CellChangeTimes->{{3.97851014404093*^9, 3.978510146044952*^9}, {
  3.978961906750209*^9, 3.9789620128714848`*^9}, {3.9789645928273373`*^9, 
  3.978964597173747*^9}},ExpressionUUID->"878092f5-1f07-4700-b49d-\
7f7ffb42e545"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", "\[Gamma]_", "]"}], ":=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{"\[Gamma]", " ", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
         RowBox[{"x", "[", "t", "]"}]}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "2"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "x", 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "20"}], "}"}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sol", "[", "\[Gamma]", "]"}], "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", 
        RowBox[{"{", 
         RowBox[{"0.2", ",", "1", ",", "2"}], "}"}]}], "}"}]}], "]"}]}], ",", 
   
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Underdamped (\[Gamma]=0.2)\>\"", ",", 
      "\"\<Critical (\[Gamma]=1)\>\"", ",", 
      "\"\<Overdamped (\[Gamma]>1)\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{
