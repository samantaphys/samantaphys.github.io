Cell[TextData[StyleBox["Generalizing: The Linear Recurrence Tool", \
"Subsection"]], "Text",
 CellChangeTimes->{3.978176782735021*^9, 
  3.979032439325149*^9},ExpressionUUID->"7d217252-a016-45b5-aba4-\
adefa52c2425"],

Cell[TextData[{
 "Mathematica has a powerful built-in for any sequence of this type: ",
 StyleBox["LinearRecurrence", "Code"],
 ".\nDefine rule: [{coeff1,coeff2,...},{seeds}, #number-of-terms]"
