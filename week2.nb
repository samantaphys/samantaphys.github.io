Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["d", "2"], 
      SuperscriptBox["d\[Tau]", "2"]], "x"}], "+", 
    RowBox[{
     SubscriptBox["\[Omega]", "0"], "x"}]}], "=", 
   RowBox[{"cos", "(", 
    RowBox[{"\[Omega]", " ", "\[Tau]"}], ")"}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.978963105091386*^9, 3.9789631824333067`*^9}, {
  3.978963232782782*^9, 3.9789632506390457`*^9}, {3.979115820697919*^9, 
  3.979115831207699*^9}},
 TextAlignment->Center,ExpressionUUID->"d6f0c344-d64f-48a6-bbf2-9ce5c56ea718"],

Cell[TextData[{
 "Natural frequency of the oscillator: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     SubscriptBox["\[Omega]", "0"], "=", "1"}]}], TraditionalForm]],
  ExpressionUUID->"b0325509-1a81-4816-ab41-2abcd25faabf"]
}], "Text",
 CellChangeTimes->{{3.978963761817478*^9, 
  3.978963779002324*^9}},ExpressionUUID->"102e27f0-123a-4bfc-b6c9-\
010884f8028c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solD", "[", "\[Omega]_", "]"}], ":=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
