Cell[CellGroupData[{

Cell["3. Plotting a Falling Object", "Section",
 CellChangeTimes->{{3.9781548602070093`*^9, 3.978154870479166*^9}, {
   3.978182066843261*^9, 3.978182073357109*^9}, {3.978184574064231*^9, 
   3.9781845747633543`*^9}, {3.979032921657794*^9, 3.97903292234328*^9}, 
   3.9790388117186737`*^9},
 FontFamily->"Times",ExpressionUUID->"e83bce04-d2fa-4f90-bb69-3c1e3b7c35aa"],

Cell[TextData[{
 "You are standing on the roof of a building (1 meters high) and toss a ball \
upward at a speed of  9 m/s. We want to use Mathematica to track where the \
ball is at any given time.\n\nLet\[CloseCurlyQuote]s consider the height ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "y"}], TraditionalForm]],ExpressionUUID->
  "cf6f03c0-0ca0-42ec-a4a5-965f20c85896"],
 ") at any time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "t"}], TraditionalForm]],ExpressionUUID->
  "5778d72e-9eb2-470b-9e0b-8433e9148d06"],
 ") like this:\n\n                                                           ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SuperscriptBox["gt", "2"]}], "+", 
     RowBox[{
      SubscriptBox["v", "0"], "t"}], "+", 
     SubscriptBox["y", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "8cf36e1b-960a-454a-af44-838061af7fd4"],
 " \n"
}], "Text",
 CellChangeTimes->{{3.9781820922114964`*^9, 3.978182149146616*^9}, {
   3.978182193744994*^9, 3.978182266939699*^9}, 3.978182384579488*^9, {
   3.978182500489769*^9, 3.9781826913025103`*^9}, {3.9781827672119503`*^9, 
   3.97818278956234*^9}, {3.978183201030815*^9, 3.978183202605494*^9}, {
   3.978183839413953*^9, 3.978183840366497*^9}, 3.979033109790207*^9, {
   3.979033140850445*^9, 3.979033260300229*^9}, {3.979038574050758*^9, 
   3.9790385746201353`*^9}, {3.979038772902132*^9, 3.979038790620853*^9}, {
   3.979119464540606*^9, 3.979119478702362*^9}},
 TextAlignment->Left,ExpressionUUID->"67de20df-9be0-4b2f-aa13-6a5a040b10bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "9.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v0", "=", "9.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y0", "=", "1.0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.978182747361291*^9, 3.9781827531915073`*^9}, {
   3.978182793991816*^9, 3.9781830687042637`*^9}, {3.978183145687232*^9, 
   3.978183168388735*^9}, {3.978183827286661*^9, 3.978183827902479*^9}, 
   3.9781838817530937`*^9, 3.9781839948107033`*^9, {3.9781840338211117`*^9, 
   3.978184036783299*^9}, {3.978515478501342*^9, 3.978515479681436*^9}, {
   3.979038579732082*^9, 3.9790385910825377`*^9}, 3.979038625024981*^9, {
   3.9790387515251093`*^9, 3.9790387537927303`*^9}},
 CellLabel->
  "In[252]:=",ExpressionUUID->"a1c0e181-ad34-42ed-8163-885f53363add"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], "*", "g", "*", 
     RowBox[{"t", "^", "2"}]}], "+", 
    RowBox[{"v0", "*", "t"}], "+", "y0"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978183076994295*^9, 3.978183123989231*^9}, {
  3.9790385954150887`*^9, 3.9790386386331053`*^9}},
 CellLabel->
  "In[255]:=",ExpressionUUID->"fac1b1a8-54ec-4d41-99ff-14a3dfd76ed1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Height (m)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Path of the Tossed Ball\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.978183687869491*^9, 3.978183806074377*^9}, {
  3.9781838494077873`*^9, 3.978183871920718*^9}, {3.978183915843697*^9, 
  3.9781841397360077`*^9}, {3.979038628406087*^9, 3.979038634055667*^9}},
 CellLabel->
  "In[256]:=",ExpressionUUID->"4eae6d19-ce41-4e0a-8c3c-b207ee679c03"],

