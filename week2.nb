 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "n"], TraditionalForm]],ExpressionUUID->
  "4589d548-1fb9-4b70-9635-1f8c5236913f"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "865d5dfb-ce4d-49f5-8482-82e13b7e1606"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"n", "-", "2"}]], TraditionalForm]],ExpressionUUID->
  "8fdfca13-8b49-416b-92a6-1a69baccf4ba"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"n", "-", "3"}]], TraditionalForm]],ExpressionUUID->
  "785119f7-0afc-44e8-b314-033b37452e75"]
}], "Text",
