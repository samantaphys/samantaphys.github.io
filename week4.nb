Cell[BoxData[
 RowBox[{
  RowBox[{"EulerMethod", "[", "h_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "=", "0"}], ",", 
      RowBox[{"y", "=", "1"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"t", "<", "5"}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "y"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t", "=", 
         RowBox[{"t", "+", "h"}]}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "y"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980302500277348*^9, 3.980302508675468*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"ee762ff8-b240-424b-8ae3-3c6dcdcc0818"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", 
     RowBox[{"EulerMethod", "[", "h", "]"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "10"}], "]"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"EulerMethod", "[", "h", "]"}], "-", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "10"}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", 
     RowBox[{"{", 
      RowBox[{"0.2", ",", "0.1", ",", "0.05", ",", "0.01"}], "}"}]}], "}"}]}],
   "]"}]], "Input",
 CellChangeTimes->{{3.980302515144458*^9, 3.980302589295783*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"966931ab-0fe6-4435-8f6b-6d9ad4bc23a9"],

