  "In[134]:=",ExpressionUUID->"f77a8ca8-93a4-4f2f-a137-6b1e0aae0350"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y0", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", "50"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9803011928456573`*^9, 3.980301212417766*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"5032fc09-8238-4c00-81fe-564156b4722a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"euler", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", "h"}], ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"f", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "}"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "y0"}], "}"}], ",", "n"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.98030120208257*^9, 3.980301239626189*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"4227b75b-5f23-4808-bcc0-2f0bf3a828e7"],

Cell[TextData[{
 "Start from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["t", "o"], ",", 
     SubscriptBox["y", "0"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d3077fc-fb60-45d5-b79b-5a7262ecbf8a"],
 ", apply ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "n"], "+", 
    RowBox[{"h", " ", 
     RowBox[{"f", "(", 
      RowBox[{
       SubscriptBox["t", "n"], ",", 
       SubscriptBox["y", "n"]}], ")"}]}]}], TraditionalForm]],
  TextAlignment->Center,ExpressionUUID->
  "4e0aa639-eb4d-4da9-b472-e38ec395ab6d"],
 " repeatedly ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a451f4a2-2d02-4ffb-84b4-b560a8cf28a6"],
 " times, and store all intermediate results."
}], "Text",
 CellChangeTimes->{{3.980301393367721*^9, 
  3.9803014271736193`*^9}},ExpressionUUID->"286f56ef-41cd-43ae-8d95-\
cb466eabd881"],

