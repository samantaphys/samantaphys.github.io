Cell[TextData[{
 "To fit a model of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", " ", "x"}], "+", 
    RowBox[{"b", " ", "1"}]}], TraditionalForm]],ExpressionUUID->
  "227f3c3f-9507-47a4-bf1d-7e2ee7a4e9ef"],
 " :"
}], "Text",
 CellChangeTimes->{{3.979641970715353*^9, 3.979641991636466*^9}, {
  3.9803244861409483`*^9, 
  3.980324487085793*^9}},ExpressionUUID->"a895caec-3753-4450-8c7f-\
8a8910a6eb6b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1"}], "}"}], ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lm", "[", "\"\<BestFitParameters\>\"", "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"best", " ", "fit", " ", "value", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}]}], " ", "*)"}]}]}], "Input",
