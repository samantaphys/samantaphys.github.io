Cell[TextData[{
 "Ex-1: Let\[CloseCurlyQuote]s generate pseudo data that mimics a real \
experiment, such as a falling object ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"v", "=", 
     RowBox[{
      SubscriptBox["v", "0"], "+", 
      RowBox[{"g", " ", "t"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "379f6eaf-8b83-4e7b-82d4-ddc81759d303"],
 ")."
}], "Text",
 CellChangeTimes->{{3.97964251320382*^9, 
  3.979642580290388*^9}},ExpressionUUID->"845759ed-103a-43a7-8651-\
1714481fbd65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v0", "=", "2.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "9.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"v0", "+", 
        RowBox[{"g", "*", "t"}], "+", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "5", ",", "0.5"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
