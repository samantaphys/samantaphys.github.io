Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"d", " ", "y"}], "dt"], "=", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "y"}]}], " ", ",", "  ", 
   RowBox[{
    RowBox[{"with", "  ", 
     RowBox[{"y", "(", "0", ")"}]}], "=", 
    RowBox[{
     RowBox[{"1.", "      ", "--"}], " ", 
     RowBox[{"(", "1", ")"}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.979474141598029*^9, 3.979474153842629*^9}, {
