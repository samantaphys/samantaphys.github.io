  RowBox[{"posTab", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", " \t\t", "\n", "\t\t", 
       RowBox[{
        RowBox[{"vp", " ", "=", " ", 
         RowBox[{"vin", " ", "-", " ", 
