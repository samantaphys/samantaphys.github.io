Cell[TextData[StyleBox["Euler\[CloseCurlyQuote]s Method", "Subsection"]], \
"Text",
 CellChangeTimes->{
  3.978155002165979*^9, {3.9781550367355967`*^9, 3.978155040671198*^9}, {
   3.978155101737219*^9, 3.978155135387121*^9}, 3.978155194025982*^9, 
   3.978155262095471*^9, 3.9781748064372597`*^9, 3.979030925940213*^9, {
   3.979475386028838*^9, 3.979475388676792*^9}, 3.9803009512741327`*^9},
 TextAlignment->Left,ExpressionUUID->"c4b29a1b-9aaf-43e2-a402-94193b84253a"],

Cell["Now, we solve equation (1) using Euler\[CloseCurlyQuote]s method.", \
"Text",
 CellChangeTimes->{{3.9803011121103067`*^9, 
  3.980301157444359*^9}},ExpressionUUID->"db31eda1-7d95-4e79-b48b-\
b984259cc693"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["y", "n"], "+", 
     RowBox[{"h", " ", 
      RowBox[{"f", "(", 
       RowBox[{
        SubscriptBox["t", "n"], ",", 
        SubscriptBox["y", "n"]}], ")"}]}]}]}], TraditionalForm]],
  TextAlignment->Center,ExpressionUUID->
  "06aaf1b6-6d88-43ae-b4bd-af727dec062f"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["t", "n"], "+", "h"}]}], TraditionalForm]],ExpressionUUID->
  "fe1884ec-67f6-41df-bda0-5759a1d9e8b9"]
}], "Text",
 CellChangeTimes->{{3.979030954444255*^9, 3.9790309730948544`*^9}, 
   3.9794754022478533`*^9, {3.980301010715604*^9, 3.98030104666324*^9}, {
   3.980301472516151*^9, 3.980301483092799*^9}},
 TextAlignment->Center,ExpressionUUID->"9427977f-0580-43c0-b702-80b1633e46f3"],

Cell["Let\[CloseCurlyQuote]s implement this in Mathematica.", "Text",
 CellChangeTimes->{{3.980301352317971*^9, 
  3.9803013593995857`*^9}},ExpressionUUID->"bdeb6de3-6d25-4c31-92bc-\
07fca1323feb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "h", ",", "t0", ",", "y0", ",", "n"}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.978174839390822*^9, 3.978174847462922*^9}, 
   3.9785120227395678`*^9, 3.97851207745033*^9, {3.979031062197736*^9, 
   3.9790310872767897`*^9}, {3.979475425260189*^9, 3.979475440567499*^9}, 
