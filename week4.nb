Cell["Does reducing h reduce error?", "Text",ExpressionUUID->"223ba616-dcc0-487b-a0b0-1900387744e5"],

Cell["\<\
Euler\[CloseCurlyQuote]s method has:
Local truncation error \[TildeTilde] O(h^2)
Global error \[TildeTilde] O(h)  -- it\[CloseCurlyQuote]s large\
\>", "Text",
 CellChangeTimes->{{3.98030270644173*^9, 3.9803027245768347`*^9}, {
  3.980302943812375*^9, 
  3.980302949606255*^9}},ExpressionUUID->"5b1cb929-b13a-4524-ad1b-\
e0d24c9a388a"],

Cell["=> Local truncation error accumulates into global error.", "Text",
 CellChangeTimes->{{3.980302935753132*^9, 
  3.9803029367980223`*^9}},ExpressionUUID->"4c8cc41c-8c71-445a-9ecc-\
4d0b135ac9ae"],

Cell[TextData[StyleBox["Damped Harmonic Oscillator", "Subsection"]], "Text",
 CellChangeTimes->{{3.979475569216028*^9, 3.9794755862194147`*^9}, 
   3.980303019492095*^9},ExpressionUUID->"d5cbb7b5-66c9-4e1a-92d2-\
aa01ba71db81"],

Cell["Let\[CloseCurlyQuote]s consider the equation ", "Text",
 CellChangeTimes->{{3.979475624998302*^9, 3.9794756676457567`*^9}, {
  3.980303036530631*^9, 
  3.9803030617757387`*^9}},ExpressionUUID->"0e006a03-a714-4e20-b7a6-\
159afd9a6102"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " ", 
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], " ", 
    RowBox[{"y", "(", "t"}]}], TraditionalForm]],ExpressionUUID->
  "26af5e59-3894-4561-b617-ea98ed3f868b"],
 ") + \[Gamma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["d", "dt"], 
      RowBox[{"y", "(", "t", ")"}]}], " ", "+", " ", 
     RowBox[{"k", " ", 
      RowBox[{"x", "(", "t", ")"}]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"f0cb1d80-744c-4bb8-b2d7-701b49bf456f"]
}], "Text",
 CellChangeTimes->{{3.979475848326939*^9, 3.979475853405631*^9}, {
  3.979475915626684*^9, 3.979475991874486*^9}, {3.979723500822908*^9, 
  3.9797235045790873`*^9}, {3.980303072281375*^9, 3.980303216086549*^9}, {
  3.980303414361464*^9, 3.980303426816971*^9}, {3.980303496094837*^9, 
  3.980303531042581*^9}},
 TextAlignment->Center,ExpressionUUID->"9b3d8ffc-132d-4c37-9884-f84655437b9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "4"}], ";"}]}], "Input",
 CellChangeTimes->{{3.979476010733828*^9, 3.979476026112627*^9}, {
  3.980303219728052*^9, 3.9803032207964*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"3a916769-06e2-4dd7-9dd3-43ac9641fc61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"m", " ", 
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}]}], "+", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{"k", " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980303229238811*^9, 3.980303230280164*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"27907416-8701-49aa-9832-b301a6e114be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"1.`", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "0.25`"}], " ", "t"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1.`", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"1.984313483298443`", " ", "t"}], "]"}]}], "+", 
       RowBox[{"0.1259881576697424`", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"1.984313483298443`", " ", "t"}], "]"}]}]}], ")"}]}]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{3.980303232695305*^9, 3.980329027473194*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"b04b90c5-e1da-44d5-9b5f-c80999ca8b57"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", 
     RowBox[{"sol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
