Cell[TextData[{
 "Problem-1: Consider the initial value problem given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["d", "dt"], "x"}], "=", 
    RowBox[{
     RowBox[{"2", "t"}], "+", 
     RowBox[{"4", " ", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "c56315ae-e135-4120-af1b-61273daea7bb"],
 "\nand \|01d465(0)=1. If we numerically solve this problem using Euler\
\[CloseCurlyQuote]s method with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", 
     RowBox[{
      RowBox[{"x", "(", "0", ")"}], "=", 
      RowBox[{
       RowBox[{"1", " ", "and", " ", "h"}], "=", "0.2"}]}]}], " ", ","}], 
   TraditionalForm]],ExpressionUUID->"dd4256c7-505b-41cb-93ab-c36526671afd"],
 " then the value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], " ", "is"}], TraditionalForm]],ExpressionUUID->
  "5f879319-dc0d-4e30-8a95-b3cdfc8bafc6"],
 " "
}], "Text",
 CellChangeTimes->{{3.980308976000868*^9, 3.980309183224177*^9}, {
  3.980329783987904*^9, 
  3.980329783987962*^9}},ExpressionUUID->"c681dc8b-78b5-44bf-9696-\
1d8da91a4cbe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", "h"}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "t"}], "+", 
    RowBox[{"4", " ", "x"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", "0.2"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"euler", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", "h"}], ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"f", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "}"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "4"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.980308972375382*^9, {3.9803092027898397`*^9, 3.980309235405884*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"2ae96607-f5ff-472b-a26a-b299d9fdeb19"],

Cell[CellGroupData[{

Cell[BoxData["euler"], "Input",
 CellChangeTimes->{{3.980309237380951*^9, 3.980309243736993*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"2f553549-9e62-450b-8c5b-2f572fe895ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.2`", ",", "1.8`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.4`", ",", "3.3200000000000003`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.6000000000000001`", ",", "6.136000000000001`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.8`", ",", "11.284800000000002`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9803092442611313`*^9, 3.98032985504196*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"0a834765-b0a4-41bd-a893-5eb2ba9fc73a"]
}, Open  ]],

Cell[TextData[{
 "Thus, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "11.2848"}], TraditionalForm]],
  ExpressionUUID->"dda33d76-2076-4953-a6c5-ffecb74d141e"],
 " (ans)."
}], "Text",
 CellChangeTimes->{{3.980309250764778*^9, 
  3.980309270080895*^9}},ExpressionUUID->"4b5f18c7-2466-40b6-853b-\
56365603626b"],

Cell[TextData[{
 "Problem-2: Consider following initial value problem: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["d", "dt"], 
      RowBox[{"x", "(", "t", ")"}]}], "=", 
     RowBox[{
      RowBox[{"-", "2"}], "x", " ", "t"}]}], " ", ",", " ", 
    RowBox[{
     RowBox[{"with", " ", 
      RowBox[{"x", "(", "0", ")"}]}], "=", "2."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "56aef2d4-6468-46fd-b4d6-1e77543fcc94"]
}], "Text",
 CellChangeTimes->{{3.980320661908271*^9, 3.980320768032145*^9}, {
  3.980320851150881*^9, 
  3.9803209054512*^9}},ExpressionUUID->"8777cb7a-0fcb-48fd-b299-599002ca98cf"],

Cell[TextData[{
 "Plot ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "(", "t", ")"}], " ", 
    RowBox[{"vs", ".", " ", "t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "025714a6-a821-4cf4-8e55-990654bc9224"],
 " ."
}], "Text",
 CellChangeTimes->{{3.9803206933127604`*^9, 
  3.980320712504054*^9}},ExpressionUUID->"758167d2-8923-4ec9-8ef0-\
3b735bcd77ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"x", "[", "t", "]"}], "t"}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "2"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980303229238811*^9, 3.980303230280164*^9}, {
  3.9803208042869473`*^9, 3.9803209284076433`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"2b720bea-bd12-4be0-aab2-afc14545bbb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"2", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       SuperscriptBox["t", "2"]}]]}]}], "}"}], "}"}]], "Output",
