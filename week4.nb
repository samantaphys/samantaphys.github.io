 CellLabel->
  "In[133]:=",ExpressionUUID->"990ef419-cc12-4590-baed-c7bb84cbe7d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "y"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.979031094376689*^9, 3.97947544577664*^9, {3.9803011756028833`*^9, 
   3.9803011967608423`*^9}},
