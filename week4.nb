Cell[BoxData[
 RowBox[{
  RowBox[{"Lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9796457008769693`*^9, 3.9796457018842697`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"3b319528-d493-4713-aac7-ad68c9d2b348"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigmaError", "=", "4.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"estVar", "=", 
   RowBox[{"Lm", "[", "\"\<EstimatedVariance\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"reducedChiSq", "=", 
  RowBox[{"estVar", "/", 
   RowBox[{"(", 
    RowBox[{"sigmaError", "^", "2"}], ")"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Calculate", " ", "Reduced", " ", "Chi"}], "-", "Squared"}], 
    "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.9796454532606287`*^9, 3.979645521587225*^9}, {
  3.979645556635462*^9, 3.979645557258994*^9}},
