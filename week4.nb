Cell[CellGroupData[{
Cell[TextData[{
 "Physics through Computational Thinking\n",
 StyleBox["Week-4: Solving Initial Value Problems",
  FontSize->36]
}], "Title",
 CellChangeTimes->{{3.978154444598084*^9, 3.97815454028798*^9}, {
   3.978154584958158*^9, 3.9781545857817307`*^9}, {3.9789595194053926`*^9, 
   3.978959519829749*^9}, 3.9789600051734943`*^9, {3.9794709052870703`*^9, 
   3.979470908000704*^9}, 3.9802980246361637`*^9, {3.9802990465751247`*^9, 
   3.9802990468343153`*^9}},
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"f530929d-449d-4ccc-ade4-cd49f17f0e2a"],

Cell[TextData[StyleBox["In this tutorial, we explore the mathematical and \
computational tools needed to model physical systems using differential \
equations. We will discuss initial value problems and introduce Euler\
\[CloseCurlyQuote]s method as a first step toward numerical solutions of \
differential equations.\n",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.978154735010868*^9, 3.978154791048909*^9}, 
   3.978155696134118*^9, {3.9789601022451677`*^9, 3.97896011256898*^9}, {
   3.97896015079508*^9, 3.978960160357774*^9}, {3.978960241220355*^9, 
   3.9789602415653667`*^9}, {3.9794709209781847`*^9, 3.97947097278484*^9}, 
   3.980298105994071*^9, {3.9802981595616217`*^9, 3.980298181861577*^9}},
 FontSize->14,ExpressionUUID->"fb58e92b-222e-4ad7-a3a5-253cfc0f6d29"],

Cell[CellGroupData[{

