           RowBox[{"(", 
            RowBox[{"2", "*", "step", "*", 
             RowBox[{"k", "/", "m"}]}], ")"}], "*", "xmid"}]}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"xp", " ", "=", "  ", 
         RowBox[{"xin", " ", "+", " ", 
