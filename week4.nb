Cell[BoxData["0.9643014911488834`"], "Output",
 CellChangeTimes->{3.980326550769948*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"eddc1755-443a-4156-9eb9-f42ca08ccbba"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Problem-2:", "Subsection"],
 "\nGenerate a table of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "66bbba80-13ea-4815-b9f5-3b6e416d294e"],
 " random numbers using the ",
 StyleBox["RandomReal[{-1, 1}]", "Input"],
 " function (note that these numbers are centered at zero). Calculate the \
Standard Deviation of these ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "df959052-8a11-4a5e-bb02-7084e40db77a"],
 " numbers. Repeat this process for ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "f0568e69-89c7-4155-8605-60e914d83838"],
 " running from 100 to 2000 in steps of 200."
}], "Text",
 CellChangeTimes->{{3.979646606465822*^9, 3.979646647936653*^9}, {
  3.9796471449258966`*^9, 
  3.979647149016903*^9}},ExpressionUUID->"91d1f07a-42f8-4ad5-aaa1-\
f3f68639609e"],

Cell["Fit the result to the power-law form:", "Text",
 CellChangeTimes->{{3.979646696004362*^9, 
  3.979646713864439*^9}},ExpressionUUID->"79937d92-4d01-4aa4-83b0-\
ad3717a5762b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
   RowBox[{
    StyleBox["a", "TI"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["b", "TI"]]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{
  3.979646680713702*^9, {3.979647091434987*^9, 3.979647091685034*^9}},
 TextAlignment->Center,ExpressionUUID->"f61c5cad-e511-4ab5-84b8-8e0ec1e39fbf"],

Cell[TextData[{
 "Q. What value is the exponent ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea0b4366-41e8-4981-b02f-3124c7e4b8b5"],
 " closest to ?"
}], "Text",
 CellChangeTimes->{{3.979646735192709*^9, 3.9796467533367043`*^9}, {
  3.979647096515603*^9, 
  3.979647101055396*^9}},ExpressionUUID->"1496d172-ab04-4cdd-b740-\
ebe16d6f03bd"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.979646917235735*^9, 3.9796469258176813`*^9}, {
  3.9796469850357323`*^9, 3.979646985390032*^9}, {3.979647083770699*^9, 
  3.9796470839230633`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"a40cf1cf-a65f-4907-ab69-443d90331b65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"StandardDeviation", "[", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "100", ",", "2000", ",", "200"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NLm", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"a", "*", 
      RowBox[{"n", "^", "b"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Best Fit Parameters: \>\"", ",", 
    RowBox[{"NLm", "[", "\"\<BestFitParameters\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Parameter Table:\>\"", "]"}], ";"}], "\n", 
 RowBox[{"NLm", "[", "\"\<ParameterTable\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.979646775244315*^9, 3.979646815329636*^9}, {
   3.979646857445319*^9, 3.979646893424322*^9}, 3.979647024937146*^9, {
   3.979647078771388*^9, 3.979647080948571*^9}, {3.979725398849369*^9, 
   3.9797254001578903`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"a665fd3e-1fac-4c1b-adb8-58cf5053ad68"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Best Fit Parameters: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "\[Rule]", "0.5236542803769925`"}], ",", 
     RowBox[{"b", "\[Rule]", "0.015045723928713157`"}]}], "}"}]}],
  SequenceForm[
  "Best Fit Parameters: ", {$CellContext`a -> 
    0.5236542803769925, $CellContext`b -> 0.015045723928713157`}],
  Editable->False]], "Print",
