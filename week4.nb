 " and compare behaviors."
}], "Text",
 CellChangeTimes->{{3.9803032827131166`*^9, 3.980303340910557*^9}, 
   3.980329063954793*^9},ExpressionUUID->"f21a35a7-9839-4084-938b-\
fc0c66a70bd1"],

Cell[TextData[StyleBox["LCR Circuit Analogy", "Subsection"]], "Text",
 CellChangeTimes->{3.9781767624486237`*^9, 3.979031532722184*^9, 
  3.9794762322911654`*^9, 
  3.980303395062353*^9},ExpressionUUID->"18d94ca3-b6b9-4cad-a4aa-\
f818fd05a116"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "  ", 
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], 
    RowBox[{"q", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "9c126b47-0e3d-494a-8efe-91c65b8f2a5b"],
 " + R ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["d", "dt"], 
      RowBox[{"q", "(", "t", ")"}]}], " ", "+", " ", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["C", "0"]], " ", 
      RowBox[{"q", "(", "t", ")"}]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"52617608-2286-468e-9470-55afa7a52156"]
}], "Text",
 CellChangeTimes->{{3.980303442424212*^9, 3.980303491532126*^9}, {
  3.9803035375729313`*^9, 3.980303549346426*^9}, {3.980303649746109*^9, 
  3.980303651533574*^9}},
 TextAlignment->Center,ExpressionUUID->"f8fd6219-5bdc-4c9d-829c-2458262390cd"],

Cell["", "Text",
 CellChangeTimes->{{3.980303614518729*^9, 
  3.980303617427278*^9}},ExpressionUUID->"631ebf54-6ce2-4992-887f-\
068a9027cdf8"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"L", ",", "R", ",", "C0"}], "]"}]], "Input",
 CellChangeTimes->{{3.9803036297985897`*^9, 3.980303645215032*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"0ab3f1ad-4e52-45e5-a171-f3f8884dc722"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"C0", "=", "0.25"}], ";"}]}], "Input",
 CellChangeTimes->{{3.979476010733828*^9, 3.979476026112627*^9}, {
  3.980303219728052*^9, 3.9803032207964*^9}, {3.980303581161528*^9, 
  3.980303605296104*^9}, {3.9803036559615993`*^9, 3.980303656291986*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"eeb24efd-dfb8-40ae-8103-c078ae4b58cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solLCR", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"L", " ", 
         RowBox[{
          RowBox[{"q", "''"}], "[", "t", "]"}]}], "+", 
        RowBox[{"R", " ", 
         RowBox[{
          RowBox[{"q", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "C0"}], ")"}], " ", 
         RowBox[{"q", "[", "t", "]"}]}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"q", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"q", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"q", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980303229238811*^9, 3.980303230280164*^9}, 
   3.980303590768841*^9, 3.9803036609447308`*^9},
 CellLabel->
  "In[162]:=",ExpressionUUID->"984e6ce9-5857-46b6-83f5-27dd8032a083"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"q", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"1.`", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "0.25`"}], " ", "t"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1.`", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"1.984313483298443`", " ", "t"}], "]"}]}], "+", 
       RowBox[{"0.1259881576697424`", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"1.984313483298443`", " ", "t"}], "]"}]}]}], ")"}]}]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{3.980303232695305*^9, 3.980303663095529*^9, 
  3.980329119243438*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"29712ffe-eb25-4666-ad38-02425952f0c5"]
}, Open  ]],

