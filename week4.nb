Cell[TextData[{
 "Note: (i)  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", 
    FractionBox[
     RowBox[{"Estimated", " ", "Value"}], 
     RowBox[{"Standard", " ", "Error"}]]}], TraditionalForm]],ExpressionUUID->
  "c26d0b0d-83a2-4a5f-b15a-763c5716016e"],
 " (signal-to-noise ratio) , high ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "1a11d55d-3fd7-4537-b7f9-90c76b983ba0"],
 "-statistic suggest that the effect is real."
}], "Text",
 CellChangeTimes->{{3.9796432511768208`*^9, 3.9796432726575127`*^9}, {
  3.979643312252324*^9, 3.979643320141323*^9}, {3.979643358509178*^9, 
  3.979643370256926*^9}, {3.97964340849032*^9, 
  3.979643409729609*^9}},ExpressionUUID->"0b2b4ae1-1dd1-4d82-9956-\
eb192ecf5f15"],

Cell[TextData[{
 "(ii) ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "d092717a-8f7f-462c-a0cc-170a578c04dc"],
 "-value -- represents the probability that you would see your result if the \
true parameter value was actually zero (the \"null hypothesis\"). A small ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "6c2cdd2a-8966-4ec9-9eaf-a71b6d595146"],
 "-value means your parameter is \[OpenCurlyDoubleQuote]statistically \
significant\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.9796433964808893`*^9, 
  3.9796434613417683`*^9}},ExpressionUUID->"15bb877f-e3ca-4e9c-814b-\
7d3e2078dad6"],

Cell["\<\

Most physics models (e.g., radioactive decay) are nonlinear.\
\>", "Text",
 CellChangeTimes->{{3.979643485266621*^9, 
  3.979643499840144*^9}},ExpressionUUID->"aee847e8-2b61-4141-8a73-\
53e0ed46b0cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NLm", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{"a", "*", "x"}], "+", "b"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{"NLm", "[", "\"\<BestFitParameters\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.978183687869491*^9, 3.978183806074377*^9}, {
  3.9781838494077873`*^9, 3.978183871920718*^9}, {3.978183915843697*^9, 
  3.9781841397360077`*^9}, {3.979038628406087*^9, 3.979038634055667*^9}, {
  3.9796421099905863`*^9, 3.979642143349347*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"4eae6d19-ce41-4e0a-8c3c-b207ee679c03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", "9.842818296008772`"}], ",", 
   RowBox[{"b", "\[Rule]", "2.459755748633646`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.980325409732028*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"5cab3595-bde7-492b-a437-58e2f8aecd39"]
}, Open  ]],

Cell[TextData[{
 "Ex-2: Radioactive Decay, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"N", "(", "t", ")"}], "=", 
    RowBox[{
     SubscriptBox["N", "0"], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], " ", "t"}]]}]}], TraditionalForm]],
  ExpressionUUID->"e55d2267-0e39-41cc-94ae-eb7af85d5448"],
 " :"
}], "Text",
 CellChangeTimes->{{3.979643504784277*^9, 
  3.979643555630414*^9}},ExpressionUUID->"b177a669-0c48-49e8-8fdd-\
d6b1eda33f26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"decayData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{
        RowBox[{"100", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "0.5"}], "*", "t"}], "]"}]}], "+", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9796435718464527`*^9, 3.979643602036065*^9}, {
  3.979643639818822*^9, 3.979643641508842*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"6f315a3e-e8a8-4cbf-9b9d-5a824c8762e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NLm", "=", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"decayData", ",", 
      RowBox[{"n0", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "lambda"}], "*", "t"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n0", ",", "lambda"}], "}"}], ",", "t"}], "]"}]}], ";"}], " ", 
  
  RowBox[{"(*", 
   RowBox[{"Fit", " ", "the", " ", "model"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9796436064958973`*^9, 3.979643629730484*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"d07a14a4-044b-40e6-9e32-83e827510a82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"NLm", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
       RowBox[{"Point", "[", "decayData", "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Radioactive Decay Fit\>\""}]}], "]"}], 
  "  ", 
  RowBox[{"(*", 
   RowBox[{"Visualize", " ", "the", " ", "fit"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9796436273082657`*^9, 3.979643631432433*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"b6d9c292-ff34-4a57-be76-2f40921c7b23"],

