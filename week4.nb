Cell["Ex.-5: Study forced oscillator:", "Text",
 CellChangeTimes->{{3.9790315681915092`*^9, 3.979031643351562*^9}, 
   3.979476294915003*^9, {3.9803036930232277`*^9, 
   3.980303702488843*^9}},ExpressionUUID->"fd6ee361-ac31-4017-a721-\
31dbd3e893e8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "  ", 
    FractionBox[
     SuperscriptBox["d", "2"], 
     SuperscriptBox["dt", "2"]], 
    RowBox[{"q", "(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "7e036c69-f13a-4fe0-9377-43e6cd35be08"],
 " + R ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["d", "dt"], 
      RowBox[{"q", "(", "t", ")"}]}], " ", "+", " ", 
     RowBox[{
      FractionBox["1", 
       SubscriptBox["C", "0"]], " ", 
      RowBox[{"q", "(", "t", ")"}]}]}], "=", 
    RowBox[{"F", " ", 
     RowBox[{"cos", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"cd89f214-0211-4724-af7e-1caa1cd2784b"]
}], "Text",
 CellChangeTimes->{{3.9803037192462482`*^9, 3.980303737470694*^9}},
 TextAlignment->Center,ExpressionUUID->"07ea19c1-8a9c-40ef-93ff-66cc40408b9a"],

Cell[TextData[StyleBox["Example", "Subsection",
 FontFamily->"Times"]], "Text",
 CellChangeTimes->{{3.980306933161154*^9, 
  3.980306943064569*^9}},ExpressionUUID->"1243990d-7aa8-438c-aac2-\
c3aefec62981"],

Cell["\<\
For mass-spring system, the equation derived from Newton\[CloseCurlyQuote]s \
second law: \
\>", "Text",
 CellChangeTimes->{{3.980306955230109*^9, 
  3.980307029073283*^9}},ExpressionUUID->"9898ee41-95e8-4edf-adcc-\
079127983dae"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", "m"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7e759485-311f-4b5b-91c3-858321fcfd2c"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["d", "2"], " ", "x"}], 
     SuperscriptBox["dt", "2"]], "=", 
    RowBox[{
     RowBox[{"-", "k"}], " ", "x"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6557ee0-904c-4227-a4bb-2fa35d9b99f5"]
}], "Text",
 CellChangeTimes->{{3.9803070346389217`*^9, 3.980307106650503*^9}},
 TextAlignment->Center,ExpressionUUID->"857ac12c-b21a-4354-b111-adec62f2ba9d"],

Cell["This can be written as a set of coupled equations: ", "Text",
 CellChangeTimes->{{3.980307108639838*^9, 
  3.980307130746019*^9}},ExpressionUUID->"3faa1c54-88c9-48c4-a11e-\
15f3422beffb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"m", " ", 
     FractionBox[
      RowBox[{"d", " ", "v"}], "dt"]}], "=", 
    RowBox[{
     RowBox[{"-", "k"}], " ", "x"}]}], TraditionalForm]],ExpressionUUID->
  "ff86bdfe-769e-44e4-b4fc-4b26b3267444"],
 " ,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    FractionBox[
     RowBox[{"d", " ", "x"}], "dt"]}], TraditionalForm]],ExpressionUUID->
  "646d2b02-8aa8-417a-8e71-81e5876c7134"],
 ","
}], "Text",
 CellChangeTimes->{{3.9803071415375834`*^9, 3.980307213728881*^9}},
 TextAlignment->Center,ExpressionUUID->"5b7dbebf-d135-4fc0-be49-2f10cd5b13a2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfcf8a97-f6ab-4237-9c06-312280222312"],
 " is the velocity. We solved iteratively"
}], "Text",
 CellChangeTimes->{{3.9803072156721687`*^9, 3.9803072281167107`*^9}, {
  3.980307320569743*^9, 
  3.980307335844159*^9}},ExpressionUUID->"b33d71fb-06fc-4217-8004-\
b429acdfae61"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["v", 
      RowBox[{"n", "-", "1"}]], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "h", " ", "k"}], "m"], 
      SubscriptBox["x", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "22183548-a49a-4c68-8108-566a4500e159"],
 " ,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["x", 
      RowBox[{"n", "-", "1"}]], "+", " ", 
     RowBox[{"2", "h", " ", 
      SubscriptBox["v", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "142f9ef8-3f5a-444f-a9f6-69dd6e269f9c"],
 " ."
}], "Text",
 CellChangeTimes->{{3.980307343723823*^9, 3.980307455452138*^9}, {
  3.980329467988818*^9, 3.980329476555661*^9}},
 TextAlignment->Center,ExpressionUUID->"4ab09fc8-ad73-4d46-a8a0-c513d6e05c04"],

Cell[TextData[{
 StyleBox["We discuss this with different initial conditions and ",
  FontSize->24],
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->24,ExpressionUUID->"9d24c68d-77e9-462c-8279-07db3a4b7e0d"],
 StyleBox[" values to explore the behavior of the algorithm.",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.980307436607973*^9, 3.980307437447269*^9}, {
  3.980307478997333*^9, 
  3.980307503147868*^9}},ExpressionUUID->"98eca394-ca7a-4efb-8753-\
23d89114cad5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quit", "[", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.980308501824218*^9, 3.980308510267622*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"3dfd8253-6457-4d07-8d9e-248f0b82f2bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x0", ",", "v0", ",", "t0", ",", "m", ",", "k"}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.980307582255107*^9, 3.9803076013262157`*^9}, {
  3.980308485346589*^9, 3.980308513730611*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"cc563a21-1e79-4f93-9f71-7985c49aa6df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", " ", "=", " ", "10.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v0", " ", "=", " ", 
   RowBox[{"-", "11.2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t0", " ", "=", " ", "0.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", "0.33"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", " ", "=", " ", "300.0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.980307548418775*^9, 3.98030760521347*^9}, 
   3.9803076463806543`*^9},
 CellLabel->"In[26]:=",ExpressionUUID->"1371eb2a-566e-41f3-8281-40b8280525ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"step", " ", "=", " ", "0.01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"t0", " ", "+", " ", "step"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x1", " ", "=", " ", 
   RowBox[{"x0", " ", "+", " ", 
    RowBox[{"v0", "*", "step"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v1", " ", "=", " ", 
   RowBox[{"v0", " ", "-", " ", 
    RowBox[{"(", " ", 
     RowBox[{"step", "*", "k", "*", 
      RowBox[{"x0", "/", "m"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.980307650872427*^9, 3.9803076617205267`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"968b1021-8a8a-4c93-b86a-08b6a6fa5620"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmin", " ", "=", " ", 
   RowBox[{"2", "*", "step"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tmax", " ", "=", " ", "1.0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.980307676164949*^9, 3.9803076811830893`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"8bc72974-407a-44b7-ab3d-9a0dcb6e7699"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xin", " ", "=", " ", "x0"}], ";"}], "   "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vin", "=", " ", "v0"}], ";"}], "  "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xmid", "     ", "=", " ", "x1"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"vmid", "     ", "=", " ", "v1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.98030854836782*^9, 3.980308563280448*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"0b46601b-8895-47f3-8b6a-7b523405458a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"velTab", "=", 
   RowBox[{"Table", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", " \t\t", "\n", "\t\t", 
       RowBox[{
        RowBox[{"vp", " ", "=", " ", 
         RowBox[{"vin", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "step", "*", 
             RowBox[{"k", "/", "m"}]}], ")"}], "*", "xmid"}]}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"xp", " ", "=", "  ", 
         RowBox[{"xin", " ", "+", " ", 
          RowBox[{"(", 
           RowBox[{"2", "*", "step", "*", "vmid"}], ")"}]}]}], ";", "\t\t\t", 
        "\n", "\t\t", 
        RowBox[{"vin", " ", "=", " ", "vmid"}], ";", "\n", "\t\t", 
        RowBox[{"vmid", " ", "=", " ", "vp"}], ";", "\n", "\t\t", 
        RowBox[{"xin", " ", "=", " ", "xmid"}], ";", "\n", "\t\t", 
        RowBox[{"xmid", " ", "=", " ", "xp"}]}]}], "\n", "\t", "}"}], ",", 
     "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax", ",", "step"}], "}"}]}], "\n", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980307742020342*^9, 3.980307879214761*^9}, {
  3.980308074117145*^9, 3.980308083530303*^9}, {3.980308365986493*^9, 
  3.980308389182371*^9}, {3.980308419875601*^9, 3.980308443061925*^9}, {
  3.980329519179535*^9, 3.9803295542896957`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"be83b0ef-c329-4f40-adcd-7f0949e52f58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"velTab", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"velTab", ",", 
     RowBox[{"{", 
      RowBox[{"t1", ",", "v1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"velTab", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"velTab", ",", 
     RowBox[{"{", 
      RowBox[{"t0", ",", "v0"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.980307885887073*^9, 3.980307899130493*^9}, {
   3.9803080909177427`*^9, 3.980308100151881*^9}, 3.980329569933754*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"b6d6c72f-731b-4686-893f-bc5875b79a79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"velTab", ",", 
   RowBox[{"PlotRange", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<t (s)\>\"", ",", "\"\<v (m/s)\>\""}], "}"}]}]}], 
