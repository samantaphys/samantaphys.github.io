Cell["\<\
Euler is a first-order approximation. If step size is too large:
  (i) It overshoots the slope, (ii) It accumulates large truncation errors \
(see above), (iii) It amplifies error instead of damping it.\
\>", "Text",
 CellChangeTimes->{{3.9803020380755*^9, 3.980302045696908*^9}, {
  3.980302076095025*^9, 3.980302087342327*^9}, {3.980302350438073*^9, 
  3.98030235562222*^9}},ExpressionUUID->"93f6f189-3f08-4670-bce6-\
c6a2833f20da"],

Cell["Euler\[CloseCurlyQuote]s method is conditionally stable.", "Text",
 CellChangeTimes->{{3.98030209115578*^9, 
  3.980302097965392*^9}},ExpressionUUID->"ed9620e1-5d35-4def-88f6-\
b2cbec40b841"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EulerMethod", "[", 
   RowBox[{"h_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "=", "0"}], ",", 
      RowBox[{"y", "=", "1"}], ",", 
      RowBox[{"data", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"y", "+", 
          RowBox[{"h", " ", 
           RowBox[{"f", "[", 
            RowBox[{"t", ",", "y"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"t", "=", 
         RowBox[{"t", "+", "h"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "y"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", "n", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "data"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.980302180684866*^9, 3.980302182368017*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"c51df603-17ff-470a-8a5b-92ba989f79e5"],

