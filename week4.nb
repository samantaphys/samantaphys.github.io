Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"y", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"analytic", " ", "solutions"}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.979474410908413*^9, {3.979474485787072*^9, 3.979474487597334*^9}, {
