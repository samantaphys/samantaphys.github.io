Cell["\<\
\"Goodness of Fit\" -- the quantitative way to answer the question: \"How \
much should I trust this model?\".\
\>", "Text",
 CellChangeTimes->{{3.9796452209878674`*^9, 
  3.979645228410502*^9}},ExpressionUUID->"3666fc0e-c272-4cda-a7f4-\
744e0a3273e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Chi]", "\[Nu]", "2"], "\[LongEqual]", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"d", ".", "o", ".", "f"}]], 
    RowBox[{"\[Sum]", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox[
            RowBox[{"o", "b", "s"}], "TI"]], "-", 
          SubscriptBox[
           StyleBox["y", "TI"], 
           StyleBox[
            RowBox[{"f", "i", "t"}], "TI"]]}], ")"}], "2"], 
       SubsuperscriptBox["\[Sigma]", 
        StyleBox[
         RowBox[{"e", "r", "r", "o", "r"}], "TI"], "2"]], "   ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Reduced", " ", "Chi"}], "-", "Squared"}], ")"}]}]}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{3.979645249480843*^9, 3.979645262454198*^9}, {
  3.9796456395708323`*^9, 3.9796456445001297`*^9}},
 TextAlignment->Center,ExpressionUUID->"3ff9c15e-c1d7-4923-a18d-9a59fa43d8b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", "2.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "5.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"initialize", " ", "the", " ", "pseudo"}], "-", 
    RowBox[{"random", " ", "number", " ", "generator"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"a", "*", "x"}], "+", "b", "+", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"data", ",", 
   RowBox[{"PlotStyle", "->", "Red"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Scattered  Data\>\""}]}], "]"}]}], "Input",\

