Cell[CellGroupData[{

Cell["3. Curve Fitting and Parameter Estimation", "Section",
 CellChangeTimes->{{3.9781548602070093`*^9, 3.978154870479166*^9}, {
   3.978182066843261*^9, 3.978182073357109*^9}, {3.978184574064231*^9, 
   3.9781845747633543`*^9}, {3.979032921657794*^9, 3.97903292234328*^9}, 
   3.9790388117186737`*^9, 3.9794786955868053`*^9},
 FontFamily->"Times",ExpressionUUID->"e83bce04-d2fa-4f90-bb69-3c1e3b7c35aa"],

Cell[TextData[{
 "We want to extract physical constants (e.g., ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "09f84650-abe2-41c9-a766-26beb6925c63"],
 " or ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "cd8ca5fb-6171-44e0-8cb3-be0240532f47"],
 ") from noisy experimental data.\n\n",
 StyleBox["Linear Fit ", "Subsection"]
}], "Text",
 CellChangeTimes->{{3.9781820922114964`*^9, 3.978182149146616*^9}, {
   3.978182193744994*^9, 3.978182266939699*^9}, 3.978182384579488*^9, {
   3.978182500489769*^9, 3.9781826913025103`*^9}, {3.9781827672119503`*^9, 
   3.97818278956234*^9}, {3.978183201030815*^9, 3.978183202605494*^9}, {
   3.978183839413953*^9, 3.978183840366497*^9}, 3.979033109790207*^9, {
   3.979033140850445*^9, 3.979033260300229*^9}, {3.979038574050758*^9, 
   3.9790385746201353`*^9}, {3.979038772902132*^9, 3.979038790620853*^9}, {
   3.979119464540606*^9, 3.979119478702362*^9}, {3.979641735661893*^9, 
   3.9796417720199203`*^9}, {3.9796424440520573`*^9, 3.9796424855034657`*^9}},
 
 TextAlignment->Left,ExpressionUUID->"67de20df-9be0-4b2f-aa13-6a5a040b10bb"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"2", " ", "x"}], "+", "1", "+", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "0.5"}], "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.978182747361291*^9, 3.9781827531915073`*^9}, {
   3.978182793991816*^9, 3.9781830687042637`*^9}, {3.978183145687232*^9, 
   3.978183168388735*^9}, {3.978183827286661*^9, 3.978183827902479*^9}, 
   3.9781838817530937`*^9, 3.9781839948107033`*^9, {3.9781840338211117`*^9, 
