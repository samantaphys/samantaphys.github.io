Cell[CellGroupData[{

Cell["4. A Simple Problem", "Section",
 CellChangeTimes->{{3.9781548602070093`*^9, 3.978154870479166*^9}, {
  3.978182066843261*^9, 3.978182073357109*^9}, {3.978184574064231*^9, 
  3.9781845747633543`*^9}},
 FontFamily->"Times",ExpressionUUID->"e83bce04-d2fa-4f90-bb69-3c1e3b7c35aa"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s consider a radioactive element that decays over \
time. At time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "d12db7fe-023d-4ee8-a1eb-c36cde45a10f"],
 ", the amount of element present is \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "0"], TraditionalForm]],ExpressionUUID->
  "30d29d82-12f9-4270-9312-0c2474bfc56d"],
 ", and no decay has occurred. As time increases, the radioactive decay of \
the element is given by the equation \n\n                                     \
                      ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "f"], TraditionalForm]],ExpressionUUID->
  "6176419d-a06a-40db-9441-f96169482eae"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "0"], TraditionalForm]],ExpressionUUID->
  "ea2b1eff-19ca-421c-bb13-e4482e11e2a5"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "\[Lambda]t"}]], TraditionalForm]],ExpressionUUID->
