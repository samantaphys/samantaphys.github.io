Cell[TextData[StyleBox["Taylor Expansion Near an Extremum", "Subsection"]], \
"Text",
 CellChangeTimes->{
  3.978176782735021*^9},ExpressionUUID->"7d217252-a016-45b5-aba4-\
adefa52c2425"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "2", ",", "6"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"around", " ", "the", " ", "point", " ", "x"}], "=", "2"}], ",", 
    " ", 
    RowBox[{
    "keeping", " ", "terms", " ", "up", " ", "to", " ", "2", "nd", " ", 
     "order"}]}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{
  3.978176853378561*^9, {3.978176952356306*^9, 3.978176989851294*^9}, {
   3.978512787112657*^9, 3.978512813454771*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"6c2ea8a7-6cb0-44f4-9fd9-6097b485e7f0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", "2"}], "+", 
   RowBox[{"3", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "-", "2"}], ")"}], "2"]}], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "2"}], ")"}], "3"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "2"}], "]"}], "7"],
    SeriesData[$CellContext`x, 2, {}, 0, 7, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 2, {-2, 0, 3, 1}, 0, 7, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.978176854641613*^9, 3.978512371675304*^9, {3.978512793406019*^9, 
   3.978512823240411*^9}},
 CellLabel->
  "Out[106]=",ExpressionUUID->"a7b1c228-7fa8-48e5-8533-ca89c60f2e13"]
}, Open  ]],

