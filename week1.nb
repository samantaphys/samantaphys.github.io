Cell[TextData[{
 "Here, (i) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"1", "/", "3"}]], TraditionalForm]],ExpressionUUID->
  "cd10e405-ff39-4c89-9a97-85dc682e5b22"],
 " is a multivalued inverse power (ii) ",
 StyleBox["Log[x]", "Code"],
 " has domain restrictions (",
 StyleBox["x>0", "Code"],
 ")\nTo solve numerically, ",
 StyleBox["NSolve[]", "Code"],
 " internally uses inverse operations like:\n\[Bullet] Raising both sides to \
powers\n\[Bullet] Applying exponentials\nThese steps can lose solutions or \
restrict domains."
}], "Text",
 CellChangeTimes->{{3.978178234128976*^9, 3.978178355781576*^9}, {
  3.978513061457827*^9, 
  3.978513061994328*^9}},ExpressionUUID->"3624f542-5916-44b8-af9b-\
987f9536b969"],

